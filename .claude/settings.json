{
  "permissions": {
    "defaultMode": "default",
    "deny": ["Read(.env)", "Read(.env.*)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --locked agent-kit context",
            "timeout": 10
          }
        ]
      }
    ]
  }
}

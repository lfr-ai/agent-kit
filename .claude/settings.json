{
  "permissions": {
    "defaultMode": "default",
    "ask": [
      "Bash(git push *)",
      "Bash(git * push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(git branch -D *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh pr edit *)",
      "Bash(gh issue create *)",
      "Bash(gh api *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(python -m pip install *)",
      "Bash(python3 -m pip install *)",
      "Bash(pipx *)",
      "Bash(uv add *)",
      "Bash(uv pip install *)",
      "Bash(uv tool install *)",
      "Bash(uv tool run *)",
      "Bash(uvx *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm exec *)",
      "Bash(npx *)",
      "Bash(pnpm add *)",
      "Bash(pnpm dlx *)",
      "Bash(yarn add *)",
      "Bash(yarn dlx *)",
      "Bash(bun add *)",
      "Bash(bunx *)",
      "Bash(*git*push*--force*)",
      "Bash(*git*push* -f*)",
      "Bash(*git*push*--delete*)",
      "Bash(*git*push*--mirror*)",
      "Bash(*git*push*--tags*)",
      "Bash(*git*push* +*)",
      "Bash(*git*push* :*)",
      "Bash(*gh*pr merge*--admin*)",
      "Bash(git tag *)",
      "Bash(git config --global *)",
      "Bash(git config --system *)",
      "Bash(gh release *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo rename *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh auth *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --locked --no-sync agent-kit context",
            "timeout": 10
          }
        ]
      }
    ]
  }
}

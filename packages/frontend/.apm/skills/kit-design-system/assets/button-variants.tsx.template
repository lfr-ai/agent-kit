// src/shared/ui/button-variants.tsx
// Visual variants with class-variance-authority over semantic Tailwind tokens
// from theme.css. Variants change appearance only; element, role, and keyboard
// behavior stay native. For pending state and icon-only labels, merge this
// definition into the accessible Button contract from kit-component-library.
// If this file started as a shadcn/ui copy, record its origin here:
// origin: <registry item and review date>
import { cva, type VariantProps } from "class-variance-authority";
import { clsx, type ClassValue } from "clsx";
import type { ButtonHTMLAttributes, ReactElement, Ref } from "react";
import { twMerge } from "tailwind-merge";

/** Merge class lists; later Tailwind utilities win over earlier conflicting ones. */
export function cn(...inputs: readonly ClassValue[]): string {
  return twMerge(clsx(inputs));
}

export const buttonVariants = cva(
  [
    "inline-flex items-center justify-center gap-2 rounded-md font-medium",
    "transition-colors duration-(--duration-fast) ease-(--ease-standard)",
    "disabled:cursor-not-allowed disabled:opacity-60",
  ],
  {
    variants: {
      intent: {
        primary: "bg-primary text-primary-foreground hover:bg-primary-hover",
        secondary: "border border-border bg-surface text-foreground hover:bg-surface-raised",
        danger: "bg-danger text-danger-foreground",
        ghost: "bg-transparent text-foreground hover:bg-surface-raised",
      },
      size: {
        // h-11 keeps a 44px touch target; sm still meets the 24px WCAG 2.5.8 minimum.
        sm: "h-8 px-3 text-sm",
        md: "h-11 px-4 text-base",
        lg: "h-12 px-6 text-lg",
      },
      fullWidth: {
        true: "w-full",
        false: "",
      },
    },
    compoundVariants: [{ intent: "ghost", size: "sm", className: "px-2" }],
    defaultVariants: { intent: "secondary", size: "md", fullWidth: false },
  },
);

export type ButtonVariantProps = VariantProps<typeof buttonVariants>;

export type ButtonProps = Omit<ButtonHTMLAttributes<HTMLButtonElement>, "color"> &
  ButtonVariantProps &
  Readonly<{ ref?: Ref<HTMLButtonElement> }>;

export function Button({
  intent,
  size,
  fullWidth,
  className,
  type = "button",
  ref,
  ...rest
}: ButtonProps): ReactElement {
  return (
    <button
      {...rest}
      ref={ref}
      type={type}
      className={cn(buttonVariants({ intent, size, fullWidth }), className)}
    />
  );
}

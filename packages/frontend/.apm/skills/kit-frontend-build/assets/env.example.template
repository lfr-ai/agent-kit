# .env.example
# Copy to .env.local for local development. Commit only this example file.
# Every VITE_ variable is compiled into JavaScript that browsers download, so
# each value below must be safe to publish. Never put secrets, tokens, API keys,
# passwords, or private host names behind the VITE_ prefix.
#
# Deployed environments should read per-environment values from runtime
# configuration (see kit-runtime-config) so one build serves every environment.

# Public: display name shown in the page title.
VITE_APP_NAME=Example App

# Public: where the app loads its runtime configuration.
VITE_CONFIG_URL=/config.json

# Public: OpenID Connect issuer and public client identifier (PKCE, no secret).
VITE_OIDC_AUTHORITY=https://login.example.test/
VITE_OIDC_CLIENT_ID=example-spa

# Not exposed to the browser (no VITE_ prefix): read only by build tooling.
SOURCE_MAP_UPLOAD_PROJECT=example

// src/shared/debug/redact.ts
// Redaction helpers for diagnostics, logs, and bug reports. Redact by default;
// allow-list what is known to be safe instead of block-listing what is not.

const sensitiveParam = /^(?:access_token|id_token|refresh_token|token|code|state|password|secret|client_secret|api[_-]?key|key|sig|signature|session|email)$/i;
const sensitiveHeader = new Set(["authorization", "proxy-authorization", "cookie", "set-cookie", "x-api-key", "x-csrf-token"]);
const emailPattern = /[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}/g;
const bearerPattern = /\bBearer\s+[A-Za-z0-9._~+/=-]+/gi;
const jwtPattern = /\beyJ[A-Za-z0-9_-]{5,}\.[A-Za-z0-9_-]{5,}\.[A-Za-z0-9_-]{5,}\b/g;

export const REDACTED = "[redacted]";

export function redactUrl(raw: string): string {
  let url: URL;
  try {
    url = new URL(raw);
  } catch {
    return redactText(raw);
  }
  url.username = "";
  url.password = "";
  for (const name of [...url.searchParams.keys()]) {
    if (sensitiveParam.test(name)) {
      url.searchParams.set(name, REDACTED);
    }
  }
  if (url.hash.includes("token") || url.hash.includes("code=")) {
    url.hash = REDACTED;
  }
  return url.toString();
}

export function redactHeaders(headers: Readonly<Record<string, string>>): Record<string, string> {
  return Object.fromEntries(
    Object.entries(headers).map(([name, value]) => [name, sensitiveHeader.has(name.toLowerCase()) ? REDACTED : value]),
  );
}

export function redactText(text: string): string {
  return text.replace(bearerPattern, `Bearer ${REDACTED}`).replace(jwtPattern, REDACTED).replace(emailPattern, REDACTED);
}

/** Replace values of sensitive keys anywhere in a JSON-like structure. */
export function redactJson(value: unknown, sensitiveKeys: ReadonlySet<string>): unknown {
  if (Array.isArray(value)) {
    return value.map((item) => redactJson(item, sensitiveKeys));
  }
  if (value !== null && typeof value === "object") {
    return Object.fromEntries(
      Object.entries(value).map(([key, item]) => [
        key,
        sensitiveKeys.has(key.toLowerCase()) ? REDACTED : redactJson(item, sensitiveKeys),
      ]),
    );
  }
  return typeof value === "string" ? redactText(value) : value;
}

// src/test/render-with-providers.tsx
// One helper that renders a component with the same providers the app uses:
// a fresh QueryClient per test and a memory router at a chosen URL.
import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
import { render, type RenderResult } from "@testing-library/react";
import userEvent, { type UserEvent } from "@testing-library/user-event";
import type { ReactElement } from "react";
import { createMemoryRouter, RouterProvider } from "react-router";

export type RenderOptions = Readonly<{
  /** Initial URL, including search params. */
  route?: string;
  /** Route pattern the element is mounted at, for components reading params. */
  path?: string;
  queryClient?: QueryClient;
  /** Pass vi.advanceTimersByTime when the test uses fake timers. */
  advanceTimers?: (delay: number) => void;
}>;

export type RenderWithProvidersResult = RenderResult &
  Readonly<{
    user: UserEvent;
    queryClient: QueryClient;
    router: ReturnType<typeof createMemoryRouter>;
  }>;

export function createTestQueryClient(): QueryClient {
  return new QueryClient({
    defaultOptions: {
      queries: { retry: false, gcTime: Number.POSITIVE_INFINITY, staleTime: 0 },
      mutations: { retry: false },
    },
  });
}

export function renderWithProviders(ui: ReactElement, options: RenderOptions = {}): RenderWithProvidersResult {
  const queryClient = options.queryClient ?? createTestQueryClient();
  const router = createMemoryRouter(
    [
      { path: options.path ?? "*", element: ui },
      { path: "*", element: <p>Navigated away</p> },
    ],
    { initialEntries: [options.route ?? "/"] },
  );
  const user = userEvent.setup(options.advanceTimers ? { advanceTimers: options.advanceTimers } : {});
  const result = render(
    <QueryClientProvider client={queryClient}>
      <RouterProvider router={router} />
    </QueryClientProvider>,
  );
  return { ...result, user, queryClient, router };
}

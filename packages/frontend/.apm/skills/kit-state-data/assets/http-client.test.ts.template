// src/shared/api/http-client.test.ts
// Contract tests for the transport wrapper with an injected fetch; no network.
import { describe, expect, it, vi } from "vitest";
import { z } from "zod";
import { ApiError, createHttpClient, ResponseShapeError } from "./http-client";

const itemSchema = z.object({ id: z.string(), name: z.string() });

function jsonResponse(body: unknown, status = 200, contentType = "application/json"): Response {
  return new Response(JSON.stringify(body), { status, headers: { "Content-Type": contentType } });
}

function clientWith(fetchImpl: typeof fetch, token: string | null = null) {
  return createHttpClient({
    baseUrl: "https://api.example.test/v1",
    getAccessToken: () => token,
    fetchImpl,
  });
}

describe("createHttpClient", () => {
  it("builds the URL, drops empty query values, and returns parsed data", async () => {
    const fetchImpl = vi.fn<typeof fetch>().mockResolvedValue(jsonResponse({ id: "1", name: "A" }));

    const result = await clientWith(fetchImpl, "token-123").get("/items/1", itemSchema, {
      query: { expand: "owner", page: 2, empty: "", missing: undefined },
    });

    expect(result).toEqual({ id: "1", name: "A" });
    const [url, init] = fetchImpl.mock.calls[0] ?? [];
    expect(String(url)).toBe("https://api.example.test/v1/items/1?expand=owner&page=2");
    const headers = new Headers(init?.headers);
    expect(headers.get("Authorization")).toBe("Bearer token-123");
    expect(headers.get("Accept")).toBe("application/json");
  });

  it("serializes JSON bodies with a content type", async () => {
    const fetchImpl = vi.fn<typeof fetch>().mockResolvedValue(jsonResponse({ id: "2", name: "B" }, 201));

    await clientWith(fetchImpl).request("items", itemSchema, { method: "POST", body: { name: "B" } });

    const init = fetchImpl.mock.calls[0]?.[1];
    expect(init?.method).toBe("POST");
    expect(init?.body).toBe('{"name":"B"}');
    expect(new Headers(init?.headers).get("Content-Type")).toBe("application/json");
  });

  it("accepts an empty 204 response when the schema allows it", async () => {
    const fetchImpl = vi.fn<typeof fetch>().mockResolvedValue(new Response(null, { status: 204 }));

    await expect(
      clientWith(fetchImpl).request("items/1", z.undefined(), { method: "DELETE" }),
    ).resolves.toBeUndefined();
  });

  it("maps problem details to ApiError with field errors", async () => {
    const fetchImpl = vi.fn<typeof fetch>().mockResolvedValue(
      jsonResponse(
        { title: "Invalid", detail: "Name is taken", code: "name_taken", errors: { name: ["Name is taken"] } },
        422,
        "application/problem+json",
      ),
    );

    const error = await clientWith(fetchImpl).get("items", itemSchema).catch((caught: unknown) => caught);

    expect(error).toBeInstanceOf(ApiError);
    expect(error).toMatchObject({ status: 422, code: "name_taken", message: "Name is taken" });
    expect((error as ApiError).fieldErrors["name"]).toEqual(["Name is taken"]);
  });

  it("falls back to the status when the error body is not JSON", async () => {
    const fetchImpl = vi.fn<typeof fetch>().mockResolvedValue(
      new Response("upstream down", { status: 502, statusText: "Bad Gateway" }),
    );

    await expect(clientWith(fetchImpl).get("items", itemSchema)).rejects.toMatchObject({
      status: 502,
      code: "http_502",
      message: "Bad Gateway",
    });
  });

  it("rejects a successful response with the wrong shape", async () => {
    const fetchImpl = vi.fn<typeof fetch>().mockResolvedValue(jsonResponse({ id: 1 }));

    const error = await clientWith(fetchImpl).get("items/1", itemSchema).catch((caught: unknown) => caught);

    expect(error).toBeInstanceOf(ResponseShapeError);
    expect((error as ResponseShapeError).issues).toHaveLength(2);
  });

  it("propagates caller cancellation", async () => {
    const controller = new AbortController();
    const fetchImpl = vi.fn<typeof fetch>((_url, init) => {
      const signal = init?.signal;
      return new Promise<Response>((_resolve, reject) => {
        if (signal?.aborted) {
          reject(signal.reason);
          return;
        }
        signal?.addEventListener("abort", () => reject(signal.reason));
      });
    });

    const pending = clientWith(fetchImpl).get("items", itemSchema, { signal: controller.signal });
    controller.abort(new DOMException("Navigated away", "AbortError"));

    await expect(pending).rejects.toMatchObject({ name: "AbortError" });
  });
});

// src/shared/api/auth-fetch.ts
// fetch wrapper that adds CSRF protection and credentials only for trusted API
// origins, renews the session once for concurrent 401 responses, and retries
// each request at most once. Pass the result as fetchImpl to createHttpClient
// from kit-state-data; that client already maps 403 and other errors to typed
// ApiError values, so 403 is returned unchanged here and never signs anyone out.
// Use only with APIs that reject unauthorized unsafe requests before effects,
// or require a destination idempotency key before enabling automatic replay.

export type AuthFetchOptions = Readonly<{
  /** Origins that may receive cookies, CSRF headers, or tokens, e.g. "https://app.example.test". */
  allowedOrigins: readonly string[];
  /**
   * Renews the session (BFF refresh endpoint) or access token (OIDC library).
   * Resolves false when the user must sign in again.
   */
  renew: () => Promise<boolean>;
  /** Called once per expiry, for example AuthContextValue.markExpired. */
  onSessionExpired: () => void;
  /** Browser OIDC clients: token from the provider-managed cache. Omit with a BFF. */
  getAccessToken?: () => string | null;
  /** Header the server requires on unsafe methods. */
  csrfHeader?: string;
  fetchImpl?: typeof fetch;
}>;

const HTTP_UNAUTHORIZED = 401;
const UNSAFE_METHODS: ReadonlySet<string> = new Set(["POST", "PUT", "PATCH", "DELETE"]);

export function createAuthFetch(options: AuthFetchOptions): typeof fetch {
  // Resolve the global per call so MSW and test stubs installed later still apply.
  const baseFetch: typeof fetch = options.fetchImpl ?? ((input, init) => globalThis.fetch(input, init));
  const csrfHeader = options.csrfHeader ?? "X-CSRF";
  let renewal: Promise<boolean> | null = null;
  let expiryReported = false;
  let credentialGeneration = 0;

  function isTrusted(request: Request): boolean {
    return options.allowedOrigins.includes(new URL(request.url).origin);
  }

  // Single flight: every 401 that arrives during a renewal waits for the same promise.
  function renewOnce(observedGeneration: number): Promise<boolean> {
    if (observedGeneration !== credentialGeneration) {
      return Promise.resolve(true);
    }
    renewal ??= options
      .renew()
      .then((renewed) => {
        if (renewed) credentialGeneration += 1;
        return renewed;
      })
      .catch(() => false)
      .finally(() => {
        renewal = null;
      });
    return renewal;
  }

  function reportExpiry(): void {
    if (!expiryReported) {
      expiryReported = true;
      options.onSessionExpired();
    }
  }

  function send(request: Request): Promise<Response> {
    const trusted = isTrusted(request);
    const headers = new Headers(request.headers);
    if (!trusted) {
      headers.delete("Authorization");
      headers.delete(csrfHeader);
    }
    if (trusted && UNSAFE_METHODS.has(request.method)) {
      headers.set(csrfHeader, "1");
    }
    const token = trusted ? options.getAccessToken?.() : null;
    if (token) {
      headers.set("Authorization", `Bearer ${token}`);
    }
    // Untrusted origins never receive cookies or tokens.
    // Keep the native body source (string/FormData/etc.) and keepalive metadata.
    // Passing request.body as a new body would turn ordinary POSTs into streams.
    return baseFetch(request, {
      headers,
      credentials: trusted ? "include" : "omit",
      redirect: "error",
    });
  }

  return async (input, init) => {
    const request = new Request(input, init);
    // A request body can be read once; keep a copy for the single retry.
    const retry = request.clone();
    const observedGeneration = credentialGeneration;
    const response = await send(request);
    if (response.status !== HTTP_UNAUTHORIZED || !isTrusted(request)) {
      return response;
    }
    if (await renewOnce(observedGeneration)) {
      expiryReported = false;
      const retried = await send(retry);
      if (retried.status === HTTP_UNAUTHORIZED) reportExpiry();
      return retried;
    }
    reportExpiry();
    return response;
  };
}

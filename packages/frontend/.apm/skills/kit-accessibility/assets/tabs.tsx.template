// src/shared/ui/tabs.tsx
// Tabs following the WAI-ARIA Authoring Practices pattern: one tab stop for the
// tablist (roving tabindex), arrow keys move between tabs, Home/End jump, and
// selection follows focus (automatic activation) for cheap-to-render panels.
import { useId, useRef, type KeyboardEvent, type ReactElement, type ReactNode } from "react";

export type TabItem = Readonly<{ id: string; label: string; panel: ReactNode }>;

export type TabsProps = Readonly<{
  label: string;
  items: readonly TabItem[];
  selectedId: string;
  onSelect: (id: string) => void;
}>;

export function Tabs({ label, items, selectedId, onSelect }: TabsProps): ReactElement {
  const baseId = useId();
  const tabRefs = useRef(new Map<string, HTMLButtonElement>());

  function focusAndSelect(index: number): void {
    const item = items.at((index + items.length) % items.length);
    if (item === undefined) return;
    onSelect(item.id);
    tabRefs.current.get(item.id)?.focus();
  }

  function onKeyDown(event: KeyboardEvent<HTMLButtonElement>, index: number): void {
    const keys: Record<string, () => void> = {
      ArrowRight: () => focusAndSelect(index + 1),
      ArrowLeft: () => focusAndSelect(index - 1),
      Home: () => focusAndSelect(0),
      End: () => focusAndSelect(items.length - 1),
    };
    const action = keys[event.key];
    if (action) {
      event.preventDefault();
      action();
    }
  }

  return (
    <div className="ui-tabs">
      <div role="tablist" aria-label={label}>
        {items.map((item, index) => {
          const selected = item.id === selectedId;
          return (
            <button
              key={item.id}
              ref={(node) => {
                if (node) tabRefs.current.set(item.id, node);
                return () => {
                  tabRefs.current.delete(item.id);
                };
              }}
              type="button"
              role="tab"
              id={`${baseId}-tab-${item.id}`}
              aria-selected={selected}
              aria-controls={`${baseId}-panel-${item.id}`}
              tabIndex={selected ? 0 : -1}
              onClick={() => onSelect(item.id)}
              onKeyDown={(event) => onKeyDown(event, index)}
            >
              {item.label}
            </button>
          );
        })}
      </div>
      {items.map((item) => (
        <div
          key={item.id}
          role="tabpanel"
          id={`${baseId}-panel-${item.id}`}
          aria-labelledby={`${baseId}-tab-${item.id}`}
          hidden={item.id !== selectedId}
          // Panels without focusable content need to be reachable themselves.
          tabIndex={0}
        >
          {item.panel}
        </div>
      ))}
    </div>
  );
}

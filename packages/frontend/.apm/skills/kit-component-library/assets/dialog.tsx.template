// src/shared/ui/dialog.tsx
// Modal dialog on the native <dialog> element: the browser provides focus
// containment, inert background, Escape handling, and the top layer. This wrapper
// adds a controlled API, labelling, initial focus, and focus return.
import { useEffect, useId, useRef, type ReactElement, type ReactNode } from "react";

export type DialogProps = Readonly<{
  open: boolean;
  title: string;
  description?: string;
  /** Called for Escape, the close button, and backdrop clicks (if enabled). */
  onClose: () => void;
  closeOnBackdrop?: boolean;
  children: ReactNode;
  footer?: ReactNode;
}>;

export function Dialog({
  open,
  title,
  description,
  onClose,
  closeOnBackdrop = false,
  children,
  footer,
}: DialogProps): ReactElement {
  const titleId = useId();
  const descriptionId = useId();
  const dialogRef = useRef<HTMLDialogElement>(null);
  const returnFocusTo = useRef<HTMLElement | null>(null);

  useEffect(() => {
    const dialog = dialogRef.current;
    if (dialog === null) {
      return undefined;
    }
    if (open && !dialog.open) {
      returnFocusTo.current = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      dialog.showModal();
    } else if (!open && dialog.open) {
      dialog.close();
    }
    return undefined;
  }, [open]);

  useEffect(() => {
    const dialog = dialogRef.current;
    if (dialog === null) {
      return undefined;
    }
    // 'cancel' fires on Escape. Keep React state authoritative instead of letting
    // the browser close the element behind the controlled prop's back.
    const handleCancel = (event: Event): void => {
      event.preventDefault();
      onClose();
    };
    const handleClose = (): void => {
      const target = returnFocusTo.current;
      returnFocusTo.current = null;
      if (target?.isConnected) {
        target.focus();
      }
    };
    dialog.addEventListener("cancel", handleCancel);
    dialog.addEventListener("close", handleClose);
    return () => {
      dialog.removeEventListener("cancel", handleCancel);
      dialog.removeEventListener("close", handleClose);
    };
  }, [onClose]);

  return (
    <dialog
      ref={dialogRef}
      className="ui-dialog"
      aria-labelledby={titleId}
      aria-describedby={description ? descriptionId : undefined}
      onClick={(event) => {
        // A click on the dialog element itself (not its content) is a backdrop click.
        if (closeOnBackdrop && event.target === event.currentTarget) {
          onClose();
        }
      }}
    >
      <div className="ui-dialog__content">
        <header className="ui-dialog__header">
          <h2 id={titleId}>{title}</h2>
          <button type="button" className="ui-dialog__close" aria-label="Close" onClick={onClose}>
            <span aria-hidden="true">×</span>
          </button>
        </header>
        {description ? <p id={descriptionId}>{description}</p> : null}
        <div className="ui-dialog__body">{children}</div>
        {footer ? <footer className="ui-dialog__footer">{footer}</footer> : null}
      </div>
    </dialog>
  );
}

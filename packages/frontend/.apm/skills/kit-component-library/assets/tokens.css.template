/* src/shared/ui/tokens.css
 * Design tokens as CSS custom properties. Components reference semantic tokens
 * (--color-action-bg), never raw palette values, so themes swap in one place.
 * Contrast targets: text 4.5:1, large text and UI boundaries 3:1 (WCAG 2.2 AA).
 */

:root {
  /* Palette: raw values, used only by the semantic layer below. */
  --palette-blue-600: #1d4ed8;
  --palette-blue-700: #1e40af;
  --palette-red-600: #b91c1c;
  --palette-gray-50: #f9fafb;
  --palette-gray-200: #e5e7eb;
  --palette-gray-600: #4b5563;
  --palette-gray-900: #111827;
  --palette-white: #ffffff;

  /* Semantic colors. */
  --color-text: var(--palette-gray-900);
  --color-text-muted: var(--palette-gray-600);
  --color-surface: var(--palette-white);
  --color-surface-subtle: var(--palette-gray-50);
  --color-border: var(--palette-gray-600);
  --color-border-subtle: var(--palette-gray-200);
  --color-action-bg: var(--palette-blue-600);
  --color-action-bg-hover: var(--palette-blue-700);
  --color-action-text: var(--palette-white);
  --color-danger-bg: var(--palette-red-600);
  --color-danger-text: var(--palette-white);
  --color-error-text: var(--palette-red-600);
  --color-focus-ring: var(--palette-blue-600);

  /* Spacing scale (4px base) and sizing. */
  --space-1: 0.25rem;
  --space-2: 0.5rem;
  --space-3: 0.75rem;
  --space-4: 1rem;
  --space-6: 1.5rem;
  --space-8: 2rem;
  /* WCAG 2.5.8 minimum target is 24px; 44px is a comfortable touch default. */
  --size-target-min: 1.5rem;
  --size-target-comfortable: 2.75rem;

  /* Typography. */
  --font-family-base: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  --font-size-sm: 0.875rem;
  --font-size-md: 1rem;
  --font-size-lg: 1.25rem;
  --line-height-base: 1.5;

  /* Shape and motion. */
  --radius-sm: 0.25rem;
  --radius-md: 0.5rem;
  --focus-ring-width: 3px;
  --focus-ring-offset: 2px;
  --duration-fast: 120ms;
  --duration-base: 200ms;
  --easing-standard: cubic-bezier(0.2, 0, 0, 1);

  color-scheme: light dark;
}

@media (prefers-color-scheme: dark) {
  :root {
    --color-text: #f3f4f6;
    --color-text-muted: #d1d5db;
    --color-surface: #111827;
    --color-surface-subtle: #1f2937;
    --color-border: #9ca3af;
    --color-border-subtle: #374151;
    --color-action-bg: #93c5fd;
    --color-action-bg-hover: #bfdbfe;
    --color-action-text: #111827;
    --color-error-text: #fca5a5;
    --color-focus-ring: #93c5fd;
  }
}

@media (prefers-reduced-motion: reduce) {
  :root {
    --duration-fast: 0ms;
    --duration-base: 0ms;
  }
}

/* Shared utilities used by the primitives. */
.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
  border: 0;
}

:where(a, button, input, select, textarea, summary, [tabindex]):focus-visible {
  outline: var(--focus-ring-width) solid var(--color-focus-ring);
  outline-offset: var(--focus-ring-offset);
}

/* Windows High Contrast / forced colors: keep borders and focus visible. */
@media (forced-colors: active) {
  :where(button, input, select, textarea) {
    border: 1px solid ButtonText;
  }
}

.ui-button {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  min-block-size: var(--size-target-comfortable);
  min-inline-size: var(--size-target-comfortable);
  padding-inline: var(--space-4);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-surface);
  color: var(--color-text);
  font: inherit;
  cursor: pointer;
  transition: background-color var(--duration-fast) var(--easing-standard);
}

.ui-button--primary {
  border-color: transparent;
  background: var(--color-action-bg);
  color: var(--color-action-text);
}

.ui-button--primary:hover:not([aria-disabled="true"]) {
  background: var(--color-action-bg-hover);
}

.ui-button--danger {
  border-color: transparent;
  background: var(--color-danger-bg);
  color: var(--color-danger-text);
}

.ui-button--ghost {
  border-color: transparent;
  background: transparent;
}

.ui-button--sm {
  min-block-size: var(--size-target-min);
  padding-inline: var(--space-2);
  font-size: var(--font-size-sm);
}

.ui-button--lg {
  padding-inline: var(--space-6);
  font-size: var(--font-size-lg);
}

.ui-button[aria-disabled="true"],
.ui-button:disabled {
  cursor: not-allowed;
  opacity: 0.6;
}

.ui-dialog {
  max-inline-size: min(36rem, calc(100vw - 2 * var(--space-4)));
  padding: 0;
  border: 1px solid var(--color-border-subtle);
  border-radius: var(--radius-md);
  background: var(--color-surface);
  color: var(--color-text);
}

.ui-dialog::backdrop {
  background: rgb(0 0 0 / 50%);
}

.ui-dialog__content {
  display: grid;
  gap: var(--space-4);
  padding: var(--space-6);
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "naming_registry.schema.json",
  "title": "Naming registry",
  "description": "Canonical identifiers shared by backend and frontend. Kind-specific value patterns, uniqueness, and deprecation rules are enforced by check_registry.py.",
  "type": "object",
  "required": ["version", "groups"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": {
      "description": "Semantic version; increment on every change to groups or entries.",
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/group" }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^(?!.*\\*/)[^\\\\\\u0000-\\u001f\"]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "group": {
      "type": "object",
      "required": ["name", "kind", "description", "entries"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "PascalCase type name used in Python and TypeScript.",
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]*$"
        },
        "kind": {
          "type": "string",
          "enum": ["route", "query_key", "event", "enum", "error_code", "field"]
        },
        "description": { "$ref": "#/$defs/text" },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/entry" }
        }
      }
    },
    "entry": {
      "type": "object",
      "required": ["name", "value"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "UPPER_SNAKE_CASE constant name.",
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"
        },
        "value": {
          "description": "Wire value; its pattern depends on the group kind.",
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": { "$ref": "#/$defs/text" },
        "deprecated": { "$ref": "#/$defs/deprecation" }
      }
    },
    "deprecation": {
      "type": "object",
      "required": ["since", "reason"],
      "additionalProperties": false,
      "properties": {
        "since": { "$ref": "#/$defs/version" },
        "reason": { "$ref": "#/$defs/text" },
        "replacement": {
          "description": "Name of the active entry in the same group that replaces this one.",
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"
        },
        "remove_after": { "$ref": "#/$defs/version" }
      }
    }
  }
}

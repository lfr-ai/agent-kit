# Root outputs. Copy to infra/outputs.tf. Output only what callers or
# pipelines consume; never output secrets (mark unavoidable ones sensitive).
output "resource_group_id" {
  description = "Resource ID of the workload resource group."
  value       = azurerm_resource_group.this.id
}

output "resource_group_name" {
  description = "Name of the workload resource group."
  value       = azurerm_resource_group.this.name
}

output "storage_account_id" {
  description = "Resource ID of the storage account."
  value       = module.storage.id
}

output "storage_account_name" {
  description = "Name of the storage account."
  value       = module.storage.name
}

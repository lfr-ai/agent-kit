# Trivy misconfiguration scan for Terraform. Copy to infra/trivy.yaml.
# Use: trivy config --config trivy.yaml .
# Keep credential checks in the repository's existing secret scanner.
# Record accepted risks in .trivyignore with an owner, reason, and expiry.
severity:
  - HIGH
  - CRITICAL
exit-code: 1
ignorefile: .trivyignore

scan:
  scanners:
    - misconfig
  skip-dirs:
    - .terraform

misconfiguration:
  scanners:
    - terraform
  terraform:
    # Scan only first-party modules; registry modules are reviewed upstream.
    exclude-downloaded-modules: true
    vars:
      - environments/dev/terraform.tfvars

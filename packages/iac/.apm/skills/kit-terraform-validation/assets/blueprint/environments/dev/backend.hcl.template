# Backend settings for the dev state. Copy to infra/environments/dev/backend.hcl.
# Use: terraform init -backend-config=environments/dev/backend.hcl
# Identifiers only; access is granted through Entra ID roles on the container
# ('Storage Blob Data Contributor' for apply, 'Reader' plus data read for plan).
resource_group_name  = "rg-tfstate-dev"
storage_account_name = "sttfstatedev001"
container_name       = "tfstate"
key                  = "orders/dev.terraform.tfstate"
use_azuread_auth     = true

# Terraform plan workflow template with OIDC and read-only review.
# Copy to .github/workflows/terraform-plan.yml, then:
#   1. Replace every PIN_FULL_COMMIT_SHA with the reviewed 40-character SHA.
#   2. Create GitHub environments 'dev-plan' and 'prod-plan' holding the
#      variables AZURE_CLIENT_ID, AZURE_TENANT_ID, AZURE_SUBSCRIPTION_ID.
#   3. Federate each plan identity with subject
#      'repo:<owner>/<repo>:environment:<env>-plan' and grant it read access
#      to the target subscription plus data read on the state container.
#   4. Copy review_plan.py from this skill to tools/review_plan.py.
# Apply runs in a separate workflow bound to a protected environment.
name: terraform-plan

on:
  pull_request:
    paths:
      - infra/**
      - .github/workflows/terraform-plan.yml
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: terraform-plan-${{ github.ref }}
  cancel-in-progress: true

defaults:
  run:
    shell: bash
    working-directory: infra

jobs:
  static:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@PIN_FULL_COMMIT_SHA # v5
        with:
          persist-credentials: false
      - uses: hashicorp/setup-terraform@PIN_FULL_COMMIT_SHA # v3
        with:
          terraform_version: 1.10.5
          terraform_wrapper: false
      - name: Format
        run: terraform fmt -check -recursive -diff
      - name: Validate
        run: |
          terraform init -backend=false -input=false
          terraform validate
      - name: Root module tests
        run: terraform test
      - name: Child module tests
        run: |
          for module in modules/*/; do
            terraform -chdir="$module" init -backend=false -input=false
            terraform -chdir="$module" test
          done
      - uses: terraform-linters/setup-tflint@PIN_FULL_COMMIT_SHA # v4
      - name: TFLint
        run: |
          tflint --init
          tflint --recursive --config "$PWD/.tflint.hcl"
      - name: Trivy
        uses: aquasecurity/trivy-action@PIN_FULL_COMMIT_SHA # v0
        with:
          scan-type: config
          scan-ref: infra
          trivy-config: infra/trivy.yaml

  plan:
    needs: static
    # Fork pull requests cannot obtain OIDC tokens; skip rather than fail.
    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository
    runs-on: ubuntu-latest
    timeout-minutes: 30
    strategy:
      fail-fast: false
      matrix:
        env: [dev, prod]
    environment: ${{ matrix.env }}-plan
    permissions:
      contents: read
      id-token: write
    env:
      ARM_USE_OIDC: "true"
      ARM_CLIENT_ID: ${{ vars.AZURE_CLIENT_ID }}
      ARM_TENANT_ID: ${{ vars.AZURE_TENANT_ID }}
      ARM_SUBSCRIPTION_ID: ${{ vars.AZURE_SUBSCRIPTION_ID }}
      TARGET_ENV: ${{ matrix.env }}
      TF_IN_AUTOMATION: "true"
      TF_INPUT: "false"
    steps:
      - uses: actions/checkout@PIN_FULL_COMMIT_SHA # v5
        with:
          persist-credentials: false
      - uses: hashicorp/setup-terraform@PIN_FULL_COMMIT_SHA # v3
        with:
          terraform_version: 1.10.5
          terraform_wrapper: false
      - name: Init
        run: terraform init -backend-config="environments/$TARGET_ENV/backend.hcl"
      - name: Plan
        id: plan
        run: |
          set +e
          terraform plan -lock-timeout=5m -detailed-exitcode \
            -var-file="environments/$TARGET_ENV/terraform.tfvars" -out=tfplan
          code=$?
          set -e
          # 0 = no changes, 2 = changes present, anything else = failure.
          if [ "$code" -ne 0 ] && [ "$code" -ne 2 ]; then exit "$code"; fi
          echo "changes=$([ "$code" -eq 2 ] && echo true || echo false)" >> "$GITHUB_OUTPUT"
      - name: Export plan JSON
        # Plan JSON contains sensitive values in clear text; keep it on the
        # runner and publish only the checksum and the action summary.
        run: |
          terraform show -json tfplan > plan.json
          sha256sum plan.json tfplan > plan.sha256
      - name: Review destructive actions
        run: python3 ../tools/review_plan.py --file plan.json > plan-summary.json
      - uses: actions/upload-artifact@PIN_FULL_COMMIT_SHA # v4
        if: always()
        with:
          name: plan-${{ matrix.env }}
          path: |
            infra/plan-summary.json
            infra/plan.sha256
          retention-days: 7
          if-no-files-found: error

# Amazon API Gateway HTTP API for the orders service: JWT authorizer,
# explicit routes with scopes, stage throttling, and JSON access logs.
# Copy to infra/aws/api-gateway-http.tf (split into versions.tf, variables.tf,
# and main.tf if you prefer) and commit .terraform.lock.hcl so every run uses
# the same provider build.
#
# HTTP APIs have no API keys, usage plans, per-client throttling, caching,
# request validation, or AWS WAF. If you need any of these, use a REST API
# (aws_api_gateway_* resources) instead; see references/cloud-equivalents.md.
# Routes mirror the operations of the OpenAPI contract; generate them from it
# rather than editing them by hand.

terraform {
  required_version = ">= 1.10.0, < 2.0.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.70"
    }
  }
}

# Credentials come from the environment (OIDC role in CI, SSO profile locally).
provider "aws" {
  region = var.region
}

variable "region" {
  description = "AWS Region for the API."
  type        = string
  default     = "eu-west-1"
}

variable "environment" {
  description = "Environment name used in resource names and tags."
  type        = string
  default     = "dev"
}

variable "jwt_issuer" {
  description = "Token issuer URL; must serve OpenID Connect discovery metadata."
  type        = string
  default     = "https://login.example.com/shop/v2.0"
}

variable "jwt_audience" {
  description = "Audience values accepted in the aud claim."
  type        = list(string)
  default     = ["api://orders"]
}

variable "backend_url" {
  description = "Base URL of the orders service, without a trailing slash."
  type        = string
  default     = "https://orders-dev.internal.example.com"
}

variable "allowed_origins" {
  description = "Exact browser origins allowed by CORS; never '*'."
  type        = list(string)
  default     = ["https://shop.example.com"]
}

variable "default_rate_limit" {
  description = "Stage-wide steady-state requests per second (best-effort target)."
  type        = number
  default     = 50
}

variable "default_burst_limit" {
  description = "Stage-wide burst size."
  type        = number
  default     = 100
}

variable "log_retention_days" {
  description = "Access log retention in days."
  type        = number
  default     = 30
}

locals {
  name = "orders-${var.environment}"
  tags = {
    environment = var.environment
    workload    = "shop-api"
  }

  # One entry per OpenAPI operation: route key, required scope, and an
  # optional tighter rate for write operations.
  routes = {
    list_orders = {
      route_key = "GET /orders/v1/orders"
      scope     = "orders.read"
      rate      = null
    }
    get_order = {
      route_key = "GET /orders/v1/orders/{orderId}"
      scope     = "orders.read"
      rate      = null
    }
    create_order = {
      route_key = "POST /orders/v1/orders"
      scope     = "orders.write"
      rate      = 10
    }
  }
}

resource "aws_apigatewayv2_api" "orders" {
  name          = local.name
  protocol_type = "HTTP"
  description   = "Orders API v1"

  cors_configuration {
    allow_origins     = var.allowed_origins
    allow_methods     = ["GET", "POST"]
    allow_headers     = ["authorization", "content-type", "idempotency-key", "x-correlation-id"]
    expose_headers    = ["x-correlation-id", "retry-after"]
    allow_credentials = false
    max_age           = 600
  }

  # Set to true once a custom domain is mapped, so the default
  # execute-api endpoint cannot be used to bypass the domain's settings.
  disable_execute_api_endpoint = false

  tags = local.tags
}

resource "aws_apigatewayv2_authorizer" "jwt" {
  api_id           = aws_apigatewayv2_api.orders.id
  name             = "jwt"
  authorizer_type  = "JWT"
  identity_sources = ["$request.header.Authorization"]

  jwt_configuration {
    issuer   = var.jwt_issuer
    audience = var.jwt_audience
  }
}

resource "aws_apigatewayv2_integration" "orders" {
  api_id                 = aws_apigatewayv2_api.orders.id
  integration_type       = "HTTP_PROXY"
  integration_method     = "ANY"
  integration_uri        = var.backend_url
  connection_type        = "INTERNET"
  payload_format_version = "1.0"
  timeout_milliseconds   = 10000

  # Forward the public path unchanged and tag the request for correlation.
  request_parameters = {
    "overwrite:path"                = "$request.path"
    "overwrite:header.x-request-id" = "$context.requestId"
  }
}

resource "aws_apigatewayv2_route" "orders" {
  for_each = local.routes

  api_id               = aws_apigatewayv2_api.orders.id
  route_key            = each.value.route_key
  target               = "integrations/${aws_apigatewayv2_integration.orders.id}"
  authorization_type   = "JWT"
  authorizer_id        = aws_apigatewayv2_authorizer.jwt.id
  authorization_scopes = [each.value.scope]
}

resource "aws_cloudwatch_log_group" "access" {
  name              = "/aws/apigateway/${local.name}"
  retention_in_days = var.log_retention_days
  tags              = local.tags
}

resource "aws_apigatewayv2_stage" "default" {
  api_id      = aws_apigatewayv2_api.orders.id
  name        = "$default"
  auto_deploy = true

  default_route_settings {
    throttling_rate_limit    = var.default_rate_limit
    throttling_burst_limit   = var.default_burst_limit
    detailed_metrics_enabled = true
  }

  dynamic "route_settings" {
    for_each = { for key, route in local.routes : key => route if route.rate != null }
    content {
      route_key              = route_settings.value.route_key
      throttling_rate_limit  = route_settings.value.rate
      throttling_burst_limit = route_settings.value.rate * 2
    }
  }

  # No request or response bodies and no Authorization header in access logs.
  access_log_settings {
    destination_arn = aws_cloudwatch_log_group.access.arn
    format = jsonencode({
      requestId          = "$context.requestId"
      requestTime        = "$context.requestTime"
      sourceIp           = "$context.identity.sourceIp"
      httpMethod         = "$context.httpMethod"
      routeKey           = "$context.routeKey"
      status             = "$context.status"
      protocol           = "$context.protocol"
      responseLength     = "$context.responseLength"
      integrationStatus  = "$context.integrationStatus"
      integrationLatency = "$context.integrationLatency"
      authorizerError    = "$context.authorizer.error"
    })
  }

  tags = local.tags

  depends_on = [aws_apigatewayv2_route.orders]
}

output "invoke_url" {
  description = "Stage invoke URL; front it with a custom domain in production."
  value       = aws_apigatewayv2_stage.default.invoke_url
}

<!--
  Global (all APIs) policy. Copy to apim/policies/global.xml.
  Global scope has no parent, so no section contains <base />.
  Every API policy must keep <base /> in each section so these run.
  Values in {{double-braces}} are API Management named values created by
  apim.bicep; never paste secrets into this file.
-->
<policies>
  <inbound>
    <!-- Keep a caller-supplied correlation id; otherwise use the gateway request id. -->
    <set-header name="X-Correlation-Id" exists-action="skip">
      <value>@(context.RequestId.ToString())</value>
    </set-header>
    <!--
      Coarse per-client backstop; per-consumer limits live at API or product scope.
      Behind Front Door or Application Gateway, context.Request.IpAddress is the
      edge address: key on a header that only the trusted edge can set instead.
      rate-limit-by-key is not available in the Consumption tier.
    -->
    <rate-limit-by-key calls="{{global-calls-per-minute}}" renewal-period="60"
      counter-key='@("global-ip:" + context.Request.IpAddress)'
      retry-after-variable-name="retryAfter" />
  </inbound>
  <backend>
    <!-- Upstream timeout in seconds; keep below the edge timeout. -->
    <forward-request timeout="30" />
  </backend>
  <outbound>
    <set-header name="X-Correlation-Id" exists-action="override">
      <value>@(context.Request.Headers.GetValueOrDefault("X-Correlation-Id", context.RequestId.ToString()))</value>
    </set-header>
    <set-header name="X-Content-Type-Options" exists-action="override">
      <value>nosniff</value>
    </set-header>
    <set-header name="X-Powered-By" exists-action="delete" />
    <set-header name="X-AspNet-Version" exists-action="delete" />
  </outbound>
  <on-error>
    <!--
      Runs after API-scope on-error policies that call <base /> last: they choose
      the status, this renders one RFC 9457 problem document. Never echo
      context.LastError.Message, tokens, or request bodies to callers.
    -->
    <choose>
      <when condition="@(!(context.Response.StatusCode >= 400))">
        <set-status code="500" reason="Internal Server Error" />
      </when>
    </choose>
    <choose>
      <when condition='@(context.Response.StatusCode == 429 &amp;&amp; context.Variables.ContainsKey("retryAfter"))'>
        <set-header name="Retry-After" exists-action="override">
          <value>@(context.Variables["retryAfter"].ToString())</value>
        </set-header>
      </when>
    </choose>
    <set-header name="Content-Type" exists-action="override">
      <value>application/problem+json</value>
    </set-header>
    <set-header name="X-Correlation-Id" exists-action="override">
      <value>@(context.Request.Headers.GetValueOrDefault("X-Correlation-Id", context.RequestId.ToString()))</value>
    </set-header>
    <set-body>@{
      return new JObject(
        new JProperty("type", "about:blank"),
        new JProperty("title", context.Response.StatusReason),
        new JProperty("status", context.Response.StatusCode),
        new JProperty("instance", context.Request.OriginalUrl.Path),
        new JProperty("correlationId", context.Request.Headers.GetValueOrDefault("X-Correlation-Id", context.RequestId.ToString()))
      ).ToString();
    }</set-body>
  </on-error>
</policies>

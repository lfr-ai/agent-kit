# Continuous integration: verify, build the image once, push it by digest, attest it.
#
# Copy to .github/workflows/ci.yml. Replace every PIN_FULL_COMMIT_SHA with the
# reviewed full commit SHA of the release named in the trailing comment.
# Sample service: a Python (uv) service packaged as the image "orders".
# The job names lint, test, and image are the required status checks; keep them
# stable. Continuous delivery starts from the digest this workflow publishes;
# see cd-container-apps.yml.template.
name: ci

on:
  pull_request:
  merge_group:
  push:
    branches: [main]

permissions:
  contents: read

concurrency:
  # Superseded pull request runs are cancelled; pushes to main always finish.
  group: ci-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

env:
  REGISTRY: ghcr.io
  # Registry paths must be lower case; set this explicitly if the owner is not.
  IMAGE_NAME: ${{ github.repository_owner }}/orders

jobs:
  lint:
    name: lint
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@PIN_FULL_COMMIT_SHA # v7
        with:
          persist-credentials: false
      - uses: astral-sh/setup-uv@PIN_FULL_COMMIT_SHA # v10
        with:
          enable-cache: true
          cache-dependency-glob: uv.lock
      - name: Install from the lockfile
        run: uv sync --locked
      - name: Lint and format check
        run: |
          uv run --locked ruff check .
          uv run --locked ruff format --check .

  test:
    name: test
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@PIN_FULL_COMMIT_SHA # v7
        with:
          persist-credentials: false
      - uses: astral-sh/setup-uv@PIN_FULL_COMMIT_SHA # v10
        with:
          enable-cache: true
          cache-dependency-glob: uv.lock
      - name: Install from the lockfile
        run: uv sync --locked
      - name: Unit and component tests
        run: uv run --locked pytest -q

  image:
    name: image
    needs: [lint, test]
    runs-on: ubuntu-24.04
    timeout-minutes: 30
    permissions:
      contents: read
      packages: write
      id-token: write
      attestations: write
    outputs:
      digest: ${{ steps.build.outputs.digest }}
    steps:
      - uses: actions/checkout@PIN_FULL_COMMIT_SHA # v7
        with:
          persist-credentials: false
      - uses: docker/setup-buildx-action@PIN_FULL_COMMIT_SHA # v4
      - name: Log in to the registry
        if: github.event_name == 'push'
        uses: docker/login-action@PIN_FULL_COMMIT_SHA # v4
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}
      - name: Compute tags and labels
        id: meta
        uses: docker/metadata-action@PIN_FULL_COMMIT_SHA # v6
        with:
          images: ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}
          # One tag per commit; deployment never uses it, it only helps people
          # find the digest. The digest is the identity that is promoted.
          tags: |
            type=sha,format=long
      - name: Build once (push only from main)
        id: build
        uses: docker/build-push-action@PIN_FULL_COMMIT_SHA # v7
        with:
          context: .
          push: ${{ github.event_name == 'push' }}
          tags: ${{ steps.meta.outputs.tags }}
          labels: ${{ steps.meta.outputs.labels }}
          # Pull request caches stay in their merge-ref scope; only pushes to
          # main refresh the cache that every branch can restore.
          cache-from: type=gha,scope=orders
          cache-to: type=gha,scope=orders,mode=max
      - name: Attest build provenance
        if: github.event_name == 'push'
        uses: actions/attest@PIN_FULL_COMMIT_SHA # v4
        with:
          subject-name: ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}
          subject-digest: ${{ steps.build.outputs.digest }}
          push-to-registry: true
      - name: Record the digest
        if: github.event_name == 'push'
        env:
          DIGEST: ${{ steps.build.outputs.digest }}
          IMAGE: ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}
        run: |
          {
            echo "### Image"
            echo
            echo "\`${IMAGE}@${DIGEST}\`"
          } >> "${GITHUB_STEP_SUMMARY}"

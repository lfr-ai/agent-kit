# Rollback for Azure Container Apps: restore a previous revision or digest on demand.
#
# Copy to .github/workflows/rollback.yml. Replace every PIN_FULL_COMMIT_SHA with
# a reviewed full SHA. Run it from the Actions tab; the target environment's
# protection rules (required reviewers) still apply.
#
# Two modes:
# - revision: move traffic back to a revision that still exists (default: the
#   revision labelled "previous" by the deploy workflows). Fastest path.
# - digest:   create a fresh revision from an older digest when the old revision
#   was purged. The digest must carry a provenance attestation from ci.yml.
#
# Rolling back the application does not roll back data or configuration;
# check the release record for migrations and flag changes first.
name: rollback

on:
  workflow_dispatch:
    inputs:
      environment:
        description: Environment to roll back
        required: true
        type: choice
        options: [dev, test, production]
      revision:
        description: Revision name to restore (empty = label "previous")
        required: false
        type: string
        default: ''
      digest:
        description: Older digest to redeploy instead (sha256:...); overrides revision
        required: false
        type: string
        default: ''
      reason:
        description: Incident or ticket reference and a one-line reason
        required: true
        type: string

permissions:
  contents: read

env:
  IMAGE: ghcr.io/example-owner/orders
  APP: orders

jobs:
  check:
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    permissions:
      contents: read
      packages: read
      attestations: read
    steps:
      - name: Validate inputs and the provenance of a digest target
        env:
          GH_TOKEN: ${{ github.token }}
          DIGEST: ${{ inputs.digest }}
          REVISION: ${{ inputs.revision }}
          REASON: ${{ inputs.reason }}
        run: |
          set -euo pipefail
          if [ -z "${REASON// /}" ]; then
            echo "::error::a reason is required"
            exit 1
          fi
          if [ -n "${REVISION}" ] && [[ ! "${REVISION}" =~ ^[a-z][a-z0-9-]{0,62}[a-z0-9]$ ]]; then
            echo "::error::revision name is not valid"
            exit 1
          fi
          if [ -n "${DIGEST}" ]; then
            if [[ ! "${DIGEST}" =~ ^sha256:[0-9a-f]{64}$ ]]; then
              echo "::error::digest is not a sha256 digest"
              exit 1
            fi
            echo "${GH_TOKEN}" | docker login ghcr.io -u "${GITHUB_ACTOR}" --password-stdin
            gh attestation verify "oci://${IMAGE}@${DIGEST}" \
              --repo "${GITHUB_REPOSITORY}" \
              --signer-workflow "${GITHUB_REPOSITORY}/.github/workflows/ci.yml"
          fi

  rollback:
    needs: check
    runs-on: ubuntu-24.04
    timeout-minutes: 30
    environment:
      name: ${{ inputs.environment }}
      url: ${{ steps.target.outputs.url }}
    concurrency:
      group: deploy-orders-${{ inputs.environment }}
      cancel-in-progress: false
    permissions:
      contents: read
      id-token: write
    env:
      RG: ${{ vars.AZURE_RESOURCE_GROUP }}
      DIGEST: ${{ inputs.digest }}
      REVISION: ${{ inputs.revision }}
      HEALTH_PATH: /healthz
    steps:
      - name: Azure login (OIDC, environment-scoped subject)
        uses: azure/login@PIN_FULL_COMMIT_SHA # v3
        with:
          client-id: ${{ vars.AZURE_CLIENT_ID }}
          tenant-id: ${{ vars.AZURE_TENANT_ID }}
          subscription-id: ${{ vars.AZURE_SUBSCRIPTION_ID }}

      - name: Resolve the current and target revisions
        id: target
        run: |
          set -euo pipefail
          current="$(az containerapp revision list -n "${APP}" -g "${RG}" \
            --query 'sort_by([?properties.trafficWeight > `0`], &properties.trafficWeight)[-1].name' \
            -o tsv)"
          if [ -n "${DIGEST}" ]; then
            suffix="rb${GITHUB_RUN_NUMBER}-${DIGEST:7:10}"
            az containerapp update -n "${APP}" -g "${RG}" \
              --image "${IMAGE}@${DIGEST}" --revision-suffix "${suffix}" -o none
            target="${APP}--${suffix}"
          elif [ -n "${REVISION}" ]; then
            target="${REVISION}"
          else
            target="$(az containerapp ingress traffic show -n "${APP}" -g "${RG}" \
              --query "[?label=='previous'].revisionName | [0]" -o tsv)"
          fi
          if [ -z "${target}" ] || [ "${target}" = "${current}" ]; then
            echo "::error::no rollback target different from ${current}"
            exit 1
          fi
          image="$(az containerapp revision show -n "${APP}" -g "${RG}" --revision "${target}" \
            --query 'properties.template.containers[0].image' -o tsv)"
          case "${image}" in
            *@sha256:*) ;;
            *) echo "::error::${target} runs ${image}, not a digest; refuse to restore it"; exit 1 ;;
          esac
          fqdn="$(az containerapp show -n "${APP}" -g "${RG}" \
            --query properties.configuration.ingress.fqdn -o tsv)"
          {
            echo "current=${current}"
            echo "target=${target}"
            echo "image=${image}"
            echo "url=https://${fqdn}"
          } >> "${GITHUB_OUTPUT}"

      - name: Activate the target and wait until it is provisioned
        env:
          TARGET: ${{ steps.target.outputs.target }}
        run: |
          set -euo pipefail
          az containerapp revision activate -n "${APP}" -g "${RG}" --revision "${TARGET}" -o none
          state=""
          for _ in $(seq 1 60); do
            state="$(az containerapp revision show -n "${APP}" -g "${RG}" \
              --revision "${TARGET}" --query properties.provisioningState -o tsv)"
            case "${state}" in
              Provisioned) break ;;
              Failed) echo "::error::${TARGET} failed to provision"; exit 1 ;;
            esac
            sleep 10
          done
          [ "${state}" = "Provisioned" ] || { echo "::error::${TARGET} did not provision"; exit 1; }

      - name: Move all traffic to the target
        id: switch
        env:
          CURRENT: ${{ steps.target.outputs.current }}
          TARGET: ${{ steps.target.outputs.target }}
        run: |
          set -euo pipefail
          az containerapp ingress traffic set -n "${APP}" -g "${RG}" \
            --revision-weight "${TARGET}=100" "${CURRENT}=0" -o none
          az containerapp revision label add -n "${APP}" -g "${RG}" \
            --label stable --revision "${TARGET}" --yes -o none
          az containerapp revision label add -n "${APP}" -g "${RG}" \
            --label previous --revision "${CURRENT}" --yes -o none

      - name: Smoke check after rollback
        env:
          URL: ${{ steps.target.outputs.url }}
        run: |
          curl --fail --silent --show-error --max-time 10 \
            --retry 12 --retry-delay 5 --retry-all-errors \
            "${URL}${HEALTH_PATH}" > /dev/null

      - name: Record the rollback for the incident timeline
        if: always()
        env:
          CURRENT: ${{ steps.target.outputs.current }}
          TARGET: ${{ steps.target.outputs.target }}
          IMAGE_NOW: ${{ steps.target.outputs.image }}
          REASON: ${{ inputs.reason }}
          OUTCOME: ${{ job.status }}
        run: |
          {
            echo "### Rollback (${OUTCOME})"
            echo
            echo "- from: \`${CURRENT}\`"
            echo "- to: \`${TARGET}\` (\`${IMAGE_NOW}\`)"
            echo "- reason: ${REASON}"
            echo "- actor: ${GITHUB_ACTOR}"
          } >> "${GITHUB_STEP_SUMMARY}"

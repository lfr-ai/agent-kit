"""Opt-in local built-image gate. Copy to ``trivy_image_scan.py``; Python 3.13+."""

import argparse
from datetime import UTC, datetime
import hashlib
import json
import logging
import os
from pathlib import Path
import re
import subprocess
from tempfile import TemporaryDirectory

_LOG = logging.getLogger(__name__)
_TIMEOUT_SECONDS = 600
_ERROR_EXIT = 2
_DB = "ghcr.io/aquasecurity/trivy-db:2"
_JAVA_DB = "ghcr.io/aquasecurity/trivy-java-db:1"
_HEX = r"[0-9a-f]{64}"
_SCHEMA_VERSION = 2
_JSON_INDENT = 2


def _object(text: str) -> dict[str, object]:
    """Read a JSON object, never silently accept an absent report."""
    value: object = json.loads(text)
    if not isinstance(value, dict):
        message = "Expected a JSON object"
        raise ValueError(message)
    return value


def _invoke(
    command: list[str], *, work: Path, evidence: Path, name: str
) -> subprocess.CompletedProcess[str]:
    """Run without a shell and retain stdout/stderr, including failed scans."""
    env = {
        key: value for key, value in os.environ.items() if not key.startswith("TRIVY_")
    }
    env.update(
        HOME=str(work),
        USERPROFILE=str(work),
        XDG_CONFIG_HOME=str(work),
        XDG_DATA_HOME=str(work),
    )
    result = subprocess.run(  # noqa: S603 - reviewed binary, fixed flags, no shell
        command,
        cwd=work,
        env=env,
        capture_output=True,
        text=True,
        check=False,
        timeout=_TIMEOUT_SECONDS,
    )
    (evidence / f"{name}.json").write_text(result.stdout, encoding="utf-8")
    (evidence / f"{name}.stderr.txt").write_text(result.stderr, encoding="utf-8")
    return result


def _scan_command(base: list[str], image_id: str) -> list[str]:
    """Keep policy explicit; no caller-controlled extra flags or suppressions."""
    return [
        *base,
        "image",
        "--image-src=docker",
        "--scanners=vuln",
        "--pkg-types=os,library",
        "--detection-priority=precise",
        "--vuln-severity-source=auto",
        "--severity=HIGH,CRITICAL",
        "--ignore-unfixed",
        "--exit-code=1",
        "--exit-on-eol=2",
        "--format=json",
        "--ignorefile=",
        "--ignore-policy=",
        "--ignore-status=",
        "--vex=",
        "--db-repository=" + _DB,
        "--java-db-repository=" + _JAVA_DB,
        "--skip-db-update=false",
        "--skip-java-db-update=false",
        "--offline-scan",
        "--disable-telemetry",
        "--no-progress",
        image_id,
    ]


def _blocking(vulnerability: object) -> bool:
    """Apply the bounded policy to one well-formed vulnerability record."""
    if not isinstance(vulnerability, dict):
        message = "Invalid vulnerability"
        raise ValueError(message)
    severity = vulnerability.get("Severity")
    fixed = vulnerability.get("FixedVersion", "")
    if (
        not isinstance(severity, str)
        or severity not in {"UNKNOWN", "LOW", "MEDIUM", "HIGH", "CRITICAL"}
        or not isinstance(fixed, str)
    ):
        message = "Invalid severity or fixed version"
        raise ValueError(message)
    return severity in {"HIGH", "CRITICAL"} and bool(fixed.strip())


def _findings_exit(report: dict[str, object]) -> int:
    """Defend against a scanner returning zero alongside blocking findings."""
    results = report.get("Results", [])
    if not isinstance(results, list):
        message = "Invalid results list"
        raise ValueError(message)
    for result in results:
        vulnerabilities = (
            result.get("Vulnerabilities", []) if isinstance(result, dict) else None
        )
        if not isinstance(vulnerabilities, list):
            message = "Invalid vulnerabilities list"
            raise ValueError(message)
        for vulnerability in vulnerabilities:
            if _blocking(vulnerability):
                return 1
    return 0


def _validate_success(
    report: str, version: str, *, image_id: str, scanner_version: str
) -> int:
    """Require actual database evidence and a report bound to the requested ID."""
    info = _object(version)
    database = info.get("VulnerabilityDB")
    if (
        info.get("Version") != scanner_version
        or not isinstance(database, dict)
        or not all(
            database.get(key)
            for key in ("Version", "UpdatedAt", "NextUpdate", "DownloadedAt")
        )
    ):
        message = "Missing database evidence or changed scanner version"
        raise ValueError(message)
    scanned = _object(report)
    metadata = scanned.get("Metadata")
    if (
        scanned.get("SchemaVersion") != _SCHEMA_VERSION
        or not isinstance(metadata, dict)
        or metadata.get("ImageID") != image_id
    ):
        message = "Invalid report or image identity mismatch"
        raise ValueError(message)
    return _findings_exit(scanned)


def _scan(args: argparse.Namespace, scanner: Path, evidence: Path, work: Path) -> int:
    """Retain evidence even on a nonzero finding, scanner or database exit."""
    config = work / "empty.yaml"
    config.write_text("{}\n", encoding="utf-8")
    base = [str(scanner), "--config", str(config), "--cache-dir", str(work / "cache")]
    version_command = [*base, "version", "--format=json"]
    before = _invoke(
        version_command, work=work, evidence=evidence, name="version-before"
    )
    if before.returncode:
        return before.returncode
    if _object(before.stdout).get("Version") != args.scanner_version:
        message = "Actual scanner version differs from reviewed pin"
        raise ValueError(message)
    command = _scan_command(base, args.image_id)
    identity = {
        "started_at": datetime.now(UTC).isoformat(),
        "image_id": args.image_id,
        "scanner_sha256": args.scanner_sha256,
        "scanner_version": args.scanner_version,
        "command": command,
        "database_sources": [_DB, _JAVA_DB],
        "policy": "fixable HIGH/CRITICAL; findings=1; EOL=2; no suppressions",
    }
    (evidence / "identity.json").write_text(
        json.dumps(identity, indent=_JSON_INDENT) + "\n", encoding="utf-8"
    )
    scanned = _invoke(command, work=work, evidence=evidence, name="scan")
    after = _invoke(version_command, work=work, evidence=evidence, name="version-after")
    if scanned.returncode:
        return scanned.returncode
    if after.returncode:
        return after.returncode
    return _validate_success(
        scanned.stdout,
        after.stdout,
        image_id=args.image_id,
        scanner_version=args.scanner_version,
    )


def main(argv: list[str] | None = None) -> int:
    """Verify immutable inputs before executing the consumer-provisioned scanner."""
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--scanner", type=Path, required=True)
    parser.add_argument("--scanner-version", required=True)
    parser.add_argument("--scanner-sha256", required=True)
    parser.add_argument("--image-id", required=True)
    parser.add_argument("--evidence", type=Path, required=True)
    args = parser.parse_args(argv)
    if not (
        re.fullmatch(_HEX, args.scanner_sha256)
        and re.fullmatch("sha256:" + _HEX, args.image_id)
        and re.fullmatch(r"\d+\.\d+\.\d+", args.scanner_version)
    ):
        parser.error(
            "Replace pins with exact version, binary SHA-256 and local image ID"
        )
    try:
        scanner = args.scanner.resolve(strict=True)
        actual_hash = hashlib.sha256(scanner.read_bytes()).hexdigest()
        if actual_hash != args.scanner_sha256:
            message = "Scanner binary SHA-256 differs from reviewed pin"
            raise ValueError(message)
        evidence = args.evidence.absolute()
        evidence.mkdir()  # Refuse to overwrite, mix with, or reuse old evidence.
        with TemporaryDirectory(prefix="trivy-image-") as temporary:
            result = _scan(args, scanner, evidence, Path(temporary))
        _LOG.info("Scan exit %s; evidence: %s", result, evidence)
        return result if result >= 0 else _ERROR_EXIT
    except (OSError, ValueError, subprocess.TimeoutExpired) as error:
        _LOG.error("No clean scan: %s", error)
        return _ERROR_EXIT


if __name__ == "__main__":
    logging.basicConfig(level=logging.INFO)
    raise SystemExit(main())

# syntax=docker/dockerfile:1
# Node.js service image template. Copy to Dockerfile and replace:
#   PIN_IMAGE_DIGEST  the sha256 digest of the reviewed base image
#   dist/server.js    the compiled entry point
# Expects package.json, package-lock.json, and an "npm run build" script.
# Build: docker buildx build --sbom=true --provenance=mode=max -t documents:dev .

ARG NODE_BASE=node:22-bookworm-slim@sha256:PIN_IMAGE_DIGEST

# ---- deps: install exactly what the lockfile records ----
FROM ${NODE_BASE} AS deps
WORKDIR /app
COPY package.json package-lock.json ./
# --ignore-scripts blocks install-time code from dependencies; remove it only
# for reviewed packages that need native builds.
RUN --mount=type=cache,target=/root/.npm \
    npm ci --ignore-scripts --no-audit --no-fund

# ---- build: compile, then drop development dependencies ----
FROM deps AS build
COPY . .
RUN npm run build \
    && npm prune --omit=dev --ignore-scripts

# ---- runtime: production files only, non-root ----
FROM ${NODE_BASE} AS runtime

ARG SOURCE_URL=https://example.invalid/documents
ARG REVISION=unknown
# CI passes the repository URL as SOURCE_URL; hadolint cannot expand ARG values.
# hadolint ignore=DL3052
LABEL org.opencontainers.image.source="${SOURCE_URL}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.title="documents-service"

ENV NODE_ENV=production

WORKDIR /app
COPY --from=build --chown=root:root /app/package.json ./package.json
COPY --from=build --chown=root:root /app/node_modules ./node_modules
COPY --from=build --chown=root:root /app/dist ./dist

# The official image ships a 'node' user with UID 1000.
USER node
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=3s --start-period=15s --retries=3 \
    CMD ["node", "-e", "fetch('http://127.0.0.1:3000/healthz').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"]

STOPSIGNAL SIGTERM
# Node as PID 1 does not install default signal handlers: handle SIGTERM in
# the application or run with an init process ('docker run --init',
# 'init: true' in compose, or the orchestrator's equivalent).
ENTRYPOINT ["node", "dist/server.js"]

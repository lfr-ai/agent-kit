# Local development compose template. Copy to compose.yaml.
# Run: docker compose up --build --wait
# Production orchestration belongs to the platform; this file mirrors its
# security posture so problems surface locally.
name: orders

services:
  api:
    build:
      context: .
      dockerfile: Dockerfile
    image: orders-api:dev
    init: true
    user: "10001:10001"
    read_only: true
    tmpfs:
      - /tmp:size=64m,mode=1777
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    environment:
      DATABASE_HOST: db
      DATABASE_NAME: orders
      DATABASE_USER: orders
      DATABASE_PASSWORD_FILE: /run/secrets/db_password
      OTEL_SERVICE_NAME: orders-api
      OTEL_EXPORTER_OTLP_ENDPOINT: http://otel-collector:4317
    secrets:
      - database_credential
    ports:
      - "127.0.0.1:8000:8000"
    depends_on:
      db:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "python", "-c", "import sys, urllib.request; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/healthz', timeout=2).status == 200 else 1)"]
      interval: 15s
      timeout: 3s
      retries: 3
      start_period: 15s
    deploy:
      resources:
        limits:
          cpus: "1.0"
          memory: 512M
    stop_grace_period: 20s
    restart: unless-stopped

  db:
    image: postgres:17-bookworm@sha256:PIN_IMAGE_DIGEST
    environment:
      POSTGRES_DB: orders
      POSTGRES_USER: orders
      POSTGRES_PASSWORD_FILE: /run/secrets/db_password
    secrets:
      - database_credential
    volumes:
      - db-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U orders -d orders"]
      interval: 10s
      timeout: 3s
      retries: 5
    deploy:
      resources:
        limits:
          memory: 512M

secrets:
  database_credential: # pragma: allowlist secret
    # Local file outside version control; generate with a password manager.
    file: ./secrets/database_credential.txt # pragma: allowlist secret

volumes:
  db-data:

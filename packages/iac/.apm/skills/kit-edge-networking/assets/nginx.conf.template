# Reverse proxy template: one HTTPS application behind nginx 1.25.1 or newer.
# Render only the named placeholders so nginx runtime variables survive:
#   envsubst '${SERVER_NAME} ${UPSTREAM_ADDR} ${UPSTREAM_ADDR_2} ${TRUSTED_PROXY_CIDR}' \
#     < nginx.conf.template > nginx.conf
# Validate before any reload, then reload gracefully (no restart):
#   nginx -t -c "$PWD/nginx.conf"
#   python check_nginx_config.py nginx.conf
#   nginx -s reload
# TLS follows the Mozilla "intermediate" profile (guidelines 6.0, reviewed
# 2026-10-23). Regenerate it at https://ssl-config.mozilla.org/ for the nginx
# and OpenSSL versions you actually deploy.

worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;
    sendfile on;
    keepalive_timeout 65s;

    # Structured access log. $uri omits the query string, which can carry tokens.
    log_format edge escape=json '{"time":"$time_iso8601","request_id":"$request_id",'
        '"client":"$remote_addr","method":"$request_method","uri":"$uri",'
        '"status":$status,"bytes":$body_bytes_sent,"duration_s":$request_time,'
        '"upstream":"$upstream_addr","upstream_s":"$upstream_response_time"}';
    access_log /var/log/nginx/access.log edge;

    # Explicit request limits; override per location only where a route needs more.
    client_max_body_size 10m;
    client_body_timeout 15s;
    client_header_timeout 15s;
    send_timeout 30s;

    # Real client address. Trust X-Forwarded-For only from the load balancer in
    # front of nginx. Delete these three lines when nginx is the first hop.
    set_real_ip_from ${TRUSTED_PROXY_CIDR};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    # WebSocket upgrades get "Connection: upgrade"; everything else gets an
    # empty Connection header so upstream keepalive connections are reused.
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      '';
    }

    # Coarse per-client limits at the edge; the application keeps per-user and
    # per-tenant quotas, which the edge cannot see. 10m holds about 80,000
    # client states on 64-bit platforms.
    limit_req_zone $binary_remote_addr zone=per_client:10m rate=20r/s;
    limit_req_status 429;
    limit_conn_zone $binary_remote_addr zone=conn_per_client:10m;
    limit_conn_status 429;

    # Shared cache for public static content only (see location /assets/).
    proxy_cache_path /var/cache/nginx/edge levels=1:2 keys_zone=edge_cache:10m
                     max_size=1g inactive=60m use_temp_path=off;

    upstream app {
        # least_conn suits mixed request durations. With many nginx replicas
        # prefer "random two least_conn" (power of two choices).
        least_conn;
        # Passive health: max_fails failures within fail_timeout take a server
        # out for fail_timeout; ignored when the group has a single server.
        # Open-source nginx has no active checks or slow_start; let the
        # platform remove unready instances through readiness.
        server ${UPSTREAM_ADDR} max_fails=3 fail_timeout=10s;
        server ${UPSTREAM_ADDR_2} max_fails=3 fail_timeout=10s;
        # Reuse upstream connections (implicit default only from nginx 1.29.7).
        # Keep keepalive_timeout below the application server's keep-alive
        # timeout (uvicorn defaults to 5s), or raise both together.
        keepalive 32;
        keepalive_requests 1000;
        keepalive_timeout 4s;
    }

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    # X25519MLKEM768 needs OpenSSL 3.5 or newer; remove it on older builds.
    ssl_ecdh_curve X25519MLKEM768:X25519:prime256v1:secp384r1;
    ssl_session_timeout 1d;
    ssl_session_cache shared:TLS:10m;
    ssl_session_tickets off;
    # OCSP stapling only works when the certificate carries an OCSP URL. Many
    # public CAs now publish CRLs only; check with:
    #   openssl x509 -in fullchain.pem -noout -ocsp_uri
    # ssl_stapling on;
    # ssl_stapling_verify on;

    # Reject requests for unknown host names instead of serving the first site.
    server {
        listen 80 default_server;
        listen [::]:80 default_server;
        return 444;
    }

    server {
        listen 443 ssl default_server;
        listen [::]:443 ssl default_server;
        ssl_reject_handshake on;
    }

    server {
        listen 80;
        listen [::]:80;
        server_name ${SERVER_NAME};

        location /.well-known/acme-challenge/ {
            root /var/www/acme;
        }

        location / {
            return 301 https://${SERVER_NAME}$request_uri;
        }
    }

    server {
        listen 443 ssl;
        listen [::]:443 ssl;
        http2 on;
        server_name ${SERVER_NAME};

        ssl_certificate /etc/nginx/tls/fullchain.pem;
        ssl_certificate_key /etc/nginx/tls/privkey.pem;

        client_max_body_size 10m;

        # add_header follows the same rule as proxy_set_header: a location that
        # adds any header loses all of these. HSTS starts at 300 seconds; raise
        # it to 604800, 2592000, then 63072000 once every path serves HTTPS. Add
        # includeSubDomains only when every subdomain serves HTTPS, and treat
        # preload as irreversible.
        add_header Strict-Transport-Security "max-age=300" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "DENY" always;

        # Shared proxy headers. A location that sets any proxy_set_header
        # replaces this whole list, so repeat every line there.
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
        # Try another server only after connection errors or timeouts; nginx
        # does not pass non-idempotent requests (POST, PATCH, LOCK) to another
        # server once they were sent.
        proxy_next_upstream error timeout;
        proxy_next_upstream_tries 2;
        proxy_next_upstream_timeout 10s;

        limit_conn conn_per_client 50;

        # Load balancer probe: forwards to application readiness so a draining
        # or unready instance leaves rotation.
        location = /readyz {
            access_log off;
            proxy_pass http://app;
        }

        location / {
            limit_req zone=per_client burst=40 nodelay;
            proxy_pass http://app;
        }

        # Public, fingerprinted static assets cached at the edge. Requests
        # with credentials bypass the cache and are never stored.
        location /assets/ {
            limit_req zone=per_client burst=40 nodelay;
            proxy_pass http://app;
            proxy_cache edge_cache;
            proxy_cache_key $scheme$host$request_uri;
            proxy_cache_lock on;
            proxy_cache_lock_timeout 5s;
            proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
            proxy_cache_background_update on;
            proxy_cache_revalidate on;
            # Fallback lifetime only when the origin sends no caching headers.
            proxy_cache_valid 200 301 10m;
            proxy_no_cache $http_authorization $cookie_session;
            proxy_cache_bypass $http_authorization $cookie_session;
        }

        location /ws/ {
            proxy_pass http://app;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Request-ID $request_id;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 1h;
        }

        location /events/ {
            # edge:stream (server-sent events: deliver each event immediately)
            proxy_pass http://app;
            proxy_buffering off;
            proxy_cache off;
            gzip off;
            proxy_read_timeout 1h;
        }
    }
}

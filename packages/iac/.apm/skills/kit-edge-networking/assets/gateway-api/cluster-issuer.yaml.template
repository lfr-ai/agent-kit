# cert-manager ClusterIssuer that solves ACME HTTP-01 challenges through the
# Gateway in gateway.yaml (cert-manager 1.15 or later; checked 2026-10).
# Replace ops@example.invalid. While testing, use the Let's Encrypt staging
# directory (https://acme-staging-v02.api.letsencrypt.org/directory) because
# the production directory enforces strict rate limits.
# Validate with: kubectl apply --dry-run=server -f cluster-issuer.yaml
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: acme-production
spec:
  acme:
    server: https://acme-v02.api.letsencrypt.org/directory
    email: ops@example.invalid
    privateKeySecretRef:
      name: acme-production-account
    solvers:
      # HTTP-01 through the Gateway's port 80 listener. cert-manager creates a
      # temporary HTTPRoute with an exact path match, which takes precedence
      # over the redirect route's prefix match.
      - http01:
          gatewayHTTPRoute:
            parentRefs:
              - name: shop-edge
                namespace: edge
                kind: Gateway
                sectionName: http

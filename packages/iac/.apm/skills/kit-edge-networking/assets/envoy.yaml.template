# Envoy v3 static configuration: one HTTP listener in front of the "shop"
# service, with least-request balancing, active health checks, outlier
# detection, a retry budget, and method-aware retries.
# Field names follow the Envoy v3 API (checked against Envoy v1.40, 2026-10).
# Replace shop.example.invalid and app:8000 before use, then validate:
#   envoy --mode validate -c envoy.yaml
# TLS is terminated by the load balancer in front; add a transport_socket
# with DownstreamTlsContext to the listener if Envoy terminates TLS itself.
admin:
  # Admin interface stays on localhost: it can drain listeners and dump config.
  address:
    socket_address: {address: 127.0.0.1, port_value: 9901}

static_resources:
  listeners:
    - name: ingress_http
      address:
        socket_address: {address: 0.0.0.0, port_value: 8080}
      filter_chains:
        - filters:
            - name: envoy.filters.network.http_connection_manager
              typed_config:
                "@type": type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                stat_prefix: ingress_http
                codec_type: AUTO
                # Exactly one trusted load balancer in front appends the
                # client address to X-Forwarded-For; trust only that hop.
                use_remote_address: true
                xff_num_trusted_hops: 1
                normalize_path: true
                merge_slashes: true
                request_headers_timeout: 10s
                stream_idle_timeout: 300s
                common_http_protocol_options:
                  idle_timeout: 60s
                route_config:
                  name: shop_routes
                  virtual_hosts:
                    - name: shop
                      domains: ["shop.example.invalid"]
                      routes:
                        # Streaming route: no overall timeout and no retries.
                        - match: {prefix: "/events/"}
                          route:
                            cluster: shop
                            timeout: 0s
                            idle_timeout: 3600s
                        # Safe methods: retry 502/503/504 and connection
                        # failures on a different host, with backoff.
                        - match:
                            prefix: "/"
                            headers:
                              - name: ":method"
                                string_match:
                                  safe_regex: {regex: "GET|HEAD|OPTIONS"}
                          route:
                            cluster: shop
                            timeout: 15s
                            retry_policy:
                              retry_on: "connect-failure,refused-stream,gateway-error"
                              num_retries: 2
                              per_try_timeout: 5s
                              retry_back_off: {base_interval: 0.1s, max_interval: 1s}
                              retry_host_predicate:
                                - name: envoy.retry_host_predicates.previous_hosts
                                  typed_config:
                                    "@type": type.googleapis.com/envoy.extensions.retry.host.previous_hosts.v3.PreviousHostsPredicate
                              host_selection_retry_max_attempts: 3
                        # Other methods: retry only when the request never
                        # reached the upstream, so nothing runs twice.
                        - match: {prefix: "/"}
                          route:
                            cluster: shop
                            timeout: 15s
                            retry_policy:
                              retry_on: "connect-failure,refused-stream,reset-before-request"
                              num_retries: 1
                http_filters:
                  - name: envoy.filters.http.router
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.filters.http.router.v3.Router

  clusters:
    - name: shop
      type: STRICT_DNS
      connect_timeout: 2s
      # Power of two choices; slow start ramps new or recovered hosts.
      lb_policy: LEAST_REQUEST
      least_request_lb_config:
        choice_count: 2
        slow_start_config:
          slow_start_window: 30s
      load_assignment:
        cluster_name: shop
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address: {address: app, port_value: 8000}
      health_checks:
        - timeout: 2s
          interval: 5s
          unhealthy_threshold: 3
          healthy_threshold: 2
          http_health_check:
            path: /readyz
      outlier_detection:
        consecutive_5xx: 5
        consecutive_gateway_failure: 3
        interval: 10s
        base_ejection_time: 30s
        # Never eject more than half the pool, so a shared dependency outage
        # degrades service instead of emptying it.
        max_ejection_percent: 50
      circuit_breakers:
        thresholds:
          - priority: DEFAULT
            max_connections: 1024
            max_pending_requests: 1024
            max_requests: 1024
            # Retries may add at most 20 percent on top of active requests;
            # this budget replaces the fixed max_retries limit.
            retry_budget:
              budget_percent: {value: 20.0}
              min_retry_concurrency: 3
      typed_extension_protocol_options:
        envoy.extensions.upstreams.http.v3.HttpProtocolOptions:
          "@type": type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions
          common_http_protocol_options:
            # Below the application server's keep-alive timeout (uvicorn: 5s).
            idle_timeout: 4s
            max_requests_per_connection: 1000
          explicit_http_config:
            http_protocol_options: {}

"""Join untrusted path parts under a base directory without escaping it.

Copy into the infrastructure layer and use ``safe_join`` wherever a request,
file or message names a path. ``validate_file_name`` is stricter and suits
upload names and other single file names chosen by a caller.
"""

from pathlib import Path, PurePosixPath, PureWindowsPath
import re

MAX_FILE_NAME_LENGTH: int = 255
_FILE_NAME = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]*")
_DEVICE_NUMBERS = range(1, 10)
_WINDOWS_RESERVED = frozenset(
    {"CON", "PRN", "AUX", "NUL"}
    | {f"COM{number}" for number in _DEVICE_NUMBERS}
    | {f"LPT{number}" for number in _DEVICE_NUMBERS}
)


class UnsafePathError(ValueError):
    """Raised when an untrusted path or name is rejected."""


def _check_part(part: str) -> None:
    """Reject one untrusted relative part before it touches the file system."""
    posix = PurePosixPath(part)
    windows = PureWindowsPath(part)
    if not part or "\x00" in part:
        message = "empty path part or NUL byte"
        raise UnsafePathError(message)
    if posix.is_absolute() or windows.anchor:
        message = "absolute paths and drive letters are not accepted"
        raise UnsafePathError(message)
    if ".." in posix.parts or ".." in windows.parts:
        message = "parent directory references are not accepted"
        raise UnsafePathError(message)


def safe_join(base: Path, *parts: str) -> Path:
    """Join relative parts under an existing base and refuse any escape.

    Symbolic links are resolved, so a link that points outside the base is
    rejected as well.

    Args:
        base: Trusted, existing directory.
        *parts: Untrusted relative path parts.

    Returns:
        The resolved path inside ``base``; it may not exist yet.

    Raises:
        UnsafePathError: If a part is absolute, contains ``..`` or a NUL byte,
            or the resolved result lies outside ``base``.
        FileNotFoundError: If ``base`` does not exist.
    """
    for part in parts:
        _check_part(part)
    root = base.resolve(strict=True)
    candidate = root.joinpath(*parts).resolve()
    if not candidate.is_relative_to(root):
        message = "path resolves outside the allowed directory"
        raise UnsafePathError(message)
    return candidate


def validate_file_name(name: str) -> str:
    """Return a caller-chosen file name when it is a plain, portable name.

    Args:
        name: Untrusted single file name, for example from an upload.

    Returns:
        The unchanged name.

    Raises:
        UnsafePathError: If the name has separators, unusual characters, is
            too long, or is reserved on Windows.
    """
    if len(name) > MAX_FILE_NAME_LENGTH or not _FILE_NAME.fullmatch(name):
        message = "file name must be letters, digits, '.', '_' or '-'"
        raise UnsafePathError(message)
    if name.split(".", 1)[0].upper() in _WINDOWS_RESERVED:
        message = "file name is reserved on Windows"
        raise UnsafePathError(message)
    return name

# Opt-in SBOM and build provenance workflow for an explicit inventory requirement.
# Lockfile audits alone do not require this workflow. For libraries, this export
# describes the tested runtime dependency set, not dependencies bundled in a wheel
# or the versions installed by every consumer.
# Copy to .github/workflows/sbom.yml, then:
#   1. Replace every PIN_FULL_COMMIT_SHA with the reviewed 40-character commit
#      SHA of the named release and keep the version comment.
#   2. Replace PIN_UV_VERSION with the exact uv version the project uses. The
#      CycloneDX export is a uv preview feature; re-check its output whenever
#      uv is upgraded.
#   3. Call this workflow from the release workflow so the attested files are
#      the files that are published; never rebuild after attesting.
# Consumers verify with:
#   gh attestation verify dist/<file> --repo <owner>/<repo>
name: sbom

on:
  workflow_call:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build-and-attest:
    name: Build, SBOM and provenance
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    permissions:
      contents: read
      id-token: write
      attestations: write
      artifact-metadata: write
    steps:
      - uses: actions/checkout@PIN_FULL_COMMIT_SHA # v6
        with:
          persist-credentials: false
      - uses: astral-sh/setup-uv@PIN_FULL_COMMIT_SHA # v7
        with:
          version: "PIN_UV_VERSION"
          enable-cache: false
      - name: Fail when the lock no longer matches the manifest
        run: uv lock --check
      - name: Build the distributions
        run: uv build --out-dir dist
      - name: Export the locked runtime dependency inventory
        run: |
          mkdir -p sbom
          uv export --locked --no-default-groups --format cyclonedx1.5 \
            --preview-features sbom-export --output-file sbom/runtime.cdx.json
      - name: Attest build provenance for every distribution
        uses: actions/attest@PIN_FULL_COMMIT_SHA # v4
        with:
          subject-path: dist/*
      - name: Attest the SBOM to the same distributions
        uses: actions/attest@PIN_FULL_COMMIT_SHA # v4
        with:
          subject-path: dist/*
          sbom-path: sbom/runtime.cdx.json
      - uses: actions/upload-artifact@PIN_FULL_COMMIT_SHA # v5
        with:
          name: dist-and-sbom
          path: |
            dist/
            sbom/
          if-no-files-found: error
          retention-days: 7

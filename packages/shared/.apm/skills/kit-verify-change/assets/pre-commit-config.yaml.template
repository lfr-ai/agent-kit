# pre-commit configuration template. Copy to '.pre-commit-config.yaml'.
#
# Principles:
# - Hooks in the default stage are fast and check-only where a tool offers it,
#   so a commit never silently rewrites code you did not review. The few
#   whitespace fixers below are safe, idempotent and easy to review.
# - Python tools pinned in the project lockfile run through 'uv run --locked'
#   so pre-commit, CI and the editor use one version.
# - Slow or network-bound hooks use the 'manual' stage and run in CI or with
#   'pre-commit run --hook-stage manual --all-files'.
# - Hook repositories are frozen to full commit SHAs. Update them with
#   'pre-commit autoupdate --freeze' or Dependabot and review the diff.
# - check_pins.py (from the kit-verify-change assets) rejects mutable revs,
#   undigested images, package runners and unlocked installs.

minimum_pre_commit_version: "4.4"
default_install_hook_types: [pre-commit, commit-msg]
default_stages: [pre-commit, manual]
exclude: |
  (?x)^(
    .*\.lock|
    dist/.*|
    build/.*
  )$

repos:
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: 3e8a8703264a2f4a69428a0aa4dcb512790b2c8c  # frozen: v6.0.0
    hooks:
      - id: check-merge-conflict
      - id: check-case-conflict
      - id: check-added-large-files
        args: [--maxkb=500]
      - id: check-yaml
      - id: check-toml
      - id: check-json
      - id: detect-private-key
      - id: end-of-file-fixer
      - id: trailing-whitespace
        args: [--markdown-linebreak-ext=md]
      - id: mixed-line-ending
        args: [--fix=lf]

  - repo: https://github.com/Yelp/detect-secrets
    rev: 01886c8a910c64595c47f186ca1ffc0b77fa5458  # frozen: v1.5.0
    hooks:
      - id: detect-secrets
        # Create the baseline once with 'detect-secrets scan > .secrets.baseline'
        # and audit it with 'detect-secrets audit .secrets.baseline'.
        args: [--baseline, .secrets.baseline]

  - repo: https://github.com/streetsidesoftware/cspell-cli
    rev: f5c5d72342f35643988a9ffa0705c05bd3ff8383  # frozen: v10.3.0
    hooks:
      - id: cspell
        args: [--no-must-find-files, --no-progress, --no-summary]

  - repo: https://github.com/DavidAnson/markdownlint-cli2
    rev: 916ad0aaa108c64d294101002066f530ea170b10  # frozen: v0.23.3
    hooks:
      - id: markdownlint-cli2

  # Workflow correctness and security; drop both if the project has no workflows.
  - repo: https://github.com/rhysd/actionlint
    rev: 914e7df21a07ef503a81201c76d2b11c789d3fca  # frozen: v1.7.12
    hooks:
      - id: actionlint
        language_version: 1.27.3
        pass_filenames: false
        files: ^(\.github/(workflows/[^/]+|actionlint)\.ya?ml|\.pre-commit-config\.yaml)$
  - repo: https://github.com/zizmorcore/zizmor-pre-commit
    rev: c92afdf2c6ca336aaa8f39e2bd8d48f62dbd8e1f  # frozen: v1.31.1
    hooks:
      - id: zizmor
        pass_filenames: false
        args: [--no-progress, .]
        files: |
          (?x)(^|/)(
            \.github/(workflows/[^/]+|dependabot|zizmor)\.ya?ml|
            action\.ya?ml|\.pre-commit-(config|hooks)\.ya?ml|zizmor\.ya?ml
          )$

  - repo: local
    hooks:
      - id: lockfile-current
        name: lockfile matches pyproject
        entry: uv lock --check
        language: unsupported
        pass_filenames: false
        files: ^(pyproject\.toml|uv\.lock)$
      - id: ruff-format-check
        name: ruff format (check only)
        entry: uv run --locked ruff format --check
        language: unsupported
        types_or: [python, pyi]
      - id: ruff-check
        name: ruff lint (check only)
        entry: uv run --locked ruff check
        language: unsupported
        types_or: [python, pyi]
      - id: type-check
        name: type check
        entry: uv run --locked mypy src
        language: unsupported
        pass_filenames: false
        types: [python]
      - id: import-contracts
        name: import contracts
        entry: uv run --locked lint-imports
        language: unsupported
        pass_filenames: false
        types: [python]
      - id: unit-tests
        name: unit and property tests
        entry: uv run --locked pytest -m "unit or property" -q
        language: unsupported
        pass_filenames: false
        types: [python]
      - id: version-pins
        name: exact versions, frozen hooks and digest-pinned images
        entry: uv run --locked python scripts/check_pins.py --root .
        language: unsupported
        pass_filenames: false
        always_run: true
      - id: full-gate
        name: full gate including slow steps (manual)
        entry: uv run --locked python scripts/run_gate.py --include-slow --keep-going
        language: unsupported
        pass_filenames: false
        always_run: true
        stages: [manual]

  - repo: meta
    hooks:
      - id: check-useless-excludes
      - id: check-hooks-apply

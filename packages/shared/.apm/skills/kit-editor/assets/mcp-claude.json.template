{
  "mcpServers": {
    "context7": {"type": "http", "url": "https://mcp.context7.com/mcp/oauth"},
    "microsoft-learn": {"type": "http", "url": "https://learn.microsoft.com/api/mcp"},
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "X-MCP-Toolsets": "repos,issues,pull_requests,actions",
        "X-MCP-Readonly": "true",
        "X-MCP-Lockdown": "true"
      }
    },
    "gitnexus": {"type": "stdio", "command": "bunx", "args": ["--bun", "gitnexus@REVIEWED_VERSION", "mcp"]},
    "chrome-devtools": {"type": "stdio", "command": "bunx", "args": ["--bun", "chrome-devtools-mcp@REVIEWED_VERSION", "--isolated", "--headless", "--no-usage-statistics", "--no-performance-crux"]},
    "playwright": {"type": "stdio", "command": "bunx", "args": ["--bun", "@playwright/mcp@REVIEWED_VERSION", "--isolated", "--headless"]},
    "shadcn": {"type": "stdio", "command": "bunx", "args": ["--bun", "shadcn@REVIEWED_VERSION", "mcp"]},
    "postman": {"type": "http", "url": "https://mcp.postman.com/minimal"},
    "azure": {"type": "stdio", "command": "bunx", "args": ["--bun", "@azure/mcp@REVIEWED_VERSION", "server", "start", "--read-only"]},
    "terraform": {"type": "stdio", "command": "docker", "args": ["run", "--interactive", "--rm", "hashicorp/terraform-mcp-server@sha256:REVIEWED_SHA256", "--toolsets=registry"]},
    "azure-devops": {"type": "stdio", "command": "bunx", "args": ["--bun", "@azure-devops/mcp@REVIEWED_VERSION", "REVIEWED_ORGANIZATION", "-d", "core", "work", "work-items"]}
  }
}

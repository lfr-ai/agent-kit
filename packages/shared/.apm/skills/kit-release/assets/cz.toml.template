# Commitizen configuration template.
# Copy to .cz.toml at the repository root (or merge into pyproject.toml under
# [tool.commitizen]) and keep only one commitizen configuration file.
[tool.commitizen]
# Conventional Commits rules for 'cz commit' and 'cz check'.
name = "cz_conventional_commits"

# Where the current version lives. Options include "commitizen" (the 'version'
# key below), "pep621" or "uv" (pyproject.toml), "npm", "cargo" and "scm" (tags).
version_provider = "pep621"
version_scheme = "semver2"

# Tags look like v1.4.0. Keep this equal to the release workflow's tag filter.
tag_format = "v$version"
annotated_tag = true
gpg_sign = true

# While in 0.y.z, breaking changes bump MINOR instead of jumping to 1.0.0.
# Set to false when the public API is declared stable.
major_version_zero = true

# Other files that carry the version string, as "path:regex" pairs.
version_files = [
  "src/your_package/__init__.py:__version__",
]

# The changelog is generated incrementally and then edited by hand; only new
# sections are added on bump, older hand edits are kept.
update_changelog_on_bump = true
changelog_incremental = true
changelog_file = "CHANGELOG.md"

bump_message = "chore(release): $current_version -> $new_version"

# Reject commit subjects longer than this (0 disables the limit).
message_length_limit = 100

# Release workflow template for GitHub Actions.
# Copy to .github/workflows/release.yml, then:
#   - replace every REVIEWED_COMMIT_SHA with the full commit SHA of the reviewed
#     action release named in the trailing comment;
#   - replace the build and version commands with the project's own;
#   - create a "release" environment with required reviewers.
# The workflow runs only for pushed version tags. It builds once, attests the
# exact files it built, and publishes those same files.
name: release

on:
  push:
    tags:
      - "v[0-9]+.[0-9]+.[0-9]+"
      - "v[0-9]+.[0-9]+.[0-9]+-*"

permissions: {}

concurrency:
  group: release-${{ github.ref }}
  cancel-in-progress: false

jobs:
  build:
    name: Build and attest
    runs-on: ubuntu-latest
    timeout-minutes: 20
    permissions:
      contents: read
      id-token: write
      attestations: write
    steps:
      - name: Check out the tagged commit
        uses: actions/checkout@REVIEWED_COMMIT_SHA # v5
        with:
          persist-credentials: false
          fetch-depth: 0

      - name: Install uv
        uses: astral-sh/setup-uv@REVIEWED_COMMIT_SHA # v7
        with:
          version: "REVIEWED_UV_VERSION"
          enable-cache: false

      - name: Verify the tag matches the package version
        env:
          TAG: ${{ github.ref_name }}
        run: |
          version="$(uv version --short)"
          if [ "${TAG#v}" != "$version" ]; then
            echo "Tag $TAG does not match package version $version" >&2
            exit 1
          fi

      - name: Run the completion gate
        # Replace with the project's full completion gate.
        run: uv run --locked python -m pytest -q

      - name: Build distributions
        run: |
          rm -rf dist
          uv build --out-dir dist
          cd dist
          sha256sum -- * > SHA256SUMS

      - name: Attest build provenance
        uses: actions/attest@REVIEWED_COMMIT_SHA # v4
        with:
          subject-path: |
            dist/*.whl
            dist/*.tar.gz

      - name: Upload build output
        uses: actions/upload-artifact@REVIEWED_COMMIT_SHA # v5
        with:
          name: dist
          path: dist/
          if-no-files-found: error
          retention-days: 7

  publish:
    name: Publish GitHub release
    needs: build
    runs-on: ubuntu-latest
    timeout-minutes: 10
    environment: release
    permissions:
      contents: write
    steps:
      - name: Check out the changelog
        uses: actions/checkout@REVIEWED_COMMIT_SHA # v5
        with:
          persist-credentials: false
          sparse-checkout: CHANGELOG.md
          sparse-checkout-cone-mode: false

      - name: Download build output
        uses: actions/download-artifact@REVIEWED_COMMIT_SHA # v6
        with:
          name: dist
          path: dist/

      - name: Verify checksums of the attested files
        run: |
          cd dist
          sha256sum --check --strict SHA256SUMS

      - name: Extract release notes from the changelog
        env:
          TAG: ${{ github.ref_name }}
        run: |
          version="${TAG#v}"
          awk -v heading="## [$version]" '
            index($0, heading) == 1 { found = 1; next }
            found && /^## \[/ { exit }
            found { print }
          ' CHANGELOG.md > release-notes.md
          if [ ! -s release-notes.md ]; then
            echo "CHANGELOG.md has no section for $version" >&2
            exit 1
          fi

      - name: Create the release
        env:
          GH_TOKEN: ${{ github.token }}
          TAG: ${{ github.ref_name }}
        run: |
          flags=(--repo "$GITHUB_REPOSITORY" --title "$TAG")
          flags+=(--notes-file release-notes.md --verify-tag)
          case "$TAG" in *-*) flags+=(--prerelease) ;; esac
          gh release create "$TAG" dist/* "${flags[@]}"

# Copy to .env for local development; never commit .env.
# Every variable the application reads is listed here with a comment.
# Values are placeholders or harmless local defaults, never real credentials.
# Deployed environments receive secrets from the platform's secret store.

# --- Application ---

# Runtime environment name: local, test, staging or production. Required.
APP_ENV=local
# Log level: debug, info, warning or error. Default: info.
APP_LOG_LEVEL=info
# Public base URL used in generated links. Required.
APP_BASE_URL=http://localhost:8000

# --- Server ---

# TCP port the HTTP server binds to. Default: 8000.
APP_PORT=8000
# Seconds to wait for in-flight requests on shutdown. Default: 30.
APP_SHUTDOWN_TIMEOUT_SECONDS=30

# --- Database ---

# Connection URL; the local value matches the dev container database. Required.
# pragma: allowlist nextline secret: public local development credentials
APP_DATABASE_URL=postgresql://app:change-me@localhost:5432/app
# Maximum pooled connections. Default: 10.
APP_DATABASE_POOL_SIZE=10

# --- External services ---

# API key for the payment provider sandbox; request one from the team. Required.
APP_PAYMENT_API_KEY=
# Base URL of the payment provider; use the sandbox locally. Required.
APP_PAYMENT_BASE_URL=https://sandbox.example.com
# Seconds before an outbound request to the provider times out. Default: 10.
APP_PAYMENT_TIMEOUT_SECONDS=10

# --- Observability ---

# OpenTelemetry collector endpoint; leave empty to disable export. Optional.
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Feature flags ---

# Enables the new checkout flow. Default: false.
APP_FEATURE_NEW_CHECKOUT=false

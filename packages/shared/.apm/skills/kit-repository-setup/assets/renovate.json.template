{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": [
    "Renovate owns version updates for every ecosystem listed in enabledManagers.",
    "Do not configure Dependabot version updates for the same manifests.",
    "Replace the timezone and review every rule before enabling the app."
  ],
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests"
  ],
  "enabledManagers": ["pep621", "github-actions", "pre-commit", "dockerfile", "devcontainer"],
  "timezone": "Etc/UTC",
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "labels": ["dependencies"],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "rangeStrategy": "pin",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"]
  },
  "vulnerabilityAlerts": {
    "labels": ["dependencies", "security"],
    "minimumReleaseAge": null,
    "schedule": ["at any time"]
  },
  "pre-commit": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Batch minor and patch updates of development tools.",
      "matchDepTypes": ["dependency-groups", "tool.uv.dev-dependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "development tools"
    },
    {
      "description": "Batch minor and patch updates of runtime dependencies.",
      "matchDepTypes": ["project.dependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "runtime dependencies"
    },
    {
      "description": "Keep workflow actions together; digests stay pinned.",
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "semanticCommitType": "ci"
    },
    {
      "description": "Keep hook revisions together.",
      "matchManagers": ["pre-commit"],
      "groupName": "pre-commit hooks"
    },
    {
      "description": "Major updates always get their own pull request and dashboard approval.",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}

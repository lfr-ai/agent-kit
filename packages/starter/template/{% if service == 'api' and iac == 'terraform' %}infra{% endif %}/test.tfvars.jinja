# Caller-owned region defaults to the target resource group; image comes from CI.
resource_group_id = "REPLACE_WITH_RESOURCE_GROUP_ARM_ID"
stage             = "test"
name_prefix       = "{{ project_name[:20].rstrip('-') }}-test"
{% if registry == 'acr' %}
# Globally unique: change it if taken. Explicit cost toggle.
registry_name = "{{ (project_name | replace('-', ''))[:40] }}testacr"
registry_sku  = "Basic"
{% endif %}

{% if data == 'postgresql' or ai_service == 'text' %}
network_address_prefix = "REPLACE_WITH_NONOVERLAPPING_CIDR"

{% endif %}
{% if data == 'postgresql' %}
postgres_administrator = {
  object_id = "REPLACE_WITH_ENTRA_ADMIN_OBJECT_ID"
  name      = "REPLACE_WITH_ENTRA_ADMIN_DISPLAY_NAME"
  type      = "Group"
}
postgres_database = "app"
{% endif %}
{% if ai_service == 'text' %}
ai_deployment = {
  name     = "text"
  model    = "REPLACE_WITH_REGIONAL_MODEL"
  version  = "REPLACE_WITH_PINNED_MODEL_VERSION"
  sku      = "REPLACE_WITH_DEPLOYMENT_SKU"
  capacity = 1
}
{% endif %}
environment_variables          = {}
secret_references              = []
alerts_unmonitored             = true
alert_email_receivers          = []
alert_action_group_resource_id = ""

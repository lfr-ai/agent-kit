{% set environment_stage = environment_stage | default('local') -%}
# {{ environment_stage }} settings with the APP_ prefix, read by src/app/settings.py.
# Copy to .env (git-ignored) and uncomment what you need; never commit real values.
# The process environment overrides .env, and unset variables keep the runtime
# defaults. Containers receive these as environment variables; the image has no .env.
{% if environment_stage != 'local' %}
# Stage examples never load automatically. Select this file explicitly.
# Fill required empty fields using approved service outputs and secret stores.
# Do not use local Compose with stage examples; it targets .env.example only.
{% endif %}

# Required explicit stage: local, dev, test, staging or prod. No implicit default.
APP_ENVIRONMENT={{ environment_stage }}

# Total deadline, in seconds, for all readiness probes of one /health/ready request.
# APP_READINESS_TIMEOUT_SECONDS=5

# Per-client fixed-window limit for non-health requests, as JSON. Unset disables it.
# Store outages fail open; this is not an abuse-prevention or paid-inference quota.
# APP_RATE_LIMIT={"limit": 100, "window_seconds": 60}

# Reverse proxies in front of the app that append to X-Forwarded-For. Rate limiting
# keys anonymous clients by the address those proxies saw.
# APP_TRUSTED_PROXY_HOPS=1

# Export HTTP spans configured by the standard OTEL_* variables. Needs the
# platform-kit-runtime[telemetry] extra.
# APP_TRACING=true
{% if environment_stage == 'local' %}

# Loopback host ports published by local Compose; the app ignores these keys.
# LOCAL_APP_PORT=8080
{% if cache == 'redis' %}
# LOCAL_REDIS_PORT=6379
{% endif %}
{% endif %}
{% if telemetry == 'application-insights' %}

# Set by the Azure deployment; leave unset locally. When present, tracing is on
# and traces ONLY go to Application Insights through the explicit runtime identity.
# No Azure SDK or credential loads without the connection string.
# Do not combine with OTLP export or a managed ACA OTel agent pipeline.
# Console stdout -> Log Analytics is separate; no OTel logs or metrics are exported.
# APPLICATIONINSIGHTS_CONNECTION_STRING=
# AZURE_CLIENT_ID=
{% endif %}
{% if data == 'postgresql' %}

{% if environment_stage == 'local' %}
# Required PostgreSQL settings. Local Compose publishes its server on this host
# port and gives the app container postgres:5432. Change the port if 5432 is taken.
APP_POSTGRES_HOST=127.0.0.1
APP_POSTGRES_DATABASE=app
APP_POSTGRES_USER=app
{% else %}
# Required remote PostgreSQL settings from the selected environment's outputs.
APP_POSTGRES_HOST=
APP_POSTGRES_DATABASE=
APP_POSTGRES_USER=
{% endif %}
APP_POSTGRES_PORT=5432
{% if environment_stage != 'local' and iac != 'none' %}
# The assigned identity must already be mapped to APP_POSTGRES_USER in PostgreSQL.
# Do not set APP_POSTGRES_PASSWORD, even to an empty value.
APP_POSTGRES_REQUIRE_TLS=true
APP_POSTGRES_ENTRA_AUTHENTICATION=true
APP_POSTGRES_MANAGED_IDENTITY_CLIENT_ID=
{% else %}
# Set a local password before starting; never commit credentials.
APP_POSTGRES_PASSWORD=
# Local PostgreSQL only. Keep true for remote databases.
APP_POSTGRES_REQUIRE_TLS={{ 'false' if environment_stage == 'local' else 'true' }}
# Password authentication is the local default; no Azure SDK/login is used.
APP_POSTGRES_ENTRA_AUTHENTICATION=false
# For a deployed, assigned user-managed identity, set authentication=true,
# require_tls=true, REMOVE APP_POSTGRES_PASSWORD entirely (even an empty value
# is forbidden), and supply the explicit identity client UUID below.
# APP_POSTGRES_MANAGED_IDENTITY_CLIENT_ID=your-user-assigned-identity-client-uuid
# The identity must already be mapped to APP_POSTGRES_USER in PostgreSQL.
{% endif %}
{% endif %}
{% if cache == 'redis' %}

# Required shared rate policy. Choose limits appropriate for the application.
APP_RATE_LIMIT={"limit": 100, "window_seconds": 60}
{% if environment_stage == 'local' %}
# Local Compose overrides this URL to redis://redis:6379/0.
# Remote endpoints require rediss:// and private networking.
APP_REDIS_URL=redis://127.0.0.1:6379/0
{% else %}
# Supply the selected private endpoint with rediss:// (TLS); no localhost fallback.
APP_REDIS_URL=
{% endif %}
{% endif %}
{% if auth == 'entra-bearer' %}

# Required Entra trust configuration; obtain values from your approved registration.
APP_AUTH_TENANT_ID=
APP_AUTH_CLIENT_ID=
APP_AUTH_AUDIENCE=
# HTTPS origin required by IdentityConfig; no browser/session routes are installed.
APP_AUTH_ORIGIN=
# At least one nonempty permission set is required; all supplied entries are required.
APP_AUTH_SCOPES=[]
APP_AUTH_ROLES=[]
{% endif %}
{% if ai_service == 'text' %}

{% if environment_stage != 'local' and iac != 'none' %}
# Required deployed model selector (openai/<deployment>) and Azure v1 HTTPS base.
# Use the selected environment's Foundry outputs and assigned identity client UUID.
# Do not set APP_AI_API_KEY or APP_AI_API_VERSION, even to empty values.
APP_AI_MODEL=
APP_AI_API_BASE=
APP_AI_ENTRA_AUTHENTICATION=true
APP_AI_MANAGED_IDENTITY_CLIENT_ID=
{% else %}
# Required explicit LiteLLM provider selector and credential. No default provider.
APP_AI_MODEL=
APP_AI_API_KEY=
# Optional HTTPS provider endpoint/version (HTTP permitted only on loopback).
# APP_AI_API_BASE=https://your-provider.example
# APP_AI_API_VERSION=your-provider-version
# Keyless Azure v1: REMOVE APP_AI_API_KEY entirely, even an empty value.
# Use the deployed model name, not the legacy azure/ selector.
# APP_AI_ENTRA_AUTHENTICATION=true
# APP_AI_MANAGED_IDENTITY_CLIENT_ID=your-user-assigned-identity-client-uuid
# APP_AI_MODEL=openai/your-deployment
# APP_AI_API_BASE=https://your-resource.openai.azure.com/openai/v1/
# Omit APP_AI_API_VERSION. Scope is fixed to https://ai.azure.com/.default.
# The async managed identity credential is closed with the application lifespan.
{% endif %}
{% endif %}

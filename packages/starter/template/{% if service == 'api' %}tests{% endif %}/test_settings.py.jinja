def test_ai_managed_identity_excludes_keys(monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.setenv("APP_AI_ENTRA_AUTHENTICATION", "true")
    monkeypatch.setenv(
        "APP_AI_MANAGED_IDENTITY_CLIENT_ID", "33333333-3333-4333-8333-333333333333"
    )
    monkeypatch.setenv("APP_AI_MODEL", "openai/deployment")
    monkeypatch.setenv("APP_AI_API_BASE", "https://provider.invalid/openai/v1/")
    monkeypatch.delenv("APP_AI_API_VERSION", raising=False)
    with pytest.raises(ConfigurationError):
        load_settings()
    monkeypatch.delenv("APP_AI_API_KEY")
    config = load_settings().text_config()
    assert config.entra_authentication is True
    assert config.api_key is None

def test_database_password_authentication_remains_the_default() -> None:
    config = Settings().database_config()
    expected = "synthetic-password"
    assert config.entra_authentication is False
    assert config.password == expected


def test_database_managed_identity_uses_no_password(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    monkeypatch.setenv("APP_POSTGRES_ENTRA_AUTHENTICATION", "true")
    monkeypatch.setenv(
        "APP_POSTGRES_MANAGED_IDENTITY_CLIENT_ID",
        "33333333-3333-4333-8333-333333333333",
    )
    monkeypatch.delenv("APP_POSTGRES_PASSWORD")
    config = Settings().database_config()
    assert config.entra_authentication is True
    assert config.password is None
    assert config.require_tls is True

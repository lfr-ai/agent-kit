"""``APP_*`` settings build the runtime configuration with documented precedence."""

from pathlib import Path

import pytest
from platform_kit_runtime import RuntimeConfig
from platform_kit_runtime.middleware import RateLimitPolicy

from app.settings import ConfigurationError, Settings, load_settings


@pytest.fixture(autouse=True)
def _without_dotenv(monkeypatch: pytest.MonkeyPatch, tmp_path: Path) -> None:
    """Read ``.env`` from an empty directory, not the developer's checkout."""
    monkeypatch.chdir(tmp_path)


def test_environment_overrides_every_runtime_field(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    monkeypatch.setenv("APP_READINESS_TIMEOUT_SECONDS", "5")
    monkeypatch.setenv("APP_RATE_LIMIT", '{"limit": 100, "window_seconds": 60}')
    monkeypatch.setenv("APP_TRUSTED_PROXY_HOPS", "1")
    monkeypatch.setenv("APP_TRACING", "true")

    assert Settings().runtime_config() == RuntimeConfig(
        readiness_timeout_seconds=5.0,
        rate_limit=RateLimitPolicy(limit=100, window_seconds=60),
        trusted_proxy_hops=1,
        tracing=True,
    )


def test_environment_overrides_dotenv_and_ignores_foreign_keys(
    monkeypatch: pytest.MonkeyPatch, tmp_path: Path
) -> None:
    (tmp_path / ".env").write_text(
        "APP_TRUSTED_PROXY_HOPS=2\nAPP_TRACING=true\nPOSTGRES_PASSWORD=local\n",
        encoding="utf-8",
    )
    monkeypatch.setenv("APP_TRUSTED_PROXY_HOPS", "3")

    config = Settings().runtime_config()

    assert config.trusted_proxy_hops == 3
    assert config.tracing is True


def test_out_of_range_value_names_the_field(monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.setenv("APP_TRUSTED_PROXY_HOPS", "17")

    with pytest.raises(ValueError, match="trusted_proxy_hops"):
        Settings().runtime_config()


@pytest.mark.parametrize("stage", ["local", "dev", "test", "staging", "prod"])
def test_stage_is_explicit(stage: str, monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.setenv("APP_ENVIRONMENT", stage)
    assert load_settings().environment.value == stage


@pytest.mark.parametrize("stage", [None, "", "production", "DEV"])
def test_missing_or_unknown_stage_is_rejected(
    stage: str | None, monkeypatch: pytest.MonkeyPatch
) -> None:
    monkeypatch.delenv("APP_ENVIRONMENT")
    if stage is not None:
        monkeypatch.setenv("APP_ENVIRONMENT", stage)
    with pytest.raises(ConfigurationError, match="APP_ENVIRONMENT"):
        load_settings()

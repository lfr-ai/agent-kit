from urllib.parse import urlsplit
{%- endif %}
{%- if data == 'postgresql' or ai_service == 'text' or telemetry == 'application-insights' %}
from uuid import UUID
{%- endif %}

from platform_kit_runtime import RuntimeConfig
{% if ai_service == 'text' -%}
from platform_kit_runtime.ai import AIConfigurationError, TextGenerationConfig
{% endif -%}

"""Typed ``APP_*`` settings for the {{ project_name }} service, read at start-up.

This module is the only reader of the environment. The process environment
overrides ``.env``, which overrides the runtime's own defaults.
"""

import re
from collections.abc import Callable
from dataclasses import {% if telemetry == 'application-insights' %}dataclass, field, {% endif %}fields
from enum import StrEnum, auto, unique

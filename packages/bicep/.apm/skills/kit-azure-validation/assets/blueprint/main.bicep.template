// Resource-group-scoped entry point. Copy to infra/main.bicep.
// Validate:  az bicep build --file main.bicep && az bicep lint --file main.bicep
// Preview:   az deployment group what-if --resource-group <rg> \
//              --parameters parameters/dev.bicepparam --result-format FullResourcePayloads
targetScope = 'resourceGroup'

import { environmentName, storageSku, tagSet } from 'types.bicep'

@description('Deployment environment.')
param environment environmentName

@description('Short workload name used in resource names.')
@minLength(2)
@maxLength(10)
param workload string

@description('Three-digit instance suffix.')
@minLength(3)
@maxLength(3)
param instance string = '001'

@description('Azure region; defaults to the resource group location.')
param location string = resourceGroup().location

@description('Storage replication SKU.')
param storageSkuName storageSku = 'Standard_ZRS'

@description('Governance tags applied to every resource.')
param tags tagSet

var effectiveTags = union(tags, {
  environment: environment
  workload: workload
  managedBy: 'bicep'
})

// Storage account names: 3-24 lowercase letters and digits, globally unique.
var storageAccountName = take(toLower('st${workload}${environment}${instance}'), 24)

resource workloadIdentity 'Microsoft.ManagedIdentity/userAssignedIdentities@2024-11-30' = {
  name: 'id-${workload}-${environment}-${instance}'
  location: location
  tags: effectiveTags
}

// Module deployment names are generated by recent Bicep versions; add an
// explicit unique 'name' when targeting older tooling.
module storage 'modules/storage.bicep' = {
  params: {
    name: storageAccountName
    location: location
    skuName: storageSkuName
    tags: effectiveTags
    blobDataContributorPrincipalIds: [
      workloadIdentity.properties.principalId
    ]
  }
}

@description('Resource ID of the storage account.')
output storageAccountId string = storage.outputs.id

@description('Client ID of the workload identity for application configuration.')
output workloadIdentityClientId string = workloadIdentity.properties.clientId

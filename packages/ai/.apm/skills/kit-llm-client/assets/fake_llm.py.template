"""Deterministic 'LlmClient' fake for application tests.

Copy to 'llm/fakes.py' (or a tests helper package). The fake honors the port
contract: it records every request, returns scripted completions or raises
scripted typed errors in order, and never touches the network.
"""

from collections.abc import Sequence

from llm.port import Completion, CompletionRequest, LlmError, Usage


def completion(
    text: str,
    *,
    model: str = "fake-model",
    finish_reason: str = "stop",
    input_tokens: int = 10,
    output_tokens: int = 5,
    cost_usd: float | None = None,
) -> Completion:
    """Build a completion for scripting.

    Args:
        text: Generated text.
        model: Model reported as having served the request.
        finish_reason: Provider finish reason.
        input_tokens: Reported input tokens.
        output_tokens: Reported output tokens.
        cost_usd: Reported cost, or None to exercise price tables.

    Returns:
        The completion.
    """
    return Completion(
        text=text,
        model=model,
        finish_reason=finish_reason,
        usage=Usage(input_tokens=input_tokens, output_tokens=output_tokens),
        cost_usd=cost_usd,
    )


class ScriptedLlmClient:
    """Returns or raises scripted outcomes in order and records requests."""

    def __init__(self, outcomes: Sequence[Completion | LlmError]) -> None:
        """Store the script.

        Args:
            outcomes: Completions to return or errors to raise, in call order.
        """
        self._outcomes = list(outcomes)
        self.requests: list[CompletionRequest] = []

    async def complete(self, request: CompletionRequest) -> Completion:
        """Record the request and play the next scripted outcome.

        Args:
            request: Request under test.

        Returns:
            The next scripted completion.

        Raises:
            LlmError: The next scripted error.
            AssertionError: If the script is exhausted.
        """
        self.requests.append(request)
        if not self._outcomes:
            raise AssertionError("ScriptedLlmClient script exhausted")
        outcome = self._outcomes.pop(0)
        if isinstance(outcome, LlmError):
            raise outcome
        return outcome

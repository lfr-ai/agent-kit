"""Tests for 'llm.policies'; copy to 'tests/llm/test_llm_policies.py'.

Time, sleep and jitter are injected, so retries and deadlines are exercised
without waiting.
"""

import asyncio

import pytest

from llm.fakes import ScriptedLlmClient, completion
from llm.policies import (
    CircuitBreaker,
    Price,
    ResilientLlmClient,
    RetrySettings,
    SpendBudget,
    backoff_delay,
)
from llm.port import (
    ChatMessage,
    CompletionRequest,
    LlmBudgetExceededError,
    LlmCircuitOpenError,
    LlmInvalidRequestError,
    LlmRateLimitedError,
    LlmTimeoutError,
    LlmUnavailableError,
    Role,
)


class FakeClock:
    """Monotonic clock advanced only by the fake sleep."""

    def __init__(self) -> None:
        self.now = 0.0
        self.sleeps: list[float] = []

    def __call__(self) -> float:
        return self.now

    async def sleep(self, seconds: float) -> None:
        self.sleeps.append(seconds)
        self.now += seconds


def _request(**overrides: object) -> CompletionRequest:
    fields: dict[str, object] = {
        "operation": "summarize-invoice",
        "model": "summarizer",
        "messages": (ChatMessage(role=Role.USER, content="Summarize invoice 42."),),
        "max_output_tokens": 100,
    }
    fields.update(overrides)
    return CompletionRequest(**fields)  # type: ignore[arg-type]


def _client(
    inner: ScriptedLlmClient, clock: FakeClock, **kwargs: object
) -> ResilientLlmClient:
    return ResilientLlmClient(
        inner,
        clock=clock,
        sleep=clock.sleep,
        rng=lambda: 1.0,
        **kwargs,  # type: ignore[arg-type]
    )


def test_backoff_is_capped_exponential_with_full_jitter() -> None:
    settings = RetrySettings(base_delay_s=0.5, max_delay_s=3.0)

    assert [backoff_delay(n, settings, lambda: 1.0) for n in (1, 2, 3, 4)] == [
        0.5,
        1.0,
        2.0,
        3.0,
    ]
    assert backoff_delay(3, settings, lambda: 0.0) == 0.0


def test_transient_errors_are_retried_then_succeed() -> None:
    clock = FakeClock()
    inner = ScriptedLlmClient(
        [LlmUnavailableError("down"), LlmTimeoutError("slow"), completion("ok")]
    )

    result = asyncio.run(_client(inner, clock).complete(_request()))

    assert result.text == "ok"
    assert result.attempts == 3
    assert clock.sleeps == [0.5, 1.0]


def test_permanent_errors_are_not_retried() -> None:
    clock = FakeClock()
    inner = ScriptedLlmClient([LlmInvalidRequestError("bad")])

    with pytest.raises(LlmInvalidRequestError):
        asyncio.run(_client(inner, clock).complete(_request()))
    assert len(inner.requests) == 1
    assert clock.sleeps == []


def test_retries_stop_at_max_attempts() -> None:
    clock = FakeClock()
    inner = ScriptedLlmClient([LlmUnavailableError("down")] * 3)

    with pytest.raises(LlmUnavailableError):
        asyncio.run(
            _client(inner, clock, retry=RetrySettings(max_attempts=3)).complete(
                _request()
            )
        )
    assert len(inner.requests) == 3


def test_retry_after_is_honored_and_bounded() -> None:
    clock = FakeClock()
    inner = ScriptedLlmClient(
        [LlmRateLimitedError("slow down", retry_after_s=4.0), completion("ok")]
    )

    asyncio.run(_client(inner, clock).complete(_request()))
    assert clock.sleeps == [4.0]

    too_long = ScriptedLlmClient(
        [LlmRateLimitedError("slow down", retry_after_s=600.0)]
    )
    with pytest.raises(LlmRateLimitedError):
        asyncio.run(_client(too_long, FakeClock()).complete(_request()))


def test_attempt_timeout_shrinks_to_the_remaining_deadline() -> None:
    clock = FakeClock()
    inner = ScriptedLlmClient([LlmUnavailableError("down"), completion("ok")])
    settings = RetrySettings(total_deadline_s=10.0, base_delay_s=4.0, max_delay_s=4.0)

    asyncio.run(
        _client(inner, clock, retry=settings).complete(_request(timeout_s=30.0))
    )

    assert [request.timeout_s for request in inner.requests] == [10.0, 6.0]


def test_retry_that_would_cross_the_deadline_is_not_attempted() -> None:
    clock = FakeClock()
    inner = ScriptedLlmClient([LlmUnavailableError("down")])
    settings = RetrySettings(total_deadline_s=1.0, base_delay_s=2.0, max_delay_s=2.0)

    with pytest.raises(LlmUnavailableError):
        asyncio.run(_client(inner, clock, retry=settings).complete(_request()))
    assert clock.sleeps == []


def test_budget_rejects_oversized_requests_before_any_call() -> None:
    inner = ScriptedLlmClient([])
    budget = SpendBudget(max_tokens_per_request=50, max_total_usd=1.0, prices={})

    with pytest.raises(LlmBudgetExceededError, match="per-request"):
        asyncio.run(_client(inner, FakeClock(), budget=budget).complete(_request()))
    assert inner.requests == []


def test_budget_accounts_cost_from_the_price_table_and_stops_spending() -> None:
    price = Price(input_per_million_usd=1_000_000.0, output_per_million_usd=0.0)
    budget = SpendBudget(
        max_tokens_per_request=1000, max_total_usd=10.0, prices={"summarizer": price}
    )
    inner = ScriptedLlmClient([completion("ok", input_tokens=10, output_tokens=5)])
    client = _client(inner, FakeClock(), budget=budget)

    result = asyncio.run(client.complete(_request()))

    assert result.cost_usd == pytest.approx(10.0)
    assert budget.tokens == 15
    with pytest.raises(LlmBudgetExceededError, match="exhausted"):
        asyncio.run(client.complete(_request()))


def test_circuit_opens_after_threshold_and_probes_after_cool_down() -> None:
    clock = FakeClock()
    breaker = CircuitBreaker(failure_threshold=2, reset_after_s=30.0, clock=clock)
    inner = ScriptedLlmClient(
        [LlmUnavailableError("down"), LlmUnavailableError("down"), completion("ok")]
    )
    client = _client(inner, clock, breaker=breaker, retry=RetrySettings(max_attempts=1))

    for _ in range(2):
        with pytest.raises(LlmUnavailableError):
            asyncio.run(client.complete(_request()))
    assert breaker.is_open
    with pytest.raises(LlmCircuitOpenError):
        asyncio.run(client.complete(_request()))
    assert len(inner.requests) == 2

    clock.now += 31.0
    assert asyncio.run(client.complete(_request())).text == "ok"
    assert not breaker.is_open


def test_concurrency_limit_is_enforced() -> None:
    active = 0
    peak = 0

    class SlowClient:
        async def complete(self, request: CompletionRequest) -> object:
            nonlocal active, peak
            active += 1
            peak = max(peak, active)
            await asyncio.sleep(0)
            active -= 1
            return completion("ok")

    client = ResilientLlmClient(SlowClient(), max_concurrency=2)  # type: ignore[arg-type]

    async def scenario() -> None:
        await asyncio.gather(*(client.complete(_request()) for _ in range(6)))

    asyncio.run(scenario())
    assert peak == 2


def test_logs_contain_metadata_but_never_content(
    caplog: pytest.LogCaptureFixture,
) -> None:
    inner = ScriptedLlmClient([completion("secret answer text")])
    caplog.set_level("INFO", logger="llm.policies")

    asyncio.run(_client(inner, FakeClock()).complete(_request(prompt_version="v3")))

    record = caplog.records[-1]
    assert record.getMessage() == "llm.call"
    assert record.__dict__["prompt_version"] == "v3"
    assert record.__dict__["outcome"] == "ok"
    rendered = repr(record.__dict__)
    assert "Summarize invoice 42" not in rendered
    assert "secret answer text" not in rendered


@pytest.mark.parametrize(
    "kwargs",
    [
        {"max_attempts": 0},
        {"base_delay_s": -1.0},
        {"base_delay_s": 5.0, "max_delay_s": 1.0},
    ],
)
def test_invalid_retry_settings_are_rejected(kwargs: dict[str, float]) -> None:
    with pytest.raises(ValueError, match="must"):
        RetrySettings(**kwargs)  # type: ignore[arg-type]

"""Copy to ``agents/tools.py``: typed, allow-listed, approval-aware tool calls.

Stdlib only. Model-proposed tool calls are untrusted input: the registry
checks the allow-list, validates arguments against a declared schema, requires
approval for side effects, deduplicates writes by idempotency key, and maps
failures to stable error codes without exception text.
"""

from collections.abc import Callable, Mapping
from dataclasses import dataclass
from enum import StrEnum, unique
import logging
import re
from typing import Protocol, final

MAX_TEXT_LENGTH: int = 4000
_NAME = re.compile(r"[a-z][a-z0-9_]{0,63}")

logger = logging.getLogger(__name__)


@unique
class SideEffect(StrEnum):
    """What a tool can change outside the agent."""

    NONE = "none"
    WRITE = "write"
    EXTERNAL = "external"


@unique
class ToolErrorCode(StrEnum):
    """Stable codes returned to the model and recorded in traces."""

    UNKNOWN_TOOL = "unknown_tool"
    INVALID_ARGUMENTS = "invalid_arguments"
    APPROVAL_REQUIRED = "approval_required"
    NOT_FOUND = "not_found"
    UNAVAILABLE = "unavailable"


type ParameterType = type[str | int | float | bool]


@final
@dataclass(frozen=True, kw_only=True, slots=True)
class Parameter:
    """One typed tool argument.

    Args:
        name (str): Argument name.
        kind (ParameterType): Exact Python type; ``bool`` is not an ``int``.
        description (str): Meaning and units, shown to the model.
        required (bool): Whether the argument must be present.
        max_length (int): Maximum length for text arguments.
    """

    name: str
    kind: ParameterType
    description: str
    required: bool = True
    max_length: int = MAX_TEXT_LENGTH


@final
@dataclass(frozen=True, kw_only=True, slots=True)
class ToolSpec:
    """Narrow, documented tool contract.

    Args:
        name (str): Lowercase snake-case name.
        description (str): When to use the tool and what it returns.
        parameters (tuple[Parameter, ...]): Accepted arguments; others fail.
        side_effect (SideEffect): Impact outside the agent.
        errors (tuple[ToolErrorCode, ...]): Documented failure codes.
    """

    name: str
    description: str
    parameters: tuple[Parameter, ...]
    side_effect: SideEffect
    errors: tuple[ToolErrorCode, ...]

    def json_schema(self) -> dict[str, object]:
        """Return a JSON Schema for provider tool definitions.

        Returns:
            dict[str, object]: Object schema without additional properties.
        """
        names = {str: "string", int: "integer", float: "number", bool: "boolean"}
        return {
            "type": "object",
            "additionalProperties": False,
            "required": [item.name for item in self.parameters if item.required],
            "properties": {
                item.name: {"type": names[item.kind], "description": item.description}
                for item in self.parameters
            },
        }


@final
@dataclass(frozen=True, kw_only=True, slots=True)
class ToolResult:
    """Result returned to the model; never contains exception text.

    Args:
        ok (bool): Whether the tool succeeded.
        content (str): Bounded result text, empty on failure.
        error (ToolErrorCode | None): Stable code on failure.
    """

    ok: bool
    content: str = ""
    error: ToolErrorCode | None = None


class ToolNotFoundError(LookupError):
    """The requested entity does not exist; safe to report to the model."""


class ToolUnavailableError(RuntimeError):
    """A transient dependency failure; the caller decides whether to retry."""


class Tool(Protocol):
    """Implementation behind one ``ToolSpec``."""

    @property
    def spec(self) -> ToolSpec:
        """Return the contract of this tool."""
        ...

    def invoke(self, *, arguments: Mapping[str, object], idempotency_key: str) -> str:
        """Execute with validated arguments.

        Args:
            arguments (Mapping[str, object]): Arguments matching the spec.
            idempotency_key (str): Stable key for side-effecting calls.

        Returns:
            str: Result text.
        """
        ...


type Approver = Callable[[ToolSpec, Mapping[str, object]], bool]


def _valid_value(item: Parameter, value: object) -> bool:
    if type(value) is not item.kind:
        return False
    return not isinstance(value, str) or 0 < len(value) <= item.max_length


def _valid(spec: ToolSpec, arguments: Mapping[str, object]) -> bool:
    declared = {item.name for item in spec.parameters}
    if set(arguments) - declared:
        return False
    return all(
        _valid_value(item, arguments[item.name])
        if item.name in arguments
        else not item.required
        for item in spec.parameters
    )


@final
class ToolRegistry:
    """Allow-listed dispatcher for model-proposed tool calls."""

    def __init__(self, *, tools: tuple[Tool, ...], approver: Approver) -> None:
        """Register tools and the human or policy approval hook.

        Args:
            tools (tuple[Tool, ...]): The only tools this agent may call.
            approver (Approver): Decides side-effecting calls; deny by default.

        Raises:
            ValueError: A tool name is invalid or registered twice.
        """
        names = [tool.spec.name for tool in tools]
        if len(set(names)) != len(names) or any(
            _NAME.fullmatch(name) is None for name in names
        ):
            message = "tool names must be unique lowercase snake-case"
            raise ValueError(message)
        self._tools = {tool.spec.name: tool for tool in tools}
        self._approver = approver
        self._completed: dict[str, ToolResult] = {}

    def definitions(self) -> list[dict[str, object]]:
        """Return provider-neutral definitions for the allowed tools.

        Returns:
            list[dict[str, object]]: Name, description and schema per tool.
        """
        return [
            {
                "name": tool.spec.name,
                "description": tool.spec.description,
                "parameters": tool.spec.json_schema(),
            }
            for tool in self._tools.values()
        ]

    def call(
        self, *, name: str, arguments: Mapping[str, object], idempotency_key: str
    ) -> ToolResult:
        """Validate, authorize and execute one call.

        Args:
            name (str): Tool name proposed by the model.
            arguments (Mapping[str, object]): Arguments proposed by the model.
            idempotency_key (str): Stable key derived from the run and step.

        Returns:
            ToolResult: Success, or a stable error code the model can act on.
        """
        tool = self._tools.get(name)
        if tool is None:
            return ToolResult(ok=False, error=ToolErrorCode.UNKNOWN_TOOL)
        rejection = self._rejection(
            tool.spec, arguments=arguments, idempotency_key=idempotency_key
        )
        if rejection is not None:
            return rejection
        result = _execute(tool, arguments=arguments, idempotency_key=idempotency_key)
        if result.ok and tool.spec.side_effect is not SideEffect.NONE:
            self._completed[idempotency_key] = result
        return result

    def _rejection(
        self, spec: ToolSpec, *, arguments: Mapping[str, object], idempotency_key: str
    ) -> ToolResult | None:
        if not _valid(spec, arguments):
            return ToolResult(ok=False, error=ToolErrorCode.INVALID_ARGUMENTS)
        if spec.side_effect is SideEffect.NONE:
            return None
        if idempotency_key in self._completed:
            return self._completed[idempotency_key]
        if not self._approver(spec, arguments):
            return ToolResult(ok=False, error=ToolErrorCode.APPROVAL_REQUIRED)
        return None


def _execute(
    tool: Tool, *, arguments: Mapping[str, object], idempotency_key: str
) -> ToolResult:
    try:
        content = tool.invoke(arguments=arguments, idempotency_key=idempotency_key)
    except ToolNotFoundError:
        return ToolResult(ok=False, error=ToolErrorCode.NOT_FOUND)
    except ToolUnavailableError:
        logger.warning("tool unavailable: %s", tool.spec.name)
        return ToolResult(ok=False, error=ToolErrorCode.UNAVAILABLE)
    return ToolResult(ok=True, content=content[:MAX_TEXT_LENGTH])


def deny_all(spec: ToolSpec, arguments: Mapping[str, object]) -> bool:
    """Default approver: refuse every side-effecting call.

    Args:
        spec (ToolSpec): Tool contract under review.
        arguments (Mapping[str, object]): Validated arguments.

    Returns:
        bool: Always ``False``.
    """
    del spec, arguments
    return False


@final
class OrderStatusTool:
    """Example read-only tool backed by an in-memory table."""

    def __init__(self, *, statuses: Mapping[str, str]) -> None:
        """Create the example tool.

        Args:
            statuses (Mapping[str, str]): Order id to status.
        """
        self._statuses = dict(statuses)

    @property
    def spec(self) -> ToolSpec:
        """Return the read-only lookup contract."""
        return ToolSpec(
            name="get_order_status",
            description="Return the fulfillment status of one order by its id.",
            parameters=(
                Parameter(name="order_id", kind=str, description="Order identifier."),
            ),
            side_effect=SideEffect.NONE,
            errors=(ToolErrorCode.INVALID_ARGUMENTS, ToolErrorCode.NOT_FOUND),
        )

    def invoke(self, *, arguments: Mapping[str, object], idempotency_key: str) -> str:
        """Look up a status.

        Args:
            arguments (Mapping[str, object]): Contains ``order_id``.
            idempotency_key (str): Unused for read-only calls.

        Returns:
            str: Status text.

        Raises:
            ToolNotFoundError: The order is unknown.
        """
        del idempotency_key
        status = self._statuses.get(str(arguments["order_id"]))
        if status is None:
            raise ToolNotFoundError
        return status

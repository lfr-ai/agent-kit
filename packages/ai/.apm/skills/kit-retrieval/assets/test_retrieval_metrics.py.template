"""Tests for 'retrieval.metrics'; copy to 'tests/retrieval/test_retrieval_metrics.py'."""

import math
from pathlib import Path

import pytest

from retrieval.metrics import (
    GoldenQuery,
    citation_precision,
    evaluate,
    load_golden_set,
    ndcg_at_k,
    precision_at_k,
    recall_at_k,
    reciprocal_rank,
)


def test_recall_and_precision_at_k() -> None:
    retrieved = ["a", "x", "b", "y"]

    assert recall_at_k(retrieved, {"a", "b", "c"}, 2) == pytest.approx(1 / 3)
    assert recall_at_k(retrieved, {"a", "b", "c"}, 4) == pytest.approx(2 / 3)
    assert precision_at_k(retrieved, {"a", "b"}, 4) == pytest.approx(0.5)
    assert precision_at_k(["a"], {"a"}, 5) == pytest.approx(0.2)


def test_reciprocal_rank() -> None:
    assert reciprocal_rank(["x", "a"], {"a"}) == pytest.approx(0.5)
    assert reciprocal_rank(["x"], {"a"}) == 0.0


def test_ndcg_rewards_better_ordering() -> None:
    gains = {"a": 3.0, "b": 1.0}

    assert ndcg_at_k(["a", "b"], gains, 2) == pytest.approx(1.0)
    worse = ndcg_at_k(["b", "a"], gains, 2)
    expected = (1.0 + 3.0 / math.log2(3)) / (3.0 + 1.0 / math.log2(3))
    assert worse == pytest.approx(expected)
    assert ndcg_at_k(["a", "a", "b"], gains, 3) < 1.0


def test_undefined_metrics_raise() -> None:
    with pytest.raises(ValueError, match="undefined"):
        recall_at_k(["a"], set(), 1)
    with pytest.raises(ValueError, match="undefined"):
        ndcg_at_k(["a"], {"a": 0.0}, 1)
    with pytest.raises(ValueError, match="k must"):
        precision_at_k(["a"], {"a"}, 0)


def test_citation_precision_flags_citations_outside_the_results() -> None:
    assert citation_precision([], ["a"]) == 1.0
    assert citation_precision(["a", "z"], ["a", "b"]) == pytest.approx(0.5)


def test_evaluate_separates_answerable_and_no_answer_queries() -> None:
    golden = [
        GoldenQuery(
            query_id="q1", text="reset password", subject="u1", gains={"a": 1.0}
        ),
        GoldenQuery(
            query_id="q2", text="export invoices", subject="u1", gains={"b": 2.0}
        ),
        GoldenQuery(query_id="q3", text="unrelated topic", subject="u1"),
    ]
    report = evaluate({"q1": ["a"], "q2": ["x", "y"], "q3": []}, golden, k=2)

    assert report.answerable == 2
    assert report.recall == pytest.approx(0.5)
    assert report.mrr == pytest.approx(0.5)
    assert report.no_evidence_accuracy == 1.0
    assert report.misses == ("q2",)


def test_evaluate_requires_a_run_per_query() -> None:
    golden = [GoldenQuery(query_id="q1", text="t", subject="u1", gains={"a": 1.0})]
    with pytest.raises(ValueError, match="no run"):
        evaluate({}, golden, k=1)


def test_load_golden_set(tmp_path: Path) -> None:
    path = tmp_path / "golden.jsonl"
    path.write_text(
        '{"query_id": "q1", "text": "t", "subject": "u1", "gains": {"a": 1}}\n'
        "\n"
        '{"query_id": "q2", "text": "t", "subject": "u1"}\n',
        encoding="utf-8",
    )

    queries = load_golden_set(path)

    assert [query.query_id for query in queries] == ["q1", "q2"]
    assert queries[1].expects_no_evidence


@pytest.mark.parametrize(
    "line",
    [
        '{"query_id": "q1", "text": "t"}',
        '{"query_id": "q1", "text": "t", "subject": "u", "gains": {"a": -1}}',
        "[1]",
    ],
)
def test_load_golden_set_rejects_malformed_lines(tmp_path: Path, line: str) -> None:
    path = tmp_path / "golden.jsonl"
    path.write_text(line + "\n", encoding="utf-8")
    with pytest.raises(ValueError, match=r"golden\.jsonl:1"):
        load_golden_set(path)

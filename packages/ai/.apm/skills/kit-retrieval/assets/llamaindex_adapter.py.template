"""LlamaIndex retriever behind the framework-neutral 'Retriever' port.

Copy to 'retrieval/adapters/llamaindex.py'. Requires 'llama-index-core'. Only
this module imports LlamaIndex. Like the LangChain adapter, access control is
enforced by a per-query factory that applies metadata filters inside the
index, and every returned node is re-validated before it leaves the adapter.
"""

import logging
from collections.abc import Callable

from llama_index.core.retrievers import BaseRetriever
from llama_index.core.schema import NodeWithScore

from retrieval.contracts import (
    Query,
    RetrievalUnavailableError,
    ScoredChunk,
    chunk_from_mapping,
    is_visible_to,
)

logger = logging.getLogger(__name__)

# Builds a retriever restricted to the query's tenant, access tokens and
# metadata filters: call 'index.as_retriever' with 'similarity_top_k' and a
# 'MetadataFilters' value built from the query principal.
RetrieverFactory = Callable[[Query], BaseRetriever]


class LlamaIndexRetrieverAdapter:
    """Adapt a LlamaIndex 'BaseRetriever' to the 'Retriever' port."""

    def __init__(
        self,
        factory: RetrieverFactory,
        *,
        name: str = "llamaindex",
        unavailable: tuple[type[Exception], ...] = (ConnectionError, TimeoutError),
    ) -> None:
        """Configure the adapter.

        Args:
            factory: Builds a pre-filtered retriever for one query.
            name: Strategy name reported in hits and fusion weights.
            unavailable: Exceptions mapped to 'RetrievalUnavailableError'.
        """
        self._factory = factory
        self._name = name
        self._unavailable = unavailable

    @property
    def name(self) -> str:
        """Strategy name."""
        return self._name

    async def retrieve(self, query: Query) -> list[ScoredChunk]:
        """Run the framework retriever and convert its nodes.

        Args:
            query: Request to execute.

        Returns:
            Visible, attributable hits in framework order.

        Raises:
            RetrievalUnavailableError: If the framework raises a transport error.
        """
        try:
            nodes: list[NodeWithScore] = await self._factory(query).aretrieve(
                query.text
            )
        except self._unavailable as error:
            raise RetrievalUnavailableError(
                f"{self._name} retriever unavailable"
            ) from error
        hits: list[ScoredChunk] = []
        for item in nodes[: query.top_k]:
            try:
                chunk = chunk_from_mapping(
                    text=item.node.get_content(), metadata=item.node.metadata
                )
            except ValueError:
                logger.warning(
                    "retrieval.unattributable_node", extra={"strategy": self._name}
                )
                continue
            if not is_visible_to(chunk, query.principal):
                logger.error(
                    "retrieval.acl_violation_dropped", extra={"strategy": self._name}
                )
                continue
            score = item.score if item.score is not None else 1.0 / (len(hits) + 1)
            hits.append(
                ScoredChunk(
                    chunk=chunk, score=score, retriever=self._name, rank=len(hits) + 1
                )
            )
        return hits

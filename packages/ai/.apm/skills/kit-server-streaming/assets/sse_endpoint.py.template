"""FastAPI Server-Sent Events endpoint over the event hub.

Copy to 'streaming/sse.py'. Requires 'fastapi'. Uses 'StreamingResponse' with
an explicit frame generator so heartbeats, connection lifetime, replay and
cancellation are visible and testable on any FastAPI version. FastAPI 0.135
and later also ship 'fastapi.sse.EventSourceResponse'; the same contract
applies if you switch.

Routes:

- 'GET /streams/{stream_id}/events': SSE. Honors 'Last-Event-ID'.
  401/403 before any streaming, 404 unknown stream, 409 replay gap (client
  must restart), 204 when the stream already ended and nothing is left to
  replay (this also tells a browser 'EventSource' to stop reconnecting).
- 'DELETE /streams/{stream_id}': cancel the producer; 202.
"""

import asyncio
import contextlib
import logging
from collections.abc import AsyncGenerator, AsyncIterator, Awaitable, Callable
from dataclasses import dataclass

from fastapi import APIRouter, Header, HTTPException, Request, Response, status
from fastapi.responses import StreamingResponse

from streaming.events import (
    ReplayGapError,
    StreamEvent,
    encode_comment,
    encode_retry,
    encode_sse,
    parse_last_event_id,
)
from streaming.hub import (
    CapacityError,
    EventHub,
    SlowConsumerError,
    StreamNotFoundError,
)

logger = logging.getLogger(__name__)

_DEFAULT_HEARTBEAT_SECONDS = 15.0
_DEFAULT_MAX_CONNECTION_SECONDS = 300.0
_DEFAULT_RETRY_MILLISECONDS = 3000

# Returns True when the request's authenticated principal may read the stream.
# Authenticate with headers or cookies; never accept tokens in the query string.
Authorizer = Callable[[Request, str], Awaitable[bool]]

SSE_HEADERS = {
    "Cache-Control": "no-cache, no-transform",
    "X-Accel-Buffering": "no",
}


@dataclass(frozen=True, kw_only=True, slots=True)
class StreamSettings:
    """Connection-level bounds.

    Attributes:
        heartbeat_s: Idle interval before a comment frame keeps proxies open.
        max_connection_s: Connection lifetime; clients reconnect with
            'Last-Event-ID' afterwards, which rebalances long-lived connections.
        retry_ms: Reconnection delay hint sent to clients.
    """

    heartbeat_s: float = _DEFAULT_HEARTBEAT_SECONDS
    max_connection_s: float = _DEFAULT_MAX_CONNECTION_SECONDS
    retry_ms: int = _DEFAULT_RETRY_MILLISECONDS


async def _next_event(events: AsyncGenerator[StreamEvent]) -> StreamEvent:
    """Await the next event; wrapped in a task so a heartbeat never cancels it."""
    return await anext(events)


async def sse_frames(
    events: AsyncGenerator[StreamEvent], *, settings: StreamSettings
) -> AsyncIterator[bytes]:
    """Turn an event iterator into SSE frames with heartbeats and a lifetime.

    Waiting for the next event uses a task plus 'asyncio.wait', never
    'wait_for', because cancelling a pending 'anext' would close the
    subscription. When the client disconnects, the server cancels this
    generator; the 'finally' block cancels the pending read and closes the
    subscription, which releases hub resources.

    Args:
        events: Hub subscription.
        settings: Heartbeat, lifetime and retry hint.

    Yields:
        Encoded frames.
    """
    loop = asyncio.get_running_loop()
    deadline = loop.time() + settings.max_connection_s
    pending: asyncio.Task[StreamEvent] | None = None
    yield encode_retry(settings.retry_ms)
    try:
        while True:
            remaining = deadline - loop.time()
            if remaining <= 0:
                yield encode_comment("connection lifetime reached; reconnect")
                return
            if pending is None:
                pending = asyncio.ensure_future(_next_event(events))
            done, _ = await asyncio.wait(
                {pending}, timeout=min(settings.heartbeat_s, remaining)
            )
            if not done:
                yield encode_comment("ping")
                continue
            finished, pending = pending, None
            try:
                event = finished.result()
            except StopAsyncIteration:
                return
            except (SlowConsumerError, CapacityError, ReplayGapError) as error:
                # Close without 'end'; the client reconnects and is re-admitted.
                logger.info(
                    "stream.subscriber_closed", extra={"reason": type(error).__name__}
                )
                return
            yield encode_sse(event)
            if event.is_terminal:
                return
    finally:
        if pending is not None:
            pending.cancel()
            with contextlib.suppress(asyncio.CancelledError, StopAsyncIteration):
                await pending
        await events.aclose()


def build_router(
    hub: EventHub, *, authorize: Authorizer, settings: StreamSettings | None = None
) -> APIRouter:
    """Create the streaming routes.

    Args:
        hub: Event hub shared with producers.
        authorize: Per-request, per-stream authorization check.
        settings: Connection bounds; defaults to 'StreamSettings()'.

    Returns:
        A router to include in the application.
    """
    active = settings or StreamSettings()
    router = APIRouter()

    async def guard(request: Request, stream_id: str) -> None:
        if not hub.exists(stream_id):
            raise HTTPException(status.HTTP_404_NOT_FOUND, "unknown stream")
        if not await authorize(request, stream_id):
            raise HTTPException(status.HTTP_403_FORBIDDEN, "forbidden")

    @router.get("/streams/{stream_id}/events", response_model=None)
    async def stream_events(
        request: Request,
        stream_id: str,
        last_event_id: str | None = Header(default=None, alias="Last-Event-ID"),
    ) -> Response:
        await guard(request, stream_id)
        try:
            after = parse_last_event_id(last_event_id)
        except ValueError as error:
            raise HTTPException(
                status.HTTP_400_BAD_REQUEST, "invalid Last-Event-ID"
            ) from error
        if hub.is_closed(stream_id) and after >= hub.last_seq(stream_id):
            return Response(status_code=status.HTTP_204_NO_CONTENT)
        try:
            hub.admit(stream_id, after)
        except ReplayGapError as error:
            raise HTTPException(
                status.HTTP_409_CONFLICT, "replay unavailable; restart"
            ) from error
        except (CapacityError, StreamNotFoundError) as error:
            raise HTTPException(
                status.HTTP_503_SERVICE_UNAVAILABLE, "try again later"
            ) from error
        frames = sse_frames(hub.subscribe(stream_id, after=after), settings=active)
        return StreamingResponse(
            frames, media_type="text/event-stream", headers=SSE_HEADERS
        )

    @router.delete("/streams/{stream_id}", status_code=status.HTTP_202_ACCEPTED)
    async def cancel_stream(request: Request, stream_id: str) -> dict[str, str]:
        await guard(request, stream_id)
        await hub.cancel(stream_id)
        return {"stream_id": stream_id, "status": "cancelling"}

    return router

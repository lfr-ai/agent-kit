"""Tests for 'tasks.contracts'; copy to 'tests/tasks/test_task_contracts.py'."""

from datetime import datetime

import pytest

from tasks.contracts import (
    MAX_ENVELOPE_BYTES,
    PermanentTaskError,
    TaskEnvelope,
    new_envelope,
    parse_envelope,
)


def test_envelope_round_trips_through_json() -> None:
    envelope = new_envelope(
        task_type="invoice.render",
        version=1,
        idempotency_key="invoice.render:INV-42:v3",
        payload={"invoice_id": "INV-42"},
        correlation_id="req-1",
    )

    assert parse_envelope(envelope.to_json()) == envelope


def test_task_ids_are_unique_but_keys_are_business_derived() -> None:
    first = new_envelope(task_type="t", version=1, idempotency_key="k", payload={})
    second = new_envelope(task_type="t", version=1, idempotency_key="k", payload={})

    assert first.task_id != second.task_id
    assert first.idempotency_key == second.idempotency_key


@pytest.mark.parametrize(
    "overrides",
    [
        {"version": 0},
        {"idempotency_key": ""},
        {"created_at": datetime(2026, 1, 1)},  # noqa: DTZ001 - naive on purpose
        {"payload": {"Password": "x"}},
        {"payload": {"blob": "x" * MAX_ENVELOPE_BYTES}},
    ],
)
def test_invalid_envelopes_are_rejected(overrides: dict[str, object]) -> None:
    valid = new_envelope(task_type="t", version=1, idempotency_key="k", payload={})
    fields: dict[str, object] = {
        "task_id": valid.task_id,
        "task_type": valid.task_type,
        "version": valid.version,
        "idempotency_key": valid.idempotency_key,
        "payload": valid.payload,
        "created_at": valid.created_at,
    }
    fields.update(overrides)
    with pytest.raises(ValueError):  # noqa: PT011 - each case has its own message
        TaskEnvelope(**fields)  # type: ignore[arg-type]


@pytest.mark.parametrize(
    "raw",
    [
        b"not json",
        b"[]",
        b'{"task_id": "1"}',
        (
            b'{"task_id": "1", "task_type": "t", "version": "x", "idempotency_key": "k", '
            b'"payload": {}, "created_at": "2026-01-01T00:00:00+00:00"}'
        ),
        (
            b'{"task_id": "1", "task_type": "t", "version": 1, "idempotency_key": "k", '
            b'"payload": [], "created_at": "2026-01-01T00:00:00+00:00"}'
        ),
    ],
)
def test_malformed_bodies_become_permanent_errors(raw: bytes) -> None:
    with pytest.raises(PermanentTaskError, match="malformed envelope"):
        parse_envelope(raw)


def test_oversized_bodies_are_rejected_before_parsing() -> None:
    with pytest.raises(PermanentTaskError, match="too large"):
        parse_envelope(b"x" * (MAX_ENVELOPE_BYTES + 1))

# AWS root module version constraints and backend type.
# Copy to infra/aws/versions.tf. Commit the generated .terraform.lock.hcl and
# record checksums for every CI platform with
# 'terraform providers lock -platform=linux_amd64 -platform=darwin_arm64'.
terraform {
  # S3 native state locking (use_lockfile) is generally available from 1.11.
  required_version = ">= 1.11.0, < 2.0.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
  }

  # Partial configuration: values come from backend.hcl at
  # 'terraform init -backend-config=backend.hcl', so no account is hard-coded.
  backend "s3" {}
}

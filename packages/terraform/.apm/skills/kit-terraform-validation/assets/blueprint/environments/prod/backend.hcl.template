# Backend settings for the prod state. Copy to infra/environments/prod/backend.hcl.
# Prod state lives in its own storage account and subscription so a dev
# identity can never read or lock it.
resource_group_name  = "rg-tfstate-prod"
storage_account_name = "sttfstateprod001"
container_name       = "tfstate"
key                  = "orders/prod.terraform.tfstate"
use_azuread_auth     = true

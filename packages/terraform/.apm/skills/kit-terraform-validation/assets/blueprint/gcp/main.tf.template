# Minimal Google Cloud root composition: one private, versioned bucket.
# Copy to infra/gcp/main.tf.
locals {
  # Bucket names are global; the project ID keeps them unique.
  bucket_name = "${var.workload}-${var.environment}-${var.project_id}"
}

resource "google_storage_bucket" "this" {
  name          = local.bucket_name
  location      = var.location
  storage_class = "STANDARD"

  # Refuse to delete a bucket that still holds objects.
  force_destroy = false

  # IAM-only access: object ACLs are disabled.
  uniform_bucket_level_access = true

  # Block allUsers and allAuthenticatedUsers grants even if IAM allows them.
  public_access_prevention = "enforced"

  versioning {
    enabled = true
  }

  # Keep a bounded number of noncurrent versions so recovery stays possible
  # without unbounded storage cost.
  lifecycle_rule {
    condition {
      num_newer_versions = var.noncurrent_versions_to_keep
      with_state         = "ARCHIVED"
    }
    action {
      type = "Delete"
    }
  }

  # Customer managed encryption key when one is supplied; Google-managed
  # encryption applies otherwise.
  dynamic "encryption" {
    for_each = var.kms_key_name == null ? [] : [var.kms_key_name]
    content {
      default_kms_key_name = encryption.value
    }
  }
}

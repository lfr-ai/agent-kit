"""Declarative base and ORM rows for the order persistence adapter.

Copy to ``shop/infrastructure/persistence/models.py``. Rows are persistence
types: only the repository adapter imports them, and it maps them to domain
objects before returning. Schema changes ship as reviewed migrations.
"""

from datetime import UTC, datetime
from decimal import Decimal
from typing import override
import uuid

from sqlalchemy import CheckConstraint, DateTime, ForeignKey, MetaData, Numeric, String
from sqlalchemy.engine import Dialect
from sqlalchemy.orm import DeclarativeBase, Mapped, mapped_column, relationship
from sqlalchemy.types import TypeDecorator

_NAMING_CONVENTION = {
    "ix": "ix_%(column_0_label)s",
    "uq": "uq_%(table_name)s_%(column_0_name)s",
    "ck": "ck_%(table_name)s_%(constraint_name)s",
    "fk": "fk_%(table_name)s_%(column_0_name)s_%(referred_table_name)s",
    "pk": "pk_%(table_name)s",
}
_SKU_LENGTH = 64
_STATUS_LENGTH = 32
_CURRENCY_LENGTH = 3
_MONEY_PRECISION = 12
_MONEY_SCALE = 2


class Base(DeclarativeBase):
    """Declarative base whose metadata names every constraint deterministically."""

    metadata = MetaData(naming_convention=_NAMING_CONVENTION)


class UtcDateTime(TypeDecorator[datetime]):
    """Store aware timestamps as UTC and return them aware on every engine.

    SQLite has no time zone storage and returns naive values; this decorator
    rejects naive input and restores the UTC offset on read.
    """

    impl = DateTime(timezone=True)
    cache_ok = True

    @override
    def process_bind_param(
        self, value: datetime | None, dialect: Dialect
    ) -> datetime | None:
        """Normalize an aware timestamp to UTC before binding.

        Args:
            value: Timestamp to store, or ``None``.
            dialect: Active dialect; unused.

        Returns:
            The timestamp converted to UTC, or ``None``.

        Raises:
            ValueError: If ``value`` is naive.
        """
        del dialect
        if value is None:
            return None
        if value.tzinfo is None:
            message = "naive datetime cannot be stored; attach a time zone"
            raise ValueError(message)
        return value.astimezone(UTC)

    @override
    def process_result_value(
        self, value: datetime | None, dialect: Dialect
    ) -> datetime | None:
        """Attach UTC to naive values returned by engines without time zones.

        Args:
            value: Stored timestamp, or ``None``.
            dialect: Active dialect; unused.

        Returns:
            An aware UTC timestamp, or ``None``.
        """
        del dialect
        if value is None or value.tzinfo is not None:
            return value
        return value.replace(tzinfo=UTC)


class OrderLineRow(Base):
    """One persisted order line; owned by its order and deleted with it."""

    __tablename__ = "order_lines"
    __table_args__ = (CheckConstraint("quantity > 0", name="quantity_positive"),)

    order_id: Mapped[uuid.UUID] = mapped_column(
        ForeignKey("orders.id", ondelete="CASCADE"), primary_key=True
    )
    position: Mapped[int] = mapped_column(primary_key=True)
    sku: Mapped[str] = mapped_column(String(_SKU_LENGTH))
    quantity: Mapped[int]
    unit_price: Mapped[Decimal] = mapped_column(Numeric(_MONEY_PRECISION, _MONEY_SCALE))


class OrderRow(Base):
    """Persisted order aggregate root with an optimistic version counter."""

    __tablename__ = "orders"
    __table_args__ = (
        CheckConstraint(
            "status IN ('draft', 'confirmed', 'shipped', 'cancelled')",
            name="status_known",
        ),
    )

    id: Mapped[uuid.UUID] = mapped_column(primary_key=True)
    customer_id: Mapped[uuid.UUID] = mapped_column(index=True)
    status: Mapped[str] = mapped_column(String(_STATUS_LENGTH))
    currency: Mapped[str] = mapped_column(String(_CURRENCY_LENGTH))
    created_at: Mapped[datetime] = mapped_column(UtcDateTime(), index=True)
    shipped_at: Mapped[datetime | None] = mapped_column(UtcDateTime())
    version: Mapped[int] = mapped_column()
    lines: Mapped[list[OrderLineRow]] = relationship(
        cascade="all, delete-orphan",
        lazy="raise",
        order_by=OrderLineRow.position,
    )

    __mapper_args__ = {"version_id_col": version}

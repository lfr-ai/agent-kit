"""Pure ASGI middleware for correlation, access logs, headers, and body limits.

Copy into ``src/shop/api/middleware.py``. Pure ASGI classes, unlike
``BaseHTTPMiddleware``, keep context variables, streaming responses, and
background tasks intact. ``create_app`` in ``app.py`` installs them in a fixed
order; see the middleware reference of the ``kit-fastapi-service`` skill.
"""

import logging
import re
import time
import uuid
from http import HTTPStatus

from starlette.datastructures import Headers, MutableHeaders
from starlette.exceptions import HTTPException
from starlette.types import ASGIApp, Message, Receive, Scope, Send

from shop.api.problems import (
    REQUEST_ID_HEADER,
    bind_request_id,
    current_request_id,
    problem_response,
    reset_request_id,
)

access_logger = logging.getLogger("shop.access")

_REQUEST_ID_PATTERN = re.compile(r"[A-Za-z0-9._-]{8,64}")
_MILLISECONDS_PER_SECOND = 1000
_DEFAULT_CSP = "default-src 'none'; frame-ancestors 'none'"
_DOCS_PREFIXES = ("/docs", "/redoc")


class RequestIdMiddleware:
    """Accept a well-formed ``X-Request-ID`` or generate one, and echo it."""

    def __init__(self, app: ASGIApp) -> None:
        """Wrap an ASGI application.

        Args:
            app: Next application in the chain.
        """
        self._app = app

    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
        """Bind the identifier for the duration of one HTTP request."""
        if scope["type"] != "http":
            await self._app(scope, receive, send)
            return
        incoming = Headers(scope=scope).get(REQUEST_ID_HEADER, "")
        request_id = (
            incoming if _REQUEST_ID_PATTERN.fullmatch(incoming) else uuid.uuid4().hex
        )
        token = bind_request_id(request_id)

        async def send_with_id(message: Message) -> None:
            if message["type"] == "http.response.start":
                MutableHeaders(scope=message)[REQUEST_ID_HEADER] = request_id
            await send(message)

        try:
            await self._app(scope, receive, send_with_id)
        finally:
            reset_request_id(token)


class AccessLogMiddleware:
    """Log one structured line per request without headers, query, or body."""

    def __init__(self, app: ASGIApp) -> None:
        """Wrap an ASGI application.

        Args:
            app: Next application in the chain.
        """
        self._app = app

    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
        """Record method, path, status, duration, and request identifier."""
        if scope["type"] != "http":
            await self._app(scope, receive, send)
            return
        started = time.perf_counter()
        status_code = HTTPStatus.INTERNAL_SERVER_ERROR.value

        async def send_and_record(message: Message) -> None:
            nonlocal status_code
            if message["type"] == "http.response.start":
                status_code = int(message["status"])
            await send(message)

        try:
            await self._app(scope, receive, send_and_record)
        except Exception as error:
            _log_access(
                scope,
                status_code=status_code,
                started=started,
                failure=type(error).__name__,
            )
            raise
        _log_access(scope, status_code=status_code, started=started)


def _log_access(
    scope: Scope, *, status_code: int, started: float, failure: str | None = None
) -> None:
    """Emit one access record; the raw query string may carry secrets.

    The server logs the traceback of a failure; this record adds only the
    exception type so the request identifier joins both.
    """
    duration_ms = (time.perf_counter() - started) * _MILLISECONDS_PER_SECOND
    access_logger.log(
        logging.INFO if failure is None else logging.ERROR,
        "%s %s %d %.1fms%s",
        scope["method"],
        scope["path"],
        status_code,
        duration_ms,
        "" if failure is None else f" failed with {failure}",
        extra={
            "request_id": current_request_id(),
            "http_method": scope["method"],
            "http_path": scope["path"],
            "http_status": status_code,
            "duration_ms": round(duration_ms, 1),
        },
    )


class SecurityHeadersMiddleware:
    """Add defensive response headers unless a route already set them."""

    def __init__(
        self,
        app: ASGIApp,
        *,
        hsts_max_age_seconds: int | None,
        content_security_policy: str = _DEFAULT_CSP,
    ) -> None:
        """Wrap an ASGI application.

        Args:
            app: Next application in the chain.
            hsts_max_age_seconds: ``Strict-Transport-Security`` max age; ``None``
                omits the header, for example behind plain HTTP in development.
            content_security_policy: Policy for API responses; documentation
                pages under ``/docs`` and ``/redoc`` are left to their defaults.
        """
        self._app = app
        self._hsts = hsts_max_age_seconds
        self._csp = content_security_policy

    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
        """Set headers on the response start message."""
        if scope["type"] != "http":
            await self._app(scope, receive, send)
            return
        is_docs = str(scope["path"]).startswith(_DOCS_PREFIXES)

        async def send_with_headers(message: Message) -> None:
            if message["type"] == "http.response.start":
                headers = MutableHeaders(scope=message)
                headers.setdefault("X-Content-Type-Options", "nosniff")
                headers.setdefault("Referrer-Policy", "no-referrer")
                headers.setdefault("X-Frame-Options", "DENY")
                headers.setdefault("Cache-Control", "no-store")
                if not is_docs:
                    headers.setdefault("Content-Security-Policy", self._csp)
                if self._hsts is not None:
                    headers.setdefault(
                        "Strict-Transport-Security",
                        f"max-age={self._hsts}; includeSubDomains",
                    )
            await send(message)

        await self._app(scope, receive, send_with_headers)


class RequestBodyTooLargeError(HTTPException):
    """Raised from ``receive`` when a streamed body exceeds the limit.

    It subclasses ``HTTPException`` so FastAPI's body parsing re-raises it and
    the problem handler renders a 413 instead of a generic 400.
    """

    def __init__(self) -> None:
        """Create the 413 error with a caller-safe detail."""
        super().__init__(
            status_code=HTTPStatus.CONTENT_TOO_LARGE,
            detail="Request body exceeds the configured limit.",
        )


class BodySizeLimitMiddleware:
    """Reject request bodies above a byte limit, declared or streamed."""

    def __init__(self, app: ASGIApp, *, max_body_bytes: int) -> None:
        """Wrap an ASGI application.

        Args:
            app: Next application in the chain.
            max_body_bytes: Largest accepted request body.
        """
        self._app = app
        self._max = max_body_bytes

    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
        """Check ``Content-Length`` first, then count streamed chunks."""
        if scope["type"] != "http":
            await self._app(scope, receive, send)
            return
        declared = Headers(scope=scope).get("content-length", "")
        if declared.isdigit() and int(declared) > self._max:
            response = problem_response(
                status=HTTPStatus.CONTENT_TOO_LARGE,
                title=HTTPStatus.CONTENT_TOO_LARGE.phrase,
                detail="Request body exceeds the configured limit.",
            )
            await response(scope, receive, send)
            return
        received = 0
        started = False

        async def limited_receive() -> Message:
            nonlocal received
            message = await receive()
            if message["type"] == "http.request":
                received += len(message.get("body", b""))
                if received > self._max:
                    raise RequestBodyTooLargeError
            return message

        async def tracking_send(message: Message) -> None:
            nonlocal started
            if message["type"] == "http.response.start":
                started = True
            await send(message)

        try:
            await self._app(scope, limited_receive, tracking_send)
        except RequestBodyTooLargeError:
            if started:
                raise
            response = problem_response(
                status=HTTPStatus.CONTENT_TOO_LARGE,
                title=HTTPStatus.CONTENT_TOO_LARGE.phrase,
                detail="Request body exceeds the configured limit.",
            )
            await response(scope, receive, send)

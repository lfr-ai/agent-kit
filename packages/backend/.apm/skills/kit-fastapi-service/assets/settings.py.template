"""HTTP transport settings facet with secure defaults and unsafe-combination checks.

Copy into ``src/shop/api/settings.py``. Nest ``HttpSettings`` in the project's
settings class (see the ``kit-config`` skill) so environment variables such as
``SHOP_HTTP__CORS_ORIGINS`` load it once at start-up; the app factory receives
the validated facet and never reads the environment.
"""

import re
from typing import Literal, Self

from pydantic import BaseModel, ConfigDict, Field, model_validator

_DEFAULT_MAX_BODY_BYTES = 1_048_576
_MAX_BODY_BYTES_CEILING = 104_857_600
_DEFAULT_GZIP_MINIMUM_BYTES = 1_000
_DEFAULT_RATE_LIMIT_REQUESTS = 120
_DEFAULT_RATE_LIMIT_WINDOW_SECONDS = 60
_ORIGIN = re.compile(r"https?://[A-Za-z0-9.-]+(:[0-9]{1,5})?")
_POLICY_NAME_PATTERN = r"^[a-z0-9][a-z0-9_-]{0,63}$"


class RouteLimit(BaseModel):
    """One per-route rate limit; ``create_app`` turns it into a ``RouteRule``."""

    model_config = ConfigDict(frozen=True, extra="forbid")

    name: str = Field(pattern=_POLICY_NAME_PATTERN)
    path_prefix: str = Field(pattern=r"^/\S*$")
    methods: tuple[Literal["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE"], ...] = ()
    requests: int = Field(ge=1)
    window_seconds: int = Field(ge=1)


class HttpSettings(BaseModel):
    """Validated HTTP settings consumed by ``create_app``."""

    model_config = ConfigDict(frozen=True, extra="forbid")

    title: str = Field(default="Shop API", min_length=1)
    version: str = Field(default="1.0.0", min_length=1)
    api_prefix: str = Field(default="/api/v1", pattern=r"^/api/v[0-9]+$")
    docs_enabled: bool = False
    problem_base: str = Field(
        default="https://example.invalid/problems", pattern=r"^https?://\S+$"
    )
    cors_origins: tuple[str, ...] = ()
    cors_allow_credentials: bool = False
    trusted_hosts: tuple[str, ...] = ("localhost", "127.0.0.1")
    max_body_bytes: int = Field(
        default=_DEFAULT_MAX_BODY_BYTES, ge=1, le=_MAX_BODY_BYTES_CEILING
    )
    gzip_minimum_bytes: int = Field(default=_DEFAULT_GZIP_MINIMUM_BYTES, ge=0)
    rate_limit_requests: int = Field(default=_DEFAULT_RATE_LIMIT_REQUESTS, ge=1)
    rate_limit_window_seconds: int = Field(
        default=_DEFAULT_RATE_LIMIT_WINDOW_SECONDS, ge=1
    )
    # "open" keeps serving when the shared store fails (edge limits remain the
    # backstop); choose "closed" when abuse costs more than an outage.
    rate_limit_failure_mode: Literal["open", "closed"] = "open"
    # Draft IETF RateLimit / RateLimit-Policy headers; off until clients need them.
    rate_limit_headers: bool = False
    rate_limit_routes: tuple[RouteLimit, ...] = ()
    hsts_max_age_seconds: int | None = Field(default=None, ge=0)

    @model_validator(mode="after")
    def _reject_unsafe_combinations(self) -> Self:
        """Reject wildcard hosts and origins and colliding rate limit names.

        Returns:
            The validated settings.

        Raises:
            ValueError: An origin or host list is unsafe or malformed, or two
                route limits share a name.
        """
        if not self.trusted_hosts or "*" in self.trusted_hosts:
            msg = "trusted_hosts must list explicit host names"
            raise ValueError(msg)
        if "*" in self.cors_origins:
            msg = "cors_origins must list explicit origins, not '*'"
            raise ValueError(msg)
        malformed = [
            origin for origin in self.cors_origins if not _matches_origin(origin)
        ]
        if malformed:
            msg = f"cors_origins entries must be scheme://host[:port]: {malformed}"
            raise ValueError(msg)
        names = [route.name for route in self.rate_limit_routes]
        if "default" in names or len(names) != len(set(names)):
            msg = "rate_limit_routes names must be unique and not 'default'"
            raise ValueError(msg)
        return self


def _matches_origin(origin: str) -> bool:
    """Return whether an origin has no path, query, or trailing slash."""
    return _ORIGIN.fullmatch(origin) is not None

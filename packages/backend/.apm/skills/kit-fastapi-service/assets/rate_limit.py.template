"""Application rate limiting: policies, failure modes, middleware, and a dependency.

Copy into ``src/shop/api/rate_limit.py``. Two enforcement points share one
``RateLimitStore``:

- ``RateLimitMiddleware`` runs before authentication and routing. It keys by
  the client address the server resolved (trust forwarded headers only from
  known proxies, per the ``kit-edge-networking`` skill) or by a user that an
  outer authentication middleware placed in the scope, and picks a policy by
  path prefix and method. Health probes are exempt.
- ``SubjectRateLimit`` is a FastAPI dependency that runs after the
  authentication dependency and keys by the verified subject.

``InMemoryRateLimitStore`` counts per process, so several workers or replicas
each allow the full limit; use ``RedisRateLimitStore`` from
``redis_rate_limit.py`` whenever more than one process serves traffic. The
optional ``RateLimit`` and ``RateLimit-Policy`` headers follow the IETF draft
``draft-ietf-httpapi-ratelimit-headers-11``; the draft can still change, so
they stay behind a flag.
"""

import logging
import math
import re
import time
from collections.abc import Callable, Collection, Mapping, Sequence
from dataclasses import dataclass
from enum import StrEnum
from http import HTTPStatus
from typing import Protocol, runtime_checkable

from fastapi import Request, Response
from starlette.authentication import BaseUser
from starlette.datastructures import MutableHeaders
from starlette.exceptions import HTTPException as StarletteHTTPException
from starlette.responses import JSONResponse
from starlette.types import ASGIApp, Message, Receive, Scope, Send

from shop.api.problems import problem_response

logger = logging.getLogger(__name__)

_MAX_TRACKED_KEYS = 10_000
_HEALTH_PATHS = frozenset({"/health/live", "/health/ready"})
_STORE_FAILURE_RETRY_AFTER_SECONDS = 5
_POLICY_NAME = re.compile(r"[a-z0-9][a-z0-9_-]{0,63}")


class RateLimitStoreError(OSError):
    """The shared counter store failed, timed out, or returned a bad reply.

    Subclasses ``OSError`` so stores written against the earlier contract,
    which documented ``OSError``, keep working unchanged.
    """


class RateLimitStoreMissingError(RuntimeError):
    """A dependency ran without the lifespan that provides the store."""


class FailureMode(StrEnum):
    """What happens to a request when the store cannot decide."""

    OPEN = "open"
    CLOSED = "closed"


class RateOutcome(StrEnum):
    """Result reported to the metric hook for every counted request."""

    ALLOWED = "allowed"
    LIMITED = "limited"
    FAILED_OPEN = "failed_open"
    FAILED_CLOSED = "failed_closed"


type RateMetricHook = Callable[[str, RateOutcome], None]


def ignore_metric(policy_name: str, outcome: RateOutcome) -> None:
    """Default metric hook; replace it with a counter keyed by both labels."""
    del policy_name, outcome


@dataclass(frozen=True, kw_only=True, slots=True)
class RateDecision:
    """Outcome of counting one request.

    Attributes:
        allowed: Whether the request is within the limit.
        remaining: Requests the key may still send right now.
        retry_after_seconds: Seconds until the next request can be allowed.
        reset_seconds: Seconds until the full quota is available again, or
            ``None`` when the store cannot tell.
    """

    allowed: bool
    remaining: int
    retry_after_seconds: int
    reset_seconds: int | None = None


@runtime_checkable
class RateLimitStore(Protocol):
    """Counter backend shared by every worker that enforces one limit."""

    async def hit(self, key: str, *, limit: int, window_seconds: int) -> RateDecision:
        """Count one request for a key and decide whether it is allowed.

        Args:
            key: Policy-qualified caller identity.
            limit: Requests allowed per window (the burst size).
            window_seconds: Window length.

        Returns:
            The decision for this request.

        Raises:
            OSError: The store is unreachable or timed out;
                ``RateLimitStoreError`` is the preferred subclass.
        """
        ...


@dataclass(frozen=True, kw_only=True, slots=True)
class RatePolicy:
    """Named quota of ``limit`` requests per ``window_seconds`` and key.

    Attributes:
        name: Lowercase identifier used in keys, logs, metrics, and headers.
        limit: Requests allowed per window.
        window_seconds: Window length in whole seconds.
    """

    name: str
    limit: int
    window_seconds: int

    def __post_init__(self) -> None:
        """Reject names that are unsafe in keys or header strings and empty quotas.

        Raises:
            ValueError: The name, limit, or window is invalid.
        """
        if _POLICY_NAME.fullmatch(self.name) is None:
            msg = f"policy name must match {_POLICY_NAME.pattern}: {self.name!r}"
            raise ValueError(msg)
        if self.limit < 1 or self.window_seconds < 1:
            msg = "policy limit and window_seconds must be positive"
            raise ValueError(msg)


@dataclass(frozen=True, kw_only=True, slots=True)
class RouteRule:
    """Select a policy for requests under a path prefix.

    Attributes:
        path_prefix: Path or path prefix, matched on segment boundaries.
        policy: Policy applied to matching requests.
        methods: Upper-case methods to match; empty matches every method.
    """

    path_prefix: str
    policy: RatePolicy
    methods: frozenset[str] = frozenset()

    def matches(self, *, method: str, path: str) -> bool:
        """Return whether the rule applies to a request.

        Args:
            method: Request method.
            path: Request path without query string.

        Returns:
            ``True`` when the method and path both match.
        """
        if self.methods and method not in self.methods:
            return False
        prefix = self.path_prefix.rstrip("/")
        return path == prefix or path.startswith(prefix + "/")


class InMemoryRateLimitStore:
    """Fixed-window counters for a single process and event loop."""

    def __init__(self, *, clock: Callable[[], float] = time.monotonic) -> None:
        """Create an empty store.

        Args:
            clock: Monotonic seconds source; tests pass a fake.
        """
        self._clock = clock
        self._windows: dict[str, tuple[int, int]] = {}

    async def hit(self, key: str, *, limit: int, window_seconds: int) -> RateDecision:
        """Count one request; no ``await`` inside keeps the update atomic."""
        now = self._clock()
        window = int(now // window_seconds)
        if len(self._windows) >= _MAX_TRACKED_KEYS:
            self._windows = {
                stored: value
                for stored, value in self._windows.items()
                if value[0] == window
            }
        stored_window, count = self._windows.get(key, (window, 0))
        count = count + 1 if stored_window == window else 1
        self._windows[key] = (window, count)
        reset_in = max(1, math.ceil((window + 1) * window_seconds - now))
        return RateDecision(
            allowed=count <= limit,
            remaining=max(0, limit - count),
            retry_after_seconds=reset_in,
            reset_seconds=reset_in,
        )


def client_address_key(scope: Scope) -> str:
    """Return the client address the server resolved, or a shared bucket.

    Args:
        scope: ASGI connection scope.

    Returns:
        A key such as ``ip:203.0.113.7``.
    """
    client = scope.get("client")
    return f"ip:{client[0]}" if client else "ip:unknown"


def authenticated_user_key(scope: Scope) -> str:
    """Key by an authenticated user, falling back to the client address.

    Use only when an authentication middleware outside the limiter verified
    the caller and its user class implements ``identity``; never key by an
    unverified token claim, which a caller can rotate to escape the limit.

    Args:
        scope: ASGI connection scope.

    Returns:
        A key such as ``sub:user-42`` or ``ip:203.0.113.7``.
    """
    user = scope.get("user")
    if isinstance(user, BaseUser) and user.is_authenticated:
        return f"sub:{user.identity}"
    return client_address_key(scope)


def draft_ratelimit_headers(
    policy: RatePolicy, decision: RateDecision
) -> dict[str, str]:
    """Format the draft ``RateLimit-Policy`` and ``RateLimit`` fields.

    Syntax follows ``draft-ietf-httpapi-ratelimit-headers-11`` (structured
    field lists): ``"name";q=<quota>;w=<window>`` and ``"name";r=<remaining>``
    plus ``;t=<seconds>`` when the store knows the reset time. No partition
    key is sent, so caller identifiers never leave the service.

    Args:
        policy: Policy that counted the request.
        decision: Store decision for the request.

    Returns:
        Header names mapped to field values.
    """
    service_limit = f'"{policy.name}";r={max(0, decision.remaining)}'
    if decision.reset_seconds is not None:
        service_limit += f";t={max(0, decision.reset_seconds)}"
    return {
        "RateLimit-Policy": f'"{policy.name}";q={policy.limit};w={policy.window_seconds}',
        "RateLimit": service_limit,
    }


@dataclass(frozen=True, kw_only=True, slots=True)
class RateVerdict:
    """What the enforcement point must do with one request.

    Attributes:
        outcome: Counted result, also reported to the metric hook.
        headers: Response headers to add, such as ``Retry-After``.
    """

    outcome: RateOutcome
    headers: Mapping[str, str]

    @property
    def rejected(self) -> bool:
        """Return whether the request must not reach the handler."""
        return self.outcome in {RateOutcome.LIMITED, RateOutcome.FAILED_CLOSED}

    @property
    def status(self) -> HTTPStatus:
        """Return 429 for an exceeded quota and 503 for a closed failure."""
        if self.outcome is RateOutcome.FAILED_CLOSED:
            return HTTPStatus.SERVICE_UNAVAILABLE
        return HTTPStatus.TOO_MANY_REQUESTS


class RateLimitEnforcer:
    """Shared decision logic: count, apply the failure mode, log, and measure."""

    def __init__(
        self,
        *,
        failure_mode: FailureMode,
        emit_draft_headers: bool = False,
        metric_hook: RateMetricHook = ignore_metric,
    ) -> None:
        """Configure the enforcer.

        Args:
            failure_mode: ``OPEN`` admits requests while the store is down;
                ``CLOSED`` rejects them with 503. There is no default: choose.
            emit_draft_headers: Add the draft ``RateLimit`` headers.
            metric_hook: Called once per counted request with the policy
                name and outcome.
        """
        self._failure_mode = failure_mode
        self._emit_draft_headers = emit_draft_headers
        self._metric_hook = metric_hook

    async def evaluate(
        self, store: RateLimitStore, *, key: str, policy: RatePolicy
    ) -> RateVerdict:
        """Count one request against a policy.

        Args:
            store: Counter backend.
            key: Caller key without the policy name.
            policy: Policy that applies to the request.

        Returns:
            The verdict and the headers to send.
        """
        try:
            decision = await store.hit(
                f"{policy.name}:{key}",
                limit=policy.limit,
                window_seconds=policy.window_seconds,
            )
        except OSError as error:
            return self._store_failed(policy, error)
        outcome = RateOutcome.ALLOWED if decision.allowed else RateOutcome.LIMITED
        self._metric_hook(policy.name, outcome)
        headers: dict[str, str] = {}
        if not decision.allowed:
            headers["Retry-After"] = str(max(1, decision.retry_after_seconds))
        if self._emit_draft_headers:
            headers |= draft_ratelimit_headers(policy, decision)
        return RateVerdict(outcome=outcome, headers=headers)

    def _store_failed(self, policy: RatePolicy, error: OSError) -> RateVerdict:
        """Apply the failure mode; log the error type, never the caller key."""
        failed_open = self._failure_mode is FailureMode.OPEN
        outcome = RateOutcome.FAILED_OPEN if failed_open else RateOutcome.FAILED_CLOSED
        logger.warning(
            "rate limit store failed for policy %s (%s); failing %s",
            policy.name,
            type(error).__name__,
            self._failure_mode,
        )
        self._metric_hook(policy.name, outcome)
        headers = (
            {}
            if failed_open
            else {"Retry-After": str(_STORE_FAILURE_RETRY_AFTER_SECONDS)}
        )
        return RateVerdict(outcome=outcome, headers=headers)


def rejection_response(verdict: RateVerdict) -> JSONResponse:
    """Build the problem response for a rejected verdict.

    Args:
        verdict: A verdict whose ``rejected`` property is true.

    Returns:
        429 problem details for an exceeded quota (RFC 6585) or 503 when the
        store failed closed, both with ``Retry-After`` (RFC 9110).
    """
    limited = verdict.outcome is RateOutcome.LIMITED
    return problem_response(
        status=verdict.status,
        title=verdict.status.phrase,
        detail=(
            "Request rate limit exceeded."
            if limited
            else "Request admission is temporarily unavailable."
        ),
        extensions={"code": "rate_limited" if limited else "rate_limit_unavailable"},
        headers=verdict.headers,
    )


class RateLimitMiddleware:
    """Count requests before routing; reject with problem details when over a policy."""

    def __init__(  # noqa: PLR0913 - keyword-only configuration of one component
        self,
        app: ASGIApp,
        *,
        store: RateLimitStore,
        default_policy: RatePolicy,
        failure_mode: FailureMode,
        rules: Sequence[RouteRule] = (),
        key_func: Callable[[Scope], str] = client_address_key,
        exempt_paths: Collection[str] = _HEALTH_PATHS,
        emit_draft_headers: bool = False,
        metric_hook: RateMetricHook = ignore_metric,
    ) -> None:
        """Wrap an ASGI application.

        Args:
            app: Next application in the chain.
            store: Counter backend shared by all workers.
            default_policy: Policy for requests no rule matches.
            failure_mode: Behavior while the store is failing.
            rules: Route policies; the longest matching prefix wins.
            key_func: Derives the caller key from the scope.
            exempt_paths: Exact paths never counted, such as health probes.
            emit_draft_headers: Add the draft ``RateLimit`` headers.
            metric_hook: Receives the policy name and outcome per request.
        """
        self._app = app
        self._store = store
        self._default_policy = default_policy
        self._rules = tuple(
            sorted(rules, key=lambda rule: len(rule.path_prefix), reverse=True)
        )
        self._key_func = key_func
        self._exempt = frozenset(exempt_paths)
        self._enforcer = RateLimitEnforcer(
            failure_mode=failure_mode,
            emit_draft_headers=emit_draft_headers,
            metric_hook=metric_hook,
        )

    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
        """Count the request, then reject it or forward it with limit headers."""
        if scope["type"] != "http" or scope["path"] in self._exempt:
            await self._app(scope, receive, send)
            return
        policy = self._policy_for(method=scope["method"], path=scope["path"])
        verdict = await self._enforcer.evaluate(
            self._store, key=self._key_func(scope), policy=policy
        )
        if verdict.rejected:
            await rejection_response(verdict)(scope, receive, send)
            return
        if not verdict.headers:
            await self._app(scope, receive, send)
            return

        async def send_with_headers(message: Message) -> None:
            if message["type"] == "http.response.start":
                MutableHeaders(scope=message).update(verdict.headers)
            await send(message)

        await self._app(scope, receive, send_with_headers)

    def _policy_for(self, *, method: str, path: str) -> RatePolicy:
        """Return the policy of the longest matching rule or the default."""
        for rule in self._rules:
            if rule.matches(method=method, path=path):
                return rule.policy
        return self._default_policy


class RateLimitRejectedError(StarletteHTTPException):
    """HTTP rejection raised by ``SubjectRateLimit``; the problem handler renders it."""

    def __init__(self, *, status: HTTPStatus, headers: Mapping[str, str]) -> None:
        """Create the rejection.

        Args:
            status: 429 or 503.
            headers: ``Retry-After`` and optional draft headers to keep.
        """
        super().__init__(
            status_code=int(status),
            detail="Request rate limit exceeded."
            if status is HTTPStatus.TOO_MANY_REQUESTS
            else "Request admission is temporarily unavailable.",
            headers=dict(headers),
        )


def rate_limit_store_from(request: Request) -> RateLimitStore:
    """Return the store the lifespan placed in the request state.

    Args:
        request: Current request.

    Returns:
        The process-wide store.

    Raises:
        RateLimitStoreMissingError: The lifespan did not provide a store.
    """
    store = getattr(request.state, "rate_limit_store", None)
    if not isinstance(store, RateLimitStore):
        msg = "no rate_limit_store in lifespan state; enable lifespan"
        raise RateLimitStoreMissingError(msg)
    return store


class SubjectRateLimit:
    """Per-subject quota for a route group, enforced after authentication.

    Declare one instance per policy at module level (it holds no I/O) and
    call it from a dependency that already resolved the principal::

        order_writes = SubjectRateLimit(
            policy=RatePolicy(name="order-writes", limit=30, window_seconds=60),
            failure_mode=FailureMode.OPEN,
        )


        async def limit_order_writes(
            request: Request, response: Response, principal: PrincipalDep
        ) -> None:
            await order_writes.enforce(request, response, subject=principal.subject)


        @router.post("/orders", dependencies=[Depends(limit_order_writes)])
        async def create_order(...): ...
    """

    def __init__(
        self,
        *,
        policy: RatePolicy,
        failure_mode: FailureMode,
        emit_draft_headers: bool = False,
        metric_hook: RateMetricHook = ignore_metric,
    ) -> None:
        """Configure the limit.

        Args:
            policy: Quota applied per verified subject.
            failure_mode: Behavior while the store is failing.
            emit_draft_headers: Add the draft ``RateLimit`` headers.
            metric_hook: Receives the policy name and outcome per request.
        """
        self._policy = policy
        self._enforcer = RateLimitEnforcer(
            failure_mode=failure_mode,
            emit_draft_headers=emit_draft_headers,
            metric_hook=metric_hook,
        )

    async def enforce(
        self, request: Request, response: Response, *, subject: str
    ) -> None:
        """Count one request for a verified subject.

        Args:
            request: Current request; its state holds the store.
            response: Response whose headers receive the draft fields.
            subject: Verified, stable subject identifier.

        Raises:
            RateLimitRejectedError: The quota is exhausted or the store
                failed closed.
        """
        verdict = await self._enforcer.evaluate(
            rate_limit_store_from(request), key=f"sub:{subject}", policy=self._policy
        )
        if verdict.rejected:
            raise RateLimitRejectedError(status=verdict.status, headers=verdict.headers)
        response.headers.update(verdict.headers)

"""ASGI entry point and HTTP composition root.

Copy into ``src/shop/main.py`` and serve with
``uvicorn shop.main:build_app --factory --proxy-headers --forwarded-allow-ips <proxy>``.
The factory keeps import free of side effects. Replace the in-memory adapter
with production adapters and load settings through the project's settings
class; this is the only module that chooses concrete implementations.
"""

import logging
from collections.abc import AsyncIterator
from contextlib import asynccontextmanager
from types import MappingProxyType

from fastapi import FastAPI

from shop.api.app import create_app
from shop.api.dependencies import Container
from shop.api.rate_limit import InMemoryRateLimitStore
from shop.api.settings import HttpSettings
from shop.application.ports import Item
from shop.core.exceptions import NotFoundError

logger = logging.getLogger(__name__)


class InMemoryItemCatalog:
    """Catalog adapter for local runs; replace with a database adapter."""

    def __init__(self, items: tuple[Item, ...]) -> None:
        """Index the given items.

        Args:
            items: Items served by this adapter.
        """
        self._items = MappingProxyType({item.item_id: item for item in items})

    async def get(self, item_id: str, /) -> Item:
        """Return one item or raise ``NotFoundError``."""
        try:
            return self._items[item_id]
        except KeyError as error:
            msg = f"item {item_id!r} does not exist"
            raise NotFoundError(msg) from error


@asynccontextmanager
async def open_container() -> AsyncIterator[Container]:
    """Open adapters on startup and close them in reverse order on shutdown."""
    catalog = InMemoryItemCatalog(())
    logger.info("container opened")
    try:
        yield Container(catalog=catalog)
    finally:
        logger.info("container closed")


def build_app() -> FastAPI:
    """Configure logging once, then build the application from settings.

    Returns:
        The ASGI application served by the process.
    """
    logging.basicConfig(level=logging.INFO)
    return create_app(
        settings=HttpSettings(),
        container_factory=open_container,
        rate_limit_store=InMemoryRateLimitStore(),
    )

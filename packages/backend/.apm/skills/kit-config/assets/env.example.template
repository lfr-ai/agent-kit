# Example configuration for local development.
# Copy to .env (git-ignored) and replace placeholders. Never commit real values.
# Production receives these values from the platform or a secret store.

ORDERS_LOG_FORMAT=text
ORDERS_LOG_LEVEL=DEBUG

# Database facet (nested delimiter is a double underscore)
ORDERS_DATABASE__URL=postgresql://localhost:5432/orders_dev
ORDERS_DATABASE__PASSWORD=change-me # pragma: allowlist secret
ORDERS_DATABASE__POOL_SIZE=5
ORDERS_DATABASE__STATEMENT_TIMEOUT_SECONDS=30

# Billing client facet
ORDERS_BILLING__BASE_URL=http://localhost:8081
ORDERS_BILLING__API_KEY=change-me # pragma: allowlist secret
ORDERS_BILLING__TIMEOUT_SECONDS=10

# TLS facet (disabled locally)
ORDERS_TLS__ENABLED=false

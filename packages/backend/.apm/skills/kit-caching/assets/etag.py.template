"""Conditional GET helpers: strong ETags, 304 handling, and safe Cache-Control.

Copy into ``src/shop/api/etag.py``. Use ``conditional_response`` in GET
handlers that return cacheable representations:

    @router.get("/products/{product_id}")
    async def read_product(product_id: int, request: Request, catalog: Catalog) -> Response:
        product = await catalog.product(product_id)
        body = ProductOut.model_validate(product).model_dump_json().encode()
        return conditional_response(
            request,
            body=body,
            media_type="application/json",
            cache_control=shared_policy(max_age_seconds=60, shared_max_age_seconds=300),
            public=True,
            etag=version_etag(product.id, product.version, "json"),
        )

Rules implemented (RFC 9110 and RFC 9111): ``If-None-Match`` uses weak
comparison and takes precedence over ``If-Modified-Since``; only GET and HEAD
can yield 304; a 304 carries the same ``ETag``, ``Cache-Control``, ``Vary``, and
``Last-Modified`` as the 200 and no body; shared-cache directives on a request
that carries ``Authorization`` or ``Cookie`` are refused unless the caller
asserts the representation is identical for every user.
"""

from collections.abc import Iterable
from datetime import UTC, datetime
from email.utils import format_datetime, parsedate_to_datetime
import hashlib
from http import HTTPStatus
import re

from starlette.requests import Request
from starlette.responses import Response

NO_STORE = "no-store"
PRIVATE_REVALIDATE = "private, no-cache"
_ONE_YEAR_SECONDS = 31_536_000
IMMUTABLE_ASSET = f"public, max-age={_ONE_YEAR_SECONDS}, immutable"
_ETAG_HEX_CHARS = 32
_SAFE_METHODS = frozenset({"GET", "HEAD"})
_SHARED_DIRECTIVES = frozenset({"public", "s-maxage", "must-revalidate"})
_PRIVATE_DIRECTIVES = frozenset({"private", "no-store"})
_CREDENTIAL_HEADERS = ("authorization", "cookie")
_ENTITY_TAG = re.compile(r'(?:W/)?"[^"]*"')
_WEAK_PREFIX = "W/"
_DEFAULT_VARY = ("Accept-Encoding",)


def shared_policy(
    *,
    max_age_seconds: int,
    shared_max_age_seconds: int | None = None,
    stale_while_revalidate_seconds: int | None = None,
    stale_if_error_seconds: int | None = None,
) -> str:
    """Build a ``public`` Cache-Control value for data identical for all users.

    Args:
        max_age_seconds: Freshness for every cache, including browsers.
        shared_max_age_seconds: Freshness override for shared caches.
        stale_while_revalidate_seconds: RFC 5861 background revalidation window.
        stale_if_error_seconds: RFC 5861 window for serving stale on origin errors.

    Returns:
        A directive list such as ``public, max-age=60, s-maxage=300``.

    Raises:
        ValueError: A duration is negative.
    """
    durations = {
        "max-age": max_age_seconds,
        "s-maxage": shared_max_age_seconds,
        "stale-while-revalidate": stale_while_revalidate_seconds,
        "stale-if-error": stale_if_error_seconds,
    }
    if any(value is not None and value < 0 for value in durations.values()):
        msg = "cache durations must not be negative"
        raise ValueError(msg)
    directives = [
        f"{name}={value}" for name, value in durations.items() if value is not None
    ]
    return ", ".join(["public", *directives])


def strong_etag(body: bytes) -> str:
    """Return a strong entity tag derived from the exact response bytes."""
    return f'"{hashlib.sha256(body).hexdigest()[:_ETAG_HEX_CHARS]}"'


def version_etag(*inputs: str | int) -> str:
    """Return a strong entity tag from every input that changes the bytes.

    Include the entity version and the representation variant (format,
    language, API version) so the tag changes whenever the body would.
    """
    joined = "\x1f".join(str(item) for item in inputs).encode()
    return strong_etag(joined)


def etag_matches(if_none_match: str, etag: str) -> bool:
    """Apply the weak comparison used by ``If-None-Match``."""
    if if_none_match.strip() == "*":
        return True
    target = _opaque(etag)
    return any(_opaque(tag) == target for tag in _ENTITY_TAG.findall(if_none_match))


def not_modified_since(
    if_modified_since: str, last_modified: datetime, *, now: datetime | None = None
) -> bool:
    """Return whether the resource is unchanged since a valid client date.

    Invalid dates and dates later than ``now`` are ignored (treated as changed).
    """
    try:
        since = parsedate_to_datetime(if_modified_since)
    except (TypeError, ValueError):
        return False
    if since.tzinfo is None:
        since = since.replace(tzinfo=UTC)
    if since > (now or datetime.now(UTC)):
        return False
    return last_modified.astimezone(UTC).replace(microsecond=0) <= since


def conditional_response(
    request: Request,
    *,
    body: bytes,
    media_type: str,
    cache_control: str,
    etag: str | None = None,
    last_modified: datetime | None = None,
    vary: Iterable[str] = _DEFAULT_VARY,
    public: bool = False,
) -> Response:
    """Return 200 with validators, or 304 when the client copy is current.

    Args:
        request: Incoming request; only GET and HEAD can produce 304.
        body: Rendered representation for a 200.
        media_type: Content type of ``body``.
        cache_control: Policy such as ``NO_STORE``, ``PRIVATE_REVALIDATE``, or
            ``shared_policy(...)``.
        etag: Precomputed strong tag; defaults to a hash of ``body``.
        last_modified: Timezone-aware modification time, if known.
        vary: Request headers that select the representation.
        public: Assert that the representation is identical for every user.

    Returns:
        A 200 response with the body, or a 304 response without it.

    Raises:
        ValueError: A shared-cache policy was requested for a credentialed
            request without ``public=True``.
    """
    _reject_shared_policy_for_credentials(request, cache_control, public=public)
    tag = etag or strong_etag(body)
    headers = {"ETag": tag, "Cache-Control": cache_control}
    vary_value = ", ".join(vary)
    if vary_value:
        headers["Vary"] = vary_value
    if last_modified is not None:
        headers["Last-Modified"] = format_datetime(
            last_modified.astimezone(UTC), usegmt=True
        )
    if request.method in _SAFE_METHODS and _client_copy_is_current(
        request, tag, last_modified
    ):
        return Response(status_code=HTTPStatus.NOT_MODIFIED, headers=headers)
    return Response(content=body, media_type=media_type, headers=headers)


def _client_copy_is_current(
    request: Request, tag: str, last_modified: datetime | None
) -> bool:
    if_none_match = request.headers.get("if-none-match")
    if if_none_match is not None:
        return etag_matches(if_none_match, tag)
    if_modified_since = request.headers.get("if-modified-since")
    if if_modified_since is None or last_modified is None:
        return False
    return not_modified_since(if_modified_since, last_modified)


def _reject_shared_policy_for_credentials(
    request: Request, cache_control: str, *, public: bool
) -> None:
    if public:
        return
    directives = {
        part.split("=", 1)[0].strip().lower() for part in cache_control.split(",")
    }
    credentialed = any(name in request.headers for name in _CREDENTIAL_HEADERS)
    shareable = directives & _SHARED_DIRECTIVES and not directives & _PRIVATE_DIRECTIVES
    if credentialed and shareable:
        msg = (
            "shared-cache directives on a credentialed request; use private/no-store "
            "or pass public=True when the body is identical for every user"
        )
        raise ValueError(msg)


def _opaque(tag: str) -> str:
    stripped = tag.strip()
    return stripped.removeprefix(_WEAK_PREFIX)

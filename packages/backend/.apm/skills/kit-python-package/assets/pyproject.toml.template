# Starting point for a distributable Python package with a console entry point.
# Replace order-tools / order_tools, then run check_pyproject.py and a real build.

[build-system]
requires = ["hatchling>=1.27"]
build-backend = "hatchling.build"

[project]
name = "order-tools"
version = "0.1.0"
description = "Command-line tools for exporting and validating orders."
readme = "README.md"
requires-python = ">=3.12"
license = "MIT"
license-files = ["LICENSE"]
authors = [{ name = "Example Maintainers", email = "maintainers@example.com" }]
keywords = ["orders", "export", "cli"]
classifiers = [
    "Development Status :: 3 - Alpha",
    "Environment :: Console",
    "Operating System :: OS Independent",
    "Programming Language :: Python :: 3",
    "Programming Language :: Python :: 3 :: Only",
    "Programming Language :: Python :: 3.12",
    "Programming Language :: Python :: 3.13",
    "Typing :: Typed",
]
dependencies = [
    "httpx>=0.27",
    "pydantic>=2.7",
]

[project.optional-dependencies]
postgres = ["psycopg[binary]>=3.2"]

[project.urls]
Homepage = "https://example.com/order-tools"
Source = "https://example.com/order-tools/source"
Issues = "https://example.com/order-tools/issues"
Changelog = "https://example.com/order-tools/changelog"

[project.scripts]
order-tools = "order_tools.cli:main"

[project.entry-points."order_tools.exporters"]
csv = "order_tools.exporters.csv:CsvExporter"

[dependency-groups]
test = ["pytest>=8", "pytest-cov>=5"]
lint = ["ruff>=0.6"]
freeze = ["pyinstaller>=6.10"]
dev = [
    { include-group = "test" },
    { include-group = "lint" },
]

[tool.hatch.build.targets.wheel]
packages = ["src/order_tools"]

[tool.hatch.build.targets.sdist]
include = [
    "src/order_tools",
    "tests",
    "README.md",
    "LICENSE",
]
exclude = [
    "**/__pycache__",
    "**/*.pyc",
    ".env*",
]

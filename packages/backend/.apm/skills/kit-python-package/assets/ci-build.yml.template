# GitHub Actions workflow: build and verify wheels, sdist, and frozen executables.
# Copy to .github/workflows/build.yml. Publishing and signing are separate,
# operator-approved jobs that consume these artifacts.
name: build

on:
  pull_request:
  push:
    branches: [main]
    tags: ["v*"]

permissions:
  contents: read

concurrency:
  group: build-${{ github.ref }}
  cancel-in-progress: true

jobs:
  distributions:
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: astral-sh/setup-uv@1c37ad07a6a961277cf70c0d37d6f313000f5884 # v10.3.0
        with:
          version: "0.13.3"
          python-version: "3.13"
          enable-cache: false
      - name: Check pyproject metadata
        run: uv run --no-project python tools/check_pyproject.py pyproject.toml
      - name: Build sdist and wheel
        run: uv build --out-dir dist/
      - name: Inspect artifact contents
        run: |
          uv run --no-project python -m zipfile -l dist/*.whl
          tar -tzf dist/*.tar.gz
      - name: Install wheel outside the checkout and smoke test
        run: |
          smoke="$RUNNER_TEMP/smoke-env"
          uv venv "$smoke"
          # Resolve runtime dependencies from the reviewed lock, not the index.
          uv export --locked --no-default-groups --no-emit-project --format requirements.txt --output-file "$RUNNER_TEMP/constraints.txt"
          uv pip install --python "$smoke" --constraint "$RUNNER_TEMP/constraints.txt" dist/*.whl
          cd "$RUNNER_TEMP"
          "$smoke/bin/order-tools" --version
          "$smoke/bin/python" -c "import order_tools.resources as r; r.read_text('templates', 'invoice.html')"
      - name: Record checksums
        run: sha256sum dist/* > SHA256SUMS && mv SHA256SUMS dist/
      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: distributions
          path: dist/
          if-no-files-found: error

  frozen:
    strategy:
      fail-fast: false
      matrix:
        # Build on the oldest supported OS image for each platform.
        os: [windows-2025, macos-15, ubuntu-22.04]
    runs-on: ${{ matrix.os }}
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: astral-sh/setup-uv@1c37ad07a6a961277cf70c0d37d6f313000f5884 # v10.3.0
        with:
          version: "0.13.3"
          python-version: "3.13"
          enable-cache: false
      - name: Install locked dependencies
        run: uv sync --locked --group freeze
      - name: Build one-folder bundle
        run: uv run --locked pyinstaller app.spec --clean --noconfirm
      - name: Smoke test frozen executable
        shell: bash
        run: |
          ./dist/order-tools/order-tools --version
          ./dist/order-tools/order-tools export --dry-run --format csv
      - name: Archive bundle
        shell: bash
        env:
          RUNNER_OS_NAME: ${{ runner.os }}
        run: |
          cd dist
          uv run --no-project python -c "import os, shutil; shutil.make_archive('order-tools-' + os.environ['RUNNER_OS_NAME'], 'zip', 'order-tools')"
      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: frozen-${{ runner.os }}
          path: dist/order-tools-*.zip
          if-no-files-found: error

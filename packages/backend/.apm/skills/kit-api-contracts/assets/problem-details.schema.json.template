{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.example.com/schemas/problem-details.json",
  "title": "Problem details",
  "description": "RFC 9457 problem details object with an optional field-error extension. Unknown extension members are allowed and must be ignored by clients that do not understand them.",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "format": "uri-reference",
      "default": "about:blank",
      "description": "Identifies the problem type; clients branch on this value."
    },
    "title": {
      "type": "string",
      "description": "Short summary of the problem type; stable across occurrences."
    },
    "status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599,
      "description": "HTTP status code generated by the origin server for this occurrence."
    },
    "detail": {
      "type": "string",
      "description": "Occurrence-specific explanation without internal details."
    },
    "instance": {
      "type": "string",
      "format": "uri-reference",
      "description": "Identifies this occurrence, for example a trace reference."
    },
    "errors": {
      "type": "array",
      "description": "Extension: field-level problems.",
      "items": {
        "type": "object",
        "required": ["pointer", "message"],
        "properties": {
          "pointer": {
            "type": "string",
            "description": "RFC 6901 JSON Pointer to the offending request member."
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}

[run]
source = agent_kit
branch = true
parallel = true
# Measure repository helper subprocesses started by integration tests.
patch = subprocess
relative_files = true

[report]
show_missing = true
skip_empty = true
fail_under = 90
# Static typing branches, CLI launchers and abstract placeholders are not
# application behavior; concrete implementations and CLI entry points are tested.
exclude_also =
    if TYPE_CHECKING:
    if __name__ == .__main__.:
    raise NotImplementedError
    \.\.\.
